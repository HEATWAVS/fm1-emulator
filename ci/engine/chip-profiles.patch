diff --git a/crates/fm1-soc/tests/chip_oracle.rs b/crates/fm1-soc/tests/chip_oracle.rs
new file mode 100644
index 0000000..a10f4e9
--- /dev/null
+++ b/crates/fm1-soc/tests/chip_oracle.rs
@@ -0,0 +1,581 @@
+//! Replays oracle transcripts (generated from the Stage A reference model, ci/machine/chipmodel.mjs) against
+//! the Rust chip state machine, two ways:
+//!   * `chip_driver`: `Chip` directly (select / transfer / release), including CS rising mid-byte;
+//!   * `soc_driver`: through the SoC's registers (GPIO PD0 chip select, SPI0 BUF/CON) with the SoC's
+//!     cycle counter as the clock: the path the firmware's CPU takes.
+//! The transcript file is named by FM1_CHIP_ORACLE (see gen-transcripts.mjs for the line formats).
+//! Scenarios marked `fault=1` (gen-transcripts.mjs --with-fault; interrupted operations, Component 5) are replayed by BOTH drivers: the chip driver (Stage 5C-1) and, since
+//! Stage 5C-2, the register driver, where the cut is the SoC's own scheduled event (`Soc::sync_flash_cut`, the XIP window, the terminal `power_cut` flag).
+
+use fm1_core::Bus;
+use fm1_soc::spichip::{FaultAt, FaultError, FaultOp, FaultSpec, FaultState};
+use fm1_soc::{Chip, ChipKind, Soc, Timing, FLASH_SIZE};
+
+const SPI0: u32 = 0x11c00;
+const CS: u32 = 0x500c0;
+
+fn unhex(s: &str) -> Vec<u8> {
+    if s == "-" {
+        return Vec::new();
+    }
+    (0..s.len() / 2).map(|i| u8::from_str_radix(&s[2 * i..2 * i + 2], 16).unwrap()).collect()
+}
+
+fn fnv(a: &[u8]) -> u32 {
+    let mut h: u32 = 0x811c9dc5;
+    for &b in a {
+        h ^= b as u32;
+        h = h.wrapping_mul(0x01000193);
+    }
+    h
+}
+
+fn pattern() -> Vec<u8> {
+    (0..FLASH_SIZE).map(|i| (((i * 131 + (i >> 8) * 17) ^ 0x5a) & 0xff) as u8).collect()
+}
+
+trait Drv {
+    fn set_cycles(&mut self, cycles: u64);
+    /// Run one transaction: returns the bytes read and, for status reads, the model's unknown mask byte.
+    fn tx(&mut self, tx: &[u8], read: usize, partial: u8) -> (Vec<u8>, Option<u8>);
+    fn power(&mut self);
+    fn mem(&self) -> &[u8];
+    fn wip(&mut self) -> bool;
+    fn take_log(&mut self) -> Vec<&'static str>;
+    /// the interrupted-operation line kinds; None for a driver that cannot replay them
+    fn fault(&mut self) -> Option<&mut dyn FaultDrv> {
+        None
+    }
+    /// hash of the array as the oracle knows it (bytes the chip lists as indeterminate read as 0, like the model's peekKnown)
+    fn known_hash(&mut self) -> u32 {
+        fnv(self.mem())
+    }
+}
+
+/// What the interrupted-operation lines need from a driver.
+trait FaultDrv {
+    /// a `fault=1` scenario starts
+    fn begin(&mut self);
+    /// `J`: journal every in-scope cycle
+    fn journaling(&mut self);
+    fn arm(&mut self, spec: FaultSpec) -> Result<(), FaultError>;
+    fn cut(&mut self) -> Result<(), FaultError>;
+    fn restore(&mut self) -> Result<(), FaultError>;
+    fn state(&mut self) -> FaultState;
+    /// The SoC fires a cut that is due at the accept inside the write that accepts it, and notices every other one at the cycle the replay moves the clock to.
+    /// The chip driver (like the model) notices at its next look.
+    fn immediate_cuts(&self) -> bool {
+        false
+    }
+}
+
+struct ChipDrv {
+    chip: Chip,
+    mem: Vec<u8>,
+    hz: u64,
+    /// a `fault=1` scenario: the clock moves through `sync_cut` (settle, and the labelled placeholder after a cut), as the SoC will in 5C-2
+    fault: bool,
+}
+impl Drv for ChipDrv {
+    fn set_cycles(&mut self, c: u64) {
+        self.chip.set_clock(c, self.hz);
+        if self.fault {
+            self.chip.sync_cut(&mut self.mem);
+        }
+    }
+    fn fault(&mut self) -> Option<&mut dyn FaultDrv> {
+        Some(self)
+    }
+    fn known_hash(&mut self) -> u32 {
+        let ranges = self.chip.indeterminate().to_vec();
+        if ranges.is_empty() {
+            return fnv(&self.mem);
+        }
+        let mut m = self.mem.clone();
+        for (lo, hi) in ranges {
+            m[lo..=hi].fill(0);
+        }
+        fnv(&m)
+    }
+    fn tx(&mut self, tx: &[u8], read: usize, partial: u8) -> (Vec<u8>, Option<u8>) {
+        self.chip.select();
+        for &b in tx {
+            self.chip.transfer(&self.mem, b);
+        }
+        let out: Vec<u8> = (0..read).map(|_| self.chip.transfer(&self.mem, 0x00)).collect();
+        let unk = match tx.first() {
+            Some(0x05) => Some(self.chip.status().1 as u8),
+            Some(0x35) => Some((self.chip.status().1 >> 8) as u8),
+            _ => None,
+        };
+        self.chip.release(&mut self.mem, partial);
+        (out, unk)
+    }
+    fn power(&mut self) {
+        self.chip.power_cycle();
+    }
+    fn mem(&self) -> &[u8] {
+        &self.mem
+    }
+    fn wip(&mut self) -> bool {
+        self.chip.wip()
+    }
+    fn take_log(&mut self) -> Vec<&'static str> {
+        self.chip.take_log()
+    }
+}
+
+impl FaultDrv for ChipDrv {
+    fn begin(&mut self) {
+        self.fault = true;
+    }
+    fn journaling(&mut self) {
+        self.chip.set_fault_injection(true);
+    }
+    fn arm(&mut self, spec: FaultSpec) -> Result<(), FaultError> {
+        self.chip.arm_fault(spec)
+    }
+    fn cut(&mut self) -> Result<(), FaultError> {
+        let r = self.chip.power_cut().map(|_| ());
+        self.chip.sync_cut(&mut self.mem);
+        r
+    }
+    fn restore(&mut self) -> Result<(), FaultError> {
+        let r = self.chip.power_restore();
+        self.chip.sync_cut(&mut self.mem);
+        r
+    }
+    fn state(&mut self) -> FaultState {
+        self.chip.fault_state()
+    }
+}
+
+struct SocDrv {
+    soc: Soc,
+    /// a `fault=1` scenario: the clock moves through `sync_flash_cut`
+    fault: bool,
+}
+impl FaultDrv for SocDrv {
+    fn begin(&mut self) {
+        self.fault = true;
+    }
+    fn journaling(&mut self) {
+        self.soc.flash.chip.as_mut().unwrap().set_fault_injection(true);
+    }
+    fn arm(&mut self, spec: FaultSpec) -> Result<(), FaultError> {
+        self.soc.arm_flash_fault(spec)
+    }
+    fn cut(&mut self) -> Result<(), FaultError> {
+        self.soc.power_cut_flash().map(|_| ())
+    }
+    fn restore(&mut self) -> Result<(), FaultError> {
+        self.soc.flash.chip.as_mut().unwrap().power_restore()
+    }
+    fn state(&mut self) -> FaultState {
+        self.soc.sync_flash_cut();
+        let (c, hz) = (self.soc.periph.cycles, self.soc.periph.hz);
+        self.soc.flash.set_clock(c, hz);
+        self.soc.flash.chip.as_mut().unwrap().fault_state()
+    }
+    fn immediate_cuts(&self) -> bool {
+        true
+    }
+}
+impl Drv for SocDrv {
+    fn fault(&mut self) -> Option<&mut dyn FaultDrv> {
+        Some(self)
+    }
+    fn known_hash(&mut self) -> u32 {
+        let ranges = self.soc.flash.chip.as_ref().unwrap().indeterminate().to_vec();
+        if ranges.is_empty() {
+            return fnv(&self.soc.flash.mem);
+        }
+        let mut m = self.soc.flash.mem.clone();
+        for (lo, hi) in ranges {
+            m[lo..=hi].fill(0);
+        }
+        fnv(&m)
+    }
+    fn set_cycles(&mut self, c: u64) {
+        self.soc.periph.cycles = c;
+        if self.fault {
+            self.soc.sync_flash_cut();
+        }
+    }
+    fn tx(&mut self, tx: &[u8], read: usize, partial: u8) -> (Vec<u8>, Option<u8>) {
+        let s = &mut self.soc;
+        s.write32(CS, 0);
+        for &b in tx {
+            s.write32(SPI0, 0); // transmit mode
+            s.write32(SPI0 + 8, b as u32);
+        }
+        let mut out = Vec::new();
+        for _ in 0..read {
+            s.write32(SPI0, 0x1000); // receive mode: BUF returns the byte clocked in
+            s.write32(SPI0 + 8, 0);
+            out.push((s.read32(SPI0 + 8) & 0xff) as u8);
+        }
+        if partial != 0 {
+            // CS# rising mid-byte cannot happen on the byte-wide SPI0: hand the chip the event directly,
+            // then drop the GPIO line (the chip has nothing left to execute)
+            let f = &mut s.flash;
+            f.chip.as_mut().unwrap().release(&mut f.mem, partial);
+        }
+        s.write32(CS, 1);
+        (out, None)
+    }
+    fn power(&mut self) {
+        let (c, hz) = (self.soc.periph.cycles, self.soc.periph.hz);
+        self.soc.flash.set_clock(c, hz);
+        self.soc.flash.chip.as_mut().unwrap().power_cycle();
+    }
+    fn mem(&self) -> &[u8] {
+        &self.soc.flash.mem
+    }
+    fn wip(&mut self) -> bool {
+        let (c, hz) = (self.soc.periph.cycles, self.soc.periph.hz);
+        self.soc.flash.wip(c, hz)
+    }
+    fn take_log(&mut self) -> Vec<&'static str> {
+        self.soc.flash.chip.as_mut().unwrap().take_log()
+    }
+}
+
+#[derive(Default)]
+struct Report {
+    scenarios: usize,
+    transactions: usize,
+    array_checks: usize,
+    hashes: usize,
+    wip_checks: usize,
+    power: usize,
+    fault_steps: usize,
+    mismatches: Vec<String>,
+}
+
+type Maker = dyn Fn(ChipKind, Timing, u64, bool, bool, Option<[u8; 16]>) -> Box<dyn Drv>;
+
+fn replay(make: &Maker) -> Report {
+    let path = std::env::var("FM1_CHIP_ORACLE").expect("FM1_CHIP_ORACLE must name the oracle transcript file (see gen-transcripts.mjs)");
+    let text = std::fs::read_to_string(&path).unwrap_or_else(|e| panic!("cannot read {path}: {e}"));
+    let mut rep = Report::default();
+    let mut drv: Option<Box<dyn Drv>> = None;
+    let (mut name, mut hz, mut us_total) = (String::new(), 100_000_000u64, 0u64);
+    let mut skip = false;
+    let mut bad = |rep: &mut Report, name: &str, ln: usize, what: String| {
+        if rep.mismatches.len() < 25 {
+            rep.mismatches.push(format!("{name} line {ln}: {what}"));
+        } else if rep.mismatches.len() == 25 {
+            rep.mismatches.push("... (more)".into());
+        }
+    };
+    let mut nbad = 0usize;
+    for (i, line) in text.lines().enumerate() {
+        let ln = i + 1;
+        let f: Vec<&str> = line.split(' ').collect();
+        if skip {
+            skip = f[0] != "E"; // a scenario this driver cannot replay: ignore it up to its end
+            continue;
+        }
+        match f[0] {
+            "S" => {
+                name = f[1].to_string();
+                let kind = if f[2] == "puya" { ChipKind::Puya } else { ChipKind::Uc25hq80 };
+                let timing = if f[3] == "typical" { Timing::Typical } else { Timing::Maximum };
+                hz = f[4].parse().unwrap();
+                let (wp, pat) = (f[5] == "1", f[6] == "pat");
+                // an optional 4Bh unique-ID fixture: uid=<32 hex digits> (a test fixture; no real device ID)
+                let uid: Option<[u8; 16]> = f.get(7).and_then(|s| s.strip_prefix("uid=")).map(|h| unhex(h).try_into().expect("16 bytes"));
+                let mut d = make(kind, timing, hz, wp, pat, uid);
+                if f.iter().any(|x| *x == "fault=1") {
+                    match d.fault() {
+                        Some(c) => c.begin(),
+                        None => {
+                            skip = true;
+                            continue;
+                        }
+                    }
+                }
+                drv = Some(d);
+                us_total = 0;
+                rep.scenarios += 1;
+            }
+            "E" => drv = None,
+            "T" => {
+                let d = drv.as_mut().unwrap();
+                let adv: u64 = f[1].parse().unwrap();
+                us_total += adv;
+                d.set_cycles(us_total * (hz / 1_000_000));
+                let res = line.split(" => ").nth(1).unwrap();
+                if res == "ADV" {
+                    continue;
+                }
+                let (partial, read): (u8, usize) = (f[2].parse().unwrap(), f[3].parse().unwrap());
+                let tx = unhex(f[4]);
+                rep.transactions += 1;
+                let (out, unk) = d.tx(&tx, read, partial);
+                let log = d.take_log();
+                let r: Vec<&str> = res.split(' ').collect();
+                if r[0] == "OFF" {
+                    rep.fault_steps += 1;
+                    let off = d.fault().is_some_and(|c| c.state().powered_off);
+                    if !off || !out.iter().all(|&b| b == 0xff) || !log.is_empty() {
+                        nbad += 1;
+                        bad(&mut rep, &name, ln, format!("tx {} oracle says the chip is powered off: chip powered_off {off}, answered {out:02x?}, events {log:?}", f[4]));
+                    }
+                } else if r[0] == "OK" {
+                    if !log.is_empty() {
+                        nbad += 1;
+                        bad(&mut rep, &name, ln, format!("oracle OK, chip recorded events {log:?}"));
+                    }
+                    let (eout, eunk) = (unhex(r[1]), unhex(r[2]));
+                    if read > 0 && !eout.is_empty() {
+                        let status = matches!(tx[0], 0x05 | 0x35);
+                        for k in 0..read {
+                            let mask = !eunk[k]; // bits the oracle marks unknown (status bits the datasheets leave open; the 4Bh ID without a fixture)
+                            if (out[k] ^ eout[k]) & mask != 0 {
+                                nbad += 1;
+                                bad(&mut rep, &name, ln, format!("tx {} read byte {k}: chip {:02x}, oracle {:02x} (unknown mask {:02x})", f[4], out[k], eout[k], if status { eunk[k] } else { 0 }));
+                                break;
+                            }
+                        }
+                        if let (Some(u), true) = (unk, status) {
+                            if eunk.iter().any(|&e| e != u) {
+                                nbad += 1;
+                                bad(&mut rep, &name, ln, format!("tx {} unknown mask: chip {u:02x}, oracle {}", f[4], r[2]));
+                            }
+                        }
+                    }
+                } else if r[0] == "ERR" {
+                    if log != [r[2]] {
+                        nbad += 1;
+                        bad(&mut rep, &name, ln, format!("tx {} oracle refuses with {} {}, chip recorded {log:?}", f[4], r[1], r[2]));
+                    }
+                } else {
+                    panic!("bad result {res}");
+                }
+            }
+            "P" => {
+                let d = drv.as_mut().unwrap();
+                d.power();
+                let log = d.take_log();
+                rep.power += 1;
+                let ok = line.ends_with("=> OK");
+                let exp: Vec<&str> = if ok { vec![] } else { vec!["nm.power-loss"] };
+                if log != exp {
+                    nbad += 1;
+                    bad(&mut rep, &name, ln, format!("power cycle: oracle {}, chip events {log:?}", &line[4..]));
+                }
+            }
+            "A" => {
+                let d = drv.as_mut().unwrap();
+                let (a, l): (usize, usize) = (f[1].parse().unwrap(), f[2].parse().unwrap());
+                rep.array_checks += 1;
+                if d.mem()[a..a + l] != unhex(f[3])[..] {
+                    nbad += 1;
+                    bad(&mut rep, &name, ln, format!("array {a:#x}+{l}: chip {:02x?}.. oracle {}", &d.mem()[a..(a + l).min(a + 8)], &f[3][..f[3].len().min(16)]));
+                }
+            }
+            "D" => {
+                let d = drv.as_mut().unwrap();
+                rep.hashes += 1;
+                let h = d.known_hash();
+                if format!("{h:08x}") != f[1] {
+                    nbad += 1;
+                    bad(&mut rep, &name, ln, format!("final array hash: chip {h:08x}, oracle {}", f[1]));
+                }
+            }
+            "W" => {
+                let d = drv.as_mut().unwrap();
+                rep.wip_checks += 1;
+                if d.wip() != (f[1] == "1") {
+                    nbad += 1;
+                    bad(&mut rep, &name, ln, format!("WIP: chip {}, oracle {}", !(f[1] == "1"), f[1]));
+                }
+            }
+            "J" => {
+                drv.as_mut().unwrap().fault().unwrap().journaling();
+            }
+            "F" => {
+                let c = drv.as_mut().unwrap().fault().unwrap();
+                let op = match f[1] {
+                    "program" => FaultOp::Program,
+                    "erase4k" => FaultOp::Erase4k,
+                    "erase32k" => FaultOp::Erase32k,
+                    "erase64k" => FaultOp::Erase64k,
+                    "erase" => FaultOp::Erase,
+                    "chip-erase" => FaultOp::ChipErase,
+                    "any" => FaultOp::Any,
+                    other => panic!("bad fault op {other}"),
+                };
+                let at = match f[3] {
+                    "accept" => FaultAt::AtAccept,
+                    "fraction" => FaultAt::Fraction(f[4].parse().unwrap()),
+                    "afterUs" => FaultAt::AfterUs(f[4].parse().unwrap()),
+                    other => panic!("bad fault trigger {other}"),
+                };
+                rep.fault_steps += 1;
+                if let Err(e) = c.arm(FaultSpec { op, nth: f[2].parse().unwrap(), at }) {
+                    nbad += 1;
+                    bad(&mut rep, &name, ln, format!("arm_fault refused a trigger the oracle accepted: {}", e.id()));
+                }
+            }
+            "C" | "R" => {
+                let c = drv.as_mut().unwrap().fault().unwrap();
+                let got = if f[0] == "C" { c.cut() } else { c.restore() };
+                let got = match got {
+                    Ok(()) => "OK".to_string(),
+                    Err(e) => format!("ERR {}", e.id()),
+                };
+                rep.fault_steps += 1;
+                if got != line[5..] {
+                    nbad += 1;
+                    bad(&mut rep, &name, ln, format!("{}: chip {got}, oracle {}", f[0], &line[5..]));
+                }
+            }
+            "Q" | "K" => {
+                let c = drv.as_mut().unwrap().fault().unwrap();
+                let st = c.state();
+                let rt = |rs: &[(usize, usize)]| if rs.is_empty() { "-".to_string() } else { rs.iter().map(|(l, h)| format!("{l}-{h}")).collect::<Vec<_>>().join(",") };
+                let got = if f[0] == "Q" {
+                    format!("{} {} {} {} {} {} {}", st.powered_off as u8, st.accepted, st.completed, st.interrupted, st.fired, st.indeterminate_reads, rt(&st.indeterminate))
+                } else {
+                    match &st.last {
+                        None => "no record".to_string(),
+                        Some(r) => format!(
+                            "{} {} {} {} {} {} {} {} {} {} {:08x} {:08x} {:08x} {:08x}",
+                            r.op.name(),
+                            if r.source == fm1_soc::spichip::CutSource::Scheduled { "scheduled" } else { "harness" },
+                            r.ordinal,
+                            r.nth.map_or("-".to_string(), |n| n.to_string()),
+                            r.started_at,
+                            r.cut_at,
+                            r.end_would_be_at,
+                            r.detected_at,
+                            rt(&r.ranges),
+                            r.before.len(),
+                            fnv(&r.before),
+                            fnv(&r.unknown_before),
+                            fnv(&r.if_completed),
+                            fnv(&r.unknown_if_completed)
+                        ),
+                    }
+                };
+                rep.fault_steps += 1;
+                let mut want = line[2..].to_string();
+                if f[0] == "K" && c.immediate_cuts() && f[5] == f[6] {
+                    // fields: op source ordinal nth startedAt cutAt endWouldBeAt detectedAt ...; a cut due at the accept is detected at the accept
+                    let mut parts: Vec<&str> = want.split(' ').collect();
+                    parts[7] = f[6];
+                    want = parts.join(" ");
+                }
+                if got != want {
+                    nbad += 1;
+                    bad(&mut rep, &name, ln, format!("{}: chip `{got}`, oracle `{want}`", f[0]));
+                }
+            }
+            other => panic!("unknown transcript line kind {other}"),
+        }
+    }
+    let _ = nbad;
+    rep
+}
+
+fn run(make: &Maker, label: &str) {
+    let r = replay(make);
+    eprintln!(
+        "{label}: {} scenarios, {} transactions, {} array checks, {} final hashes, {} WIP checks, {} power cycles, {} fault steps; mismatches: {}",
+        r.scenarios, r.transactions, r.array_checks, r.hashes, r.wip_checks, r.power, r.fault_steps, r.mismatches.len()
+    );
+    assert!(r.mismatches.is_empty(), "{label}: oracle mismatches:\n{}", r.mismatches.join("\n"));
+    assert!(r.scenarios > 300 && r.transactions > 50_000, "{label}: transcript too small to mean anything");
+}
