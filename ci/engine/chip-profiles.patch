diff --git a/crates/fm1-soc/src/spichip.rs b/crates/fm1-soc/src/spichip.rs
new file mode 100644
index 0000000..3940d8d
--- /dev/null
+++ b/crates/fm1-soc/src/spichip.rs
@@ -0,0 +1,2123 @@
+//! Datasheet-based SPI NOR chip state machine (HEATWAVS Stage C1), used by `SpiFlash` when a
+//! chip profile is selected. The default (no profile) is the original instantaneous model.
+//!
+//! The behaviour is a port of the Stage A reference model (`ci/machine/chipmodel.mjs`, which cites
+//! the Puya P25Q80H V1.7 and UC25HQ80 v1.2 datasheets by page and section for every behaviour);
+//! `tests/chip_oracle.rs` replays transcripts generated from that model against this code.
+//!
+//! Differences from the reference model, all deliberate:
+//! * Byte stream, not transactions. SPI0 moves whole bytes and chip select is a GPIO, so a
+//!   transaction ends when CS rises. Cases the byte stream cannot express (extra bytes after
+//!   RDSR/RDID are just more read slots; CS rising mid-byte) exist only in the reference model
+//!   and, for CS mid-byte, through `Chip::release(.., partial_bits)` (tests only).
+//! * Unspecified behaviour is never guessed: the command is ignored with no state change and the
+//!   datasheet behaviour id is recorded in `Events` (the reference model throws instead).
+//!   Status bits whose value the datasheet leaves open are tracked in `status_unknown`.
+//! * The array changes when a program/erase command is accepted (CS rises), as in the original
+//!   model, while WIP/WEL follow the cycle time. The datasheets leave the array contents during
+//!   a cycle unspecified (`array.during-cycle`) and reads during a cycle are not answered.
+//! * Time is the SoC cycle counter (`Periph::cycles`) at `hz`; cycle durations are the datasheet
+//!   typical or maximum figures rounded up to whole cycles.
+//! * FM1_FLASH_CUT power cuts are not honoured under a chip profile (native fm1-live only).
+//! * Interrupted operations (Component 5, Stage 5C-1): the chip state only. With fault injection off (the default) none of the
+//!   code below runs beyond a few counter increments. See "interrupted operations" further down and docs/dev/FAULT-INJECTION.md.
+
+use crate::spichip_tables::{Profile, Row, PUYA, UC25HQ80};
+use crate::spiflash::FLASH_SIZE;
+
+#[derive(Clone, Copy, PartialEq, Eq, Debug)]
+pub enum ChipKind {
+    Puya,
+    Uc25hq80,
+}
+
+#[derive(Clone, Copy, PartialEq, Eq, Debug)]
+pub enum Timing {
+    Typical,
+    Maximum,
+}
+
+// 16-bit status register (S15..S8 read by 35h, S7..S0 by 05h)
+pub const WIP: u16 = 1 << 0;
+pub const WEL: u16 = 1 << 1;
+const BP0: u16 = 1 << 2;
+const BP1: u16 = 1 << 3;
+const BP2: u16 = 1 << 4;
+const BP3: u16 = 1 << 5;
+const BP4: u16 = 1 << 6;
+const SRP0: u16 = 1 << 7;
+const SRP1: u16 = 1 << 8;
+const QE: u16 = 1 << 9;
+const LB1: u16 = 1 << 11;
+const LB2: u16 = 1 << 12;
+const LB3: u16 = 1 << 13;
+const CMP: u16 = 1 << 14;
+const BP: u16 = BP0 | BP1 | BP2 | BP3 | BP4;
+const LB: u16 = LB1 | LB2 | LB3;
+const LOW_WRITABLE: u16 = SRP0 | BP;
+const HIGH_WRITABLE: u16 = SRP1 | QE | LB | CMP;
+const ONE_BYTE_CLEARS: u16 = CMP | QE | SRP1;
+
+const PAGE: usize = 256;
+const BYTES: usize = FLASH_SIZE;
+
+/// What the chip was asked that its datasheet does not settle, or that is outside the model.
+#[derive(Default, Clone, Debug)]
+pub struct Events {
+    /// commands ignored because the datasheet is silent or contradicts itself
+    pub unspecified: u32,
+    /// opcodes outside the modelled set (answered with 0xFF, no state change)
+    pub not_modeled: u32,
+    /// the most recent opcode counted in `not_modeled` (0 if none)
+    pub last_not_modeled: u8,
+    /// 4Bh Read Unique ID reads answered without a configured ID fixture: the datasheets print no value, so the bytes are 0xFF and
+    /// unknown (reported, not invented)
+    pub uid_unknown_reads: u32,
+    /// ids of the most recent events (behaviour ids from chipspec.mjs), oldest dropped
+    pub log: Vec<&'static str>,
+}
+
+const LOG_MAX: usize = 64;
+
+#[derive(Clone, Copy, PartialEq, Eq, Debug)]
+enum Cmd {
+    /// nothing to do (an ignored command, an unmodelled opcode, no opcode yet)
+    Ignore,
+    Rdsr(u8),
+    Rdid,
+    /// 4Bh Read Unique ID: four dummy bytes, then the 128-bit ID
+    Ruid,
+    Read03,
+    Read0b,
+    /// executes when CS rises
+    Write(u8),
+}
+
+#[derive(Clone, Copy, PartialEq, Eq, Debug)]
+enum CycleKind {
+    Program,
+    Erase,
+    Wrsr,
+}
+
+#[derive(Clone, Copy, Debug)]
+struct Busy {
+    end: u64,
+    kind: CycleKind,
+    /// status after a write-status cycle completes (Wrsr only)
+    next_sr: u16,
+    next_unknown: u16,
+    /// status bits whose value is open while the cycle runs
+    unknown_bits: u16,
+    /// an erase cycle: the bytes it clears (and makes known again) when it completes (also 81h)
+    erase_range: Option<(usize, usize)>,
+    /// page program, 20h/52h/D8h erase or chip erase: the kinds a power cut may interrupt (Stage 5B scope)
+    in_scope: bool,
+}
+
+// ------------------------------------------------------------------------------------------------ interrupted operations (Component 5, Stage 5C-1)
+// The chip state of a power cut, mirroring ci/machine/chipmodel.mjs. The chip records THAT a cycle was interrupted, WHICH bytes it put at risk and
+// what they held before; it never decides what they hold afterwards. Bytes of an interrupted range are "indeterminate": a list kept beside
+// (never inside) the array. No synthetic fill exists here; a fill is an explicit test policy applied by the harness (faultpolicy.mjs).
+// D33 (the array changes at accept) means the array already holds the completed result while the cycle runs; the journal captured at accept
+// preserves the bytes as they were, so a cut can say what the range held before and what a normal completion would have produced.
+
+/// Which cycles an armed fault may match (`FAULT_OPS` in chipmodel.mjs). Page erase (81h), write-status, suspend/resume, reset and brown-out
+/// are out of scope and cannot be named: a cut never matches them.
+#[derive(Clone, Copy, PartialEq, Eq, Debug)]
+pub enum FaultOp {
+    Program,
+    Erase4k,
+    Erase32k,
+    Erase64k,
+    /// any of the three sector/block erases
+    Erase,
+    ChipErase,
+    Any,
+}
+
+impl FaultOp {
+    pub fn name(self) -> &'static str {
+        match self {
+            FaultOp::Program => "program",
+            FaultOp::Erase4k => "erase4k",
+            FaultOp::Erase32k => "erase32k",
+            FaultOp::Erase64k => "erase64k",
+            FaultOp::Erase => "erase",
+            FaultOp::ChipErase => "chip-erase",
+            FaultOp::Any => "any",
+        }
+    }
+    /// `matchesOp(selector, op)` of the reference model; `cycle` is a concrete kind (never `Erase` or `Any`).
+    fn matches(self, cycle: FaultOp) -> bool {
+        self == cycle || self == FaultOp::Any || (self == FaultOp::Erase && matches!(cycle, FaultOp::Erase4k | FaultOp::Erase32k | FaultOp::Erase64k))
+    }
+}
+
+/// When, after the accept of the matching cycle, the cut happens. The cut must come before the cycle ends (a cut at the end is a normal completion).
+#[derive(Clone, Copy, PartialEq, Debug)]
+pub enum FaultAt {
+    /// at the accept itself (offset 0)
+    AtAccept,
+    /// `floor(fraction * duration_us)` microseconds after the accept, 0 <= fraction < 1 (the same IEEE computation as `Math.floor(f * dur)`)
+    Fraction(f64),
+    /// this many microseconds after the accept, below the shortest duration the selector can match
+    AfterUs(u32),
+}
+
+/// One deterministic power cut: the `nth` accepted in-scope cycle matching `op`, cut at `at`. Single shot.
+#[derive(Clone, Copy, PartialEq, Debug)]
+pub struct FaultSpec {
+    pub op: FaultOp,
+    pub nth: u32,
+    pub at: FaultAt,
+}
+
+#[derive(Clone, Copy, PartialEq, Eq, Debug)]
+pub enum CutSource {
+    /// the armed trigger fired
+    Scheduled,
+    /// `power_cut()`
+    Harness,
+}
+
+/// What a cut left behind. `before` and `if_completed` are INPUTS for an outcome policy (what the range held, and what a normal completion
+/// would have produced), never outcomes; a byte whose value is unknown has its mask byte set to 1 and a 0 placeholder. Times are SoC cycles.
+#[derive(Clone, Debug, PartialEq)]
+pub struct FaultRecord {
+    pub source: CutSource,
+    pub op: FaultOp,
+    /// 1-based count of every cycle accepted since power-on (write-status and page erase included)
+    pub ordinal: u32,
+    pub nth: Option<u32>,
+    pub started_at: u64,
+    pub cut_at: u64,
+    pub end_would_be_at: u64,
+    pub detected_at: u64,
+    /// inclusive absolute addresses: the latched runs of a page program, the unit of an erase, the whole array for a chip erase
+    pub ranges: Vec<(usize, usize)>,
+    pub before: Vec<u8>,
+    pub unknown_before: Vec<u8>,
+    pub if_completed: Vec<u8>,
+    pub unknown_if_completed: Vec<u8>,
+}
+
+/// Refusals of the fault interface (ids as in chipmodel.mjs).
+#[derive(Clone, Copy, PartialEq, Eq, Debug)]
+pub enum FaultError {
+    BadNth,
+    BadAt,
+    AlreadyArmed,
+    /// the chip is powered off after a cut: `power_restore()` first
+    UseRestore,
+    NoCycle,
+    AlreadyOff,
+    NotOff,
+    /// a write-status or page-erase cycle: never interrupted, never silently completed
+    OutOfScope,
+    /// the running cycle was accepted before fault injection was enabled, so nothing was journaled for it
+    NotEnabled,
+}
+
+impl FaultError {
+    pub fn id(self) -> &'static str {
+        match self {
+            FaultError::BadNth => "fault.bad-nth",
+            FaultError::BadAt => "fault.bad-at",
+            FaultError::AlreadyArmed => "fault.already-armed",
+            FaultError::UseRestore => "fault.use-restore",
+            FaultError::NoCycle => "fault.no-cycle",
+            FaultError::AlreadyOff => "fault.already-off",
+            FaultError::NotOff => "fault.not-off",
+            FaultError::OutOfScope => "fault.out-of-scope",
+            FaultError::NotEnabled => "fault.not-enabled",
+        }
+    }
+}
+
+#[derive(Clone, Copy)]
+struct Armed {
+    spec: FaultSpec,
+    seen: u32,
+    scheduled: bool,
+}
+
+/// What the running in-scope cycle looked like at accept.
+struct Journal {
+    op: FaultOp,
+    ordinal: u32,
+    started_at: u64,
+    end: u64,
+    cut_at: Option<u64>,
+    ranges: Vec<(usize, usize)>,
+    before: Vec<u8>,
+    unknown_before: Vec<u8>,
+    if_completed: Vec<u8>,
+    unknown_if_completed: Vec<u8>,
+}
+
+/// Captured before the array is changed.
+struct Pre {
+    ranges: Vec<(usize, usize)>,
+    before: Vec<u8>,
+    unknown_before: Vec<u8>,
+}
+
+#[derive(Default)]
+struct FaultCtl {
+    /// journal every in-scope cycle at accept (set by `arm_fault` or `set_fault_injection`); off by default
+    journaling: bool,
+    armed: Option<Armed>,
+    journal: Option<Journal>,
+    powered_off: bool,
+    /// the array still holds the completed image in the cut range: `sync_cut` writes the pre-image back as a labelled placeholder
+    restore_pending: bool,
+    last: Option<FaultRecord>,
+    fired: u32,
+    /// sorted, disjoint, non-adjacent inclusive ranges: bytes whose contents are physically unknown
+    indet: Vec<(usize, usize)>,
+    indet_reads: u32,
+    off_accesses: u32,
+    refused: u32,
+    accepted: u32,
+    completed: u32,
+    interrupted: u32,
+    ordinal: u32,
+}
+
+/// A snapshot of the fault machinery (settles first). Inert (zeros, empty) unless fault injection is used.
+#[derive(Clone, Debug, PartialEq)]
+pub struct FaultState {
+    /// (trigger, matching cycles seen, scheduled)
+    pub armed: Option<(FaultSpec, u32, bool)>,
+    pub journaling: bool,
+    pub powered_off: bool,
+    pub fired: u32,
+    pub last: Option<FaultRecord>,
+    pub indeterminate: Vec<(usize, usize)>,
+    pub indeterminate_reads: u32,
+    /// SPI bytes offered to a powered-off chip (answered 0xFF; the reference model throws `PoweredOff`)
+    pub powered_off_accesses: u32,
+    /// `power_cycle()` calls refused while powered off
+    pub power_cycle_refused: u32,
+    pub accepted: u32,
+    pub completed: u32,
+    pub interrupted: u32,
+}
+
+pub struct Chip {
+    kind: ChipKind,
+    timing: Timing,
+    wp: bool,
+    sr: u16,
+    unknown: u16,
+    busy: Option<Busy>,
+    now: u64,
+    hz: u64,
+    // the current transaction
+    cmd: Cmd,
+    n: usize,
+    hdr: [u8; 4],
+    latch: [u8; PAGE],
+    used: [bool; PAGE],
+    /// unspecified-event guard for the "read past the ID" case (once per transaction)
+    id_extra: bool,
+    /// guard: count a 4Bh read without a fixture once per transaction
+    uid_counted: bool,
+    /// The 128-bit unique ID 4Bh transmits, byte 0 (bits 127-120) first. A caller-supplied fixture: the value is per device and in neither
+    /// datasheet, so there is none unless one is set (and none is ever invented).
+    uid: Option<[u8; 16]>,
+    /// interrupted-operation state (Component 5); inert unless fault injection is used
+    fault: FaultCtl,
+    /// guard: count a read of indeterminate bytes once per transaction
+    indet_counted: bool,
+    pub events: Events,
+}
+
+impl Chip {
+    pub fn new(kind: ChipKind, timing: Timing) -> Self {
+        Self {
+            kind,
+            timing,
+            wp: true,
+            sr: 0,
+            unknown: 0,
+            busy: None,
+            now: 0,
+            hz: 1_000_000,
+            cmd: Cmd::Ignore,
+            n: 0,
+            hdr: [0; 4],
+            latch: [0xff; PAGE],
+            used: [false; PAGE],
+            id_extra: false,
+            uid_counted: false,
+            uid: None,
+            fault: FaultCtl::default(),
+            indet_counted: false,
+            events: Events::default(),
+        }
+    }
+
+    /// Set (or clear) the unique-ID fixture 4Bh returns. Survives power cycles (the ID is factory-set and read-only).
+    pub fn set_uid(&mut self, uid: Option<[u8; 16]>) { self.uid = uid; }
+    pub fn uid(&self) -> Option<[u8; 16]> { self.uid }
+
+    pub fn kind(&self) -> ChipKind { self.kind }
+    pub fn timing(&self) -> Timing { self.timing }
+    pub fn set_timing(&mut self, t: Timing) { self.timing = t; }
+    /// The WP# pin (default high). Only matters when SRP1:SRP0 = 0:1.
+    pub fn set_wp(&mut self, high: bool) { self.wp = high; }
+
+    fn profile(&self) -> &'static Profile {
+        match self.kind {
+            ChipKind::Puya => &PUYA,
+            ChipKind::Uc25hq80 => &UC25HQ80,
+        }
+    }
+
+    /// The SoC's clock: the cycle count and cycles per second. Called before every operation.
+    pub fn set_clock(&mut self, now: u64, hz: u64) {
+        self.now = now;
+        self.hz = hz.max(1);
+    }
+
+    fn cycles(&self, us: u32) -> u64 {
+        ((us as u128 * self.hz as u128 + 999_999) / 1_000_000) as u64
+    }
+
+    fn event(&mut self, id: &'static str, unspecified: bool) {
+        if unspecified { self.events.unspecified += 1 } else { self.events.not_modeled += 1 }
+        if self.events.log.len() >= LOG_MAX {
+            self.events.log.remove(0);
+        }
+        self.events.log.push(id);
+    }
+    fn unspec(&mut self, id: &'static str) { self.event(id, true); }
+
+    /// Take (and clear) the recorded event ids.
+    pub fn take_log(&mut self) -> Vec<&'static str> { std::mem::take(&mut self.events.log) }
+
+    // ------------------------------------------------------------ interrupted operations (Component 5, Stage 5C-1)
+    /// Journal every in-scope cycle from now on, so `power_cut()` can interrupt one without a trigger. Off by default: with it off, and no
+    /// trigger armed, nothing is captured and the chip behaves exactly as before. (`arm_fault` turns it on.)
+    pub fn set_fault_injection(&mut self, on: bool) { self.fault.journaling = on; }
+
+    /// Arm one deterministic power cut (single shot). Refusals mirror `ChipModel.armFault`; order: nth, already armed, powered off, trigger.
+    pub fn arm_fault(&mut self, spec: FaultSpec) -> Result<(), FaultError> {
+        if spec.nth < 1 {
+            return Err(FaultError::BadNth);
+        }
+        if self.fault.armed.is_some() {
+            return Err(FaultError::AlreadyArmed);
+        }
+        if self.fault.powered_off {
+            return Err(FaultError::UseRestore);
+        }
+        let t = self.us();
+        let min_dur = match spec.op {
+            FaultOp::Program => t.pp,
+            FaultOp::Erase4k => t.se,
+            FaultOp::Erase32k => t.be32,
+            FaultOp::Erase64k => t.be64,
+            FaultOp::Erase => t.se.min(t.be32).min(t.be64),
+            FaultOp::ChipErase => t.ce,
+            FaultOp::Any => t.pp.min(t.se).min(t.be32).min(t.be64).min(t.ce),
+        };
+        let ok = match spec.at {
+            FaultAt::AtAccept => true,
+            FaultAt::Fraction(f) => f.is_finite() && f >= 0.0 && f < 1.0, // 1 would be a normal completion
+            FaultAt::AfterUs(n) => n < min_dur,                            // at or after the end of the shortest matching cycle is a normal completion
+        };
+        if !ok {
+            return Err(FaultError::BadAt);
+        }
+        self.fault.armed = Some(Armed { spec, seen: 0, scheduled: false });
+        self.fault.journaling = true;
+        Ok(())
+    }
+
+    /// Remove the trigger. A cut already scheduled for the running cycle still happens.
+    pub fn disarm_fault(&mut self) { self.fault.armed = None; }
+
+    /// Cut power NOW (harness-initiated) while an in-scope cycle is in flight; if a scheduled cut was already due, that one happened and its record is returned.
+    /// Refused, never silently completed: no cycle running, an out-of-scope cycle (write-status, page erase), already off, or a cycle accepted before
+    /// fault injection was enabled.
+    pub fn power_cut(&mut self) -> Result<FaultRecord, FaultError> {
+        let was_off = self.fault.powered_off;
+        self.settle();
+        if self.fault.powered_off {
+            if was_off {
+                return Err(FaultError::AlreadyOff);
+            }
+            return Ok(self.fault.last.clone().expect("a cut leaves a record"));
+        }
+        let Some(b) = self.busy else { return Err(FaultError::NoCycle) };
+        if !b.in_scope {
+            return Err(FaultError::OutOfScope);
+        }
+        if self.fault.journal.is_none() {
+            return Err(FaultError::NotEnabled);
+        }
+        let now = self.now;
+        self.fire_cut(now, CutSource::Harness);
+        Ok(self.fault.last.clone().expect("a cut leaves a record"))
+    }
+
+    /// Power returns after a cut: standby, WEL = 0, nothing running, non-volatile status bits kept, SRP 1:0 back to 0:0. Never resumes the interrupted
+    /// cycle. The indeterminate list is kept.
+    pub fn power_restore(&mut self) -> Result<(), FaultError> {
+        self.settle();
+        if !self.fault.powered_off {
+            return Err(FaultError::NotOff);
+        }
+        self.fault.powered_off = false;
+        self.busy = None;
+        self.fault.journal = None;
+        self.sr &= !(WEL | WIP);
+        self.unknown &= !WEL;
+        if self.unknown & (SRP0 | SRP1) == 0 && self.sr & SRP1 != 0 && self.sr & SRP0 == 0 {
+            self.sr &= !SRP1;
+        }
+        self.cmd = Cmd::Ignore;
+        self.n = 0;
+        Ok(())
+    }
+
+    /// Settle at the current clock and, after a cut, write the pre-image back into the cut range as a labelled PLACEHOLDER (D33: the array holds the completed
+    /// image until now). It is not an outcome: the indeterminate list stays the authority. Only bytes whose pre-image was known are written. Returns the span
+    /// of the array changed, if any. The caller that owns the array calls this wherever it advances the clock.
+    pub fn sync_cut(&mut self, mem: &mut [u8]) -> Option<(usize, usize)> {
+        self.settle();
+        if !self.fault.restore_pending {
+            return None;
+        }
+        self.fault.restore_pending = false;
+        let rec = self.fault.last.as_ref()?;
+        let (mut lo, mut hi, mut i) = (usize::MAX, 0, 0);
+        for &(l, h) in &rec.ranges {
+            for a in l..=h {
+                if rec.unknown_before[i] == 0 {
+                    mem[a] = rec.before[i];
+                }
+                i += 1;
+            }
+            lo = lo.min(l);
+            hi = hi.max(h + 1);
+        }
+        Some((lo, hi))
+    }
+
+    /// What the fault machinery knows at the current chip time (settles first, so a due cut is reported as fired).
+    pub fn fault_state(&mut self) -> FaultState {
+        self.settle();
+        let f = &self.fault;
+        FaultState {
+            armed: f.armed.map(|a| (a.spec, a.seen, a.scheduled)),
+            journaling: f.journaling,
+            powered_off: f.powered_off,
+            fired: f.fired,
+            last: f.last.clone(),
+            indeterminate: f.indet.clone(),
+            indeterminate_reads: f.indet_reads,
+            powered_off_accesses: f.off_accesses,
+            power_cycle_refused: f.refused,
+            accepted: f.accepted,
+            completed: f.completed,
+            interrupted: f.interrupted,
+        }
+    }
+
+    /// The indeterminate ranges (inclusive, sorted, disjoint, merged when adjacent). Bytes of the array inside them are placeholders or synthetic test input,
+    /// never a claim about the physical chip.
+    pub fn indeterminate(&self) -> &[(usize, usize)] { &self.fault.indet }
+
+    fn program_runs(&self, page: usize) -> Vec<(usize, usize)> {
+        let mut runs: Vec<(usize, usize)> = Vec::new();
+        for o in 0..PAGE {
+            if self.used[o] {
+                match runs.last_mut() {
+                    Some(r) if r.1 + 1 == page + o => r.1 = page + o,
+                    _ => runs.push((page + o, page + o)),
+                }
+            }
+        }
+        runs
+    }
+
+    /// The pre-image of `ranges`, taken before the array is changed; bytes already indeterminate are marked unknown (0 placeholder).
+    fn fault_pre(&self, mem: &[u8], ranges: Vec<(usize, usize)>) -> Pre {
+        let n: usize = ranges.iter().map(|&(l, h)| h - l + 1).sum();
+        let (mut before, mut unknown_before) = (Vec::with_capacity(n), vec![0u8; n]);
+        let mut i = 0;
+        for &(lo, hi) in &ranges {
+            if self.fault.indet.is_empty() {
+                before.extend_from_slice(&mem[lo..=hi]);
+                i += hi - lo + 1;
+            } else {
+                for a in lo..=hi {
+                    if self.is_indet(a) {
+                        before.push(0);
+                        unknown_before[i] = 1;
+                    } else {
+                        before.push(mem[a]);
+                    }
+                    i += 1;
+                }
+            }
+        }
+        Pre { ranges, before, unknown_before }
+    }
+
+    /// After an in-scope cycle was accepted and the array changed (D33): journal it, count it against the armed trigger and schedule the cut.
+    fn fault_post(&mut self, mem: &[u8], op: FaultOp, us: u32, pre: Option<Pre>) {
+        let Some(pre) = pre else { return };
+        let depends_on_old = op == FaultOp::Program; // a program over an indeterminate byte stays indeterminate; an erase defines its bytes
+        let n = pre.before.len();
+        let (mut if_completed, mut unknown_if_completed) = (Vec::with_capacity(n), vec![0u8; n]);
+        let mut i = 0;
+        for &(lo, hi) in &pre.ranges {
+            for a in lo..=hi {
+                if !depends_on_old {
+                    if_completed.push(0xff);
+                } else if self.is_indet(a) {
+                    if_completed.push(0);
+                    unknown_if_completed[i] = 1;
+                } else {
+                    if_completed.push(mem[a]); // the array already holds pre & latch (D33)
+                }
+                i += 1;
+            }
+        }
+        let end = self.busy.expect("start() ran").end;
+        let mut offset_us = None;
+        if let Some(a) = self.fault.armed.as_mut() {
+            if !a.scheduled && a.spec.op.matches(op) {
+                a.seen += 1;
+                if a.seen == a.spec.nth {
+                    a.scheduled = true;
+                    offset_us = Some(match a.spec.at {
+                        FaultAt::AtAccept => 0,
+                        FaultAt::Fraction(f) => (f * us as f64).floor() as u32,
+                        FaultAt::AfterUs(n) => n,
+                    });
+                }
+            }
+        }
+        // always before the end: the clamp only matters at clock rates below 1 MHz, where whole-cycle rounding could reach it
+        let cut_at = offset_us.map(|o| (self.now + self.cycles(o)).min(end - 1));
+        self.fault.journal = Some(Journal {
+            op,
+            ordinal: self.fault.ordinal,
+            started_at: self.now,
+            end,
+            cut_at,
+            ranges: pre.ranges,
+            before: pre.before,
+            unknown_before: pre.unknown_before,
+            if_completed,
+            unknown_if_completed,
+        });
+    }
+
+    /// The cycle in flight is interrupted: it never completes, its range becomes indeterminate, the chip is off until `power_restore()`. The array is not
+    /// touched here (see `sync_cut`).
+    fn fire_cut(&mut self, cut_at: u64, source: CutSource) {
+        let j = self.fault.journal.take().expect("a cut needs the journal of the running cycle");
+        self.busy = None;
+        let nth = if source == CutSource::Scheduled { self.fault.armed.map(|a| a.spec.nth) } else { None };
+        for &(lo, hi) in &j.ranges {
+            self.add_indet(lo, hi);
+        }
+        self.fault.last = Some(FaultRecord {
+            source,
+            op: j.op,
+            ordinal: j.ordinal,
+            nth,
+            started_at: j.started_at,
+            cut_at,
+            end_would_be_at: j.end,
+            detected_at: if source == CutSource::Scheduled { self.now } else { cut_at },
+            ranges: j.ranges,
+            before: j.before,
+            unknown_before: j.unknown_before,
+            if_completed: j.if_completed,
+            unknown_if_completed: j.unknown_if_completed,
+        });
+        self.fault.armed = None;
+        self.fault.powered_off = true;
+        self.fault.restore_pending = true;
+        self.fault.interrupted += 1;
+        self.fault.fired += 1;
+    }
+
+    // the indeterminate set: sorted, disjoint inclusive ranges kept beside (never inside) the array; same rules as the reference model
+    fn is_indet(&self, a: usize) -> bool {
+        for &(lo, hi) in &self.fault.indet {
+            if a < lo {
+                return false;
+            }
+            if a <= hi {
+                return true;
+            }
+        }
+        false
+    }
+    fn add_indet(&mut self, lo: usize, hi: usize) {
+        let mut all = self.fault.indet.clone();
+        all.push((lo, hi));
+        all.sort_by_key(|r| r.0);
+        let mut out: Vec<(usize, usize)> = Vec::new();
+        for r in all {
+            match out.last_mut() {
+                Some(last) if r.0 <= last.1 + 1 => last.1 = last.1.max(r.1),
+                _ => out.push(r),
+            }
+        }
+        self.fault.indet = out;
+    }
+    fn clear_indet(&mut self, lo: usize, hi: usize) {
+        let mut out: Vec<(usize, usize)> = Vec::new();
+        for &(l, h) in &self.fault.indet {
+            if h < lo || l > hi {
+                out.push((l, h));
+                continue;
+            }
+            if l < lo {
+                out.push((l, lo - 1));
+            }
+            if h > hi {
+                out.push((hi + 1, h));
+            }
+        }
+        self.fault.indet = out;
+    }
+
+    // ------------------------------------------------------------ time and status
+    fn settle(&mut self) {
+        if let Some(b) = self.busy {
+            // CUT PRECEDENCE: a scheduled cut is checked BEFORE completion, so a cycle whose cut time has passed can never complete,
+            // however late the chip is next touched (cut_at < end always holds: `fault_post` clamps it).
+            if let Some(c) = self.fault.journal.as_ref().and_then(|j| j.cut_at) {
+                if self.now >= c {
+                    self.fire_cut(c, CutSource::Scheduled);
+                    return;
+                }
+            }
+            if self.now >= b.end {
+                self.busy = None;
+                if b.kind == CycleKind::Wrsr {
+                    self.sr = b.next_sr;
+                    self.unknown = b.next_unknown;
+                }
+                if let Some((lo, hi)) = b.erase_range {
+                    if !self.fault.indet.is_empty() {
+                        self.clear_indet(lo, hi); // a complete erase makes its bytes known again (0xFF)
+                    }
+                }
+                self.fault.completed += 1;
+                self.fault.journal = None;
+                self.sr &= !(WEL | WIP); // completion resets WEL (both datasheets)
+                self.unknown &= !WEL;
+            }
+        }
+    }
+
+    /// (value, unknown mask) of the 16-bit status register at the current time.
+    pub fn status(&mut self) -> (u16, u16) {
+        self.settle();
+        let mut value = self.sr & !WIP;
+        let mut unknown = self.unknown;
+        if let Some(b) = self.busy {
+            value |= WIP;
+            unknown |= b.unknown_bits;
+            if self.kind == ChipKind::Uc25hq80 {
+                unknown |= WEL; // UC: WEL resets 'at some unspecified time before completion'
+            }
+        }
+        (value, unknown)
+    }
+
+    /// Is a program/erase/write-status cycle running at the current time?
+    pub fn wip(&mut self) -> bool {
+        self.settle();
+        self.busy.is_some()
+    }
+
+    /// Cycle count at which the running cycle ends, if any (introspection).
+    pub fn busy_until(&mut self) -> Option<u64> {
+        self.settle();
+        self.busy.map(|b| b.end)
+    }
+
+    /// The non-volatile status bits (SRP0/1, BP4-BP0, QE, LB3-1, CMP) as they will be once any running cycle ends, packed
+    /// `value | unknown << 16` (the unknown mask carries bits the datasheet leaves open). What survives a power cycle.
+    pub fn nv_status(&mut self) -> u32 {
+        self.settle();
+        let (mut sr, mut unk) = (self.sr, self.unknown);
+        if let Some(b) = self.busy {
+            if b.kind == CycleKind::Wrsr {
+                sr = b.next_sr; // a write-status cycle in progress is treated as completing (power loss mid-cycle is not modelled)
+                unk = b.next_unknown;
+            }
+        }
+        const NV: u16 = LOW_WRITABLE | HIGH_WRITABLE;
+        ((sr & NV) as u32) | (((unk & NV) as u32) << 16)
+    }
+
+    /// Power-on of a chip that kept `packed` (from `nv_status`) while off: the non-volatile bits are restored and the
+    /// power-up rules apply (WEL clear; SRP1:SRP0 = 1:0 returns to 0:0).
+    pub fn restore_nv(&mut self, packed: u32) {
+        const NV: u16 = LOW_WRITABLE | HIGH_WRITABLE;
+        self.busy = None;
+        self.fault.journal = None;
+        self.sr = (self.sr & !NV) | (packed as u16 & NV);
+        self.unknown = (self.unknown & !NV) | ((packed >> 16) as u16 & NV);
+        self.power_cycle();
+    }
+
+    /// Power off and on: WEL clears, SRP1:SRP0 = 1:0 returns to 0:0. Not allowed mid-cycle (that is
+    /// fault injection, not modelled): recorded and ignored.
+    pub fn power_cycle(&mut self) {
+        self.settle();
+        if self.fault.powered_off {
+            self.fault.refused += 1; // after a cut use power_restore() (the reference model throws fault.use-restore)
+            return;
+        }
+        if self.busy.is_some() {
+            self.event("nm.power-loss", false);
+            return;
+        }
+        self.sr &= !(WEL | WIP);
+        self.unknown &= !WEL;
+        if self.unknown & (SRP0 | SRP1) == 0 && self.sr & SRP1 != 0 && self.sr & SRP0 == 0 {
+            self.sr &= !SRP1;
+        }
+        self.cmd = Cmd::Ignore;
+        self.n = 0;
+    }
+
+    // ------------------------------------------------------------ the byte stream
+    /// CS# fell: a new transaction.
+    pub fn select(&mut self) {
+        self.cmd = Cmd::Ignore;
+        self.n = 0;
+        self.id_extra = false;
+        self.uid_counted = false;
+        self.indet_counted = false;
+    }
+
+    fn first_byte(&mut self, op: u8) {
+        self.settle();
+        self.hdr[0] = op;
+        const MODELED: [u8; 16] = [0x06, 0x04, 0x05, 0x35, 0x01, 0x02, 0x81, 0x20, 0x52, 0xd8, 0x60, 0xc7, 0x9f, 0x03, 0x0b, 0x4b];
+        if !MODELED.contains(&op) {
+            let id = match op {
+                0x15 | 0x31 if self.kind == ChipKind::Puya => "nm.puya-config-register",
+                0x50 => "nm.vwren",
+                0x25 => "nm.asi",
+                0x75 | 0xb0 | 0x7a | 0x30 => "nm.suspend-resume",
+                0xb9 | 0xab => "nm.deep-power-down",
+                0x66 | 0x99 => "nm.reset",
+                0x44 | 0x42 | 0x48 => "nm.security",
+                0x5a => "nm.unique-sfdp",
+                0x3b | 0xbb | 0x6b | 0xeb | 0xa2 | 0x32 => "nm.multi-io",
+                0x90 | 0x92 | 0x94 => "nm.electronic-id",
+                0x77 | 0xff => "nm.burst-wrap",
+                _ => "cmd.unknown",
+            };
+            self.event(id, false);
+            self.events.last_not_modeled = op;
+            self.cmd = Cmd::Ignore;
+            return;
+        }
+        if let Some(b) = self.busy {
+            self.cmd = match op {
+                0x05 => Cmd::Rdsr(0),
+                0x35 => Cmd::Rdsr(8),
+                0x9f => {
+                    if b.kind == CycleKind::Wrsr {
+                        self.unspec("id.rdid-busy-wrsr");
+                        Cmd::Ignore
+                    } else {
+                        Cmd::Ignore // not decoded, does not disturb the cycle (answers nothing)
+                    }
+                }
+                0x4b => {
+                    self.unspec("ruid.busy"); // not stated for RUID (UC states it for RDSFDP only)
+                    Cmd::Ignore
+                }
+                0x03 | 0x0b => Cmd::Ignore, // rejected without effect on the cycle
+                _ => {
+                    self.unspec("cmd.busy");
+                    Cmd::Ignore
+                }
+            };
+            return;
+        }
+        self.cmd = match op {
+            0x05 => Cmd::Rdsr(0),
+            0x35 => Cmd::Rdsr(8),
+            0x9f => Cmd::Rdid,
+            0x4b => Cmd::Ruid,
+            0x03 => Cmd::Read03,
+            0x0b => Cmd::Read0b,
+            _ => {
+                if op == 0x02 {
+                    self.used = [false; PAGE];
+                }
+                Cmd::Write(op)
+            }
+        };
+    }
+
+    /// One byte exchanged on MOSI; returns the byte on MISO. `mem` is the array (reads only).
+    pub fn transfer(&mut self, mem: &[u8], out: u8) -> u8 {
+        if self.fault.powered_off || self.fault.journal.is_some() {
+            self.settle(); // a due cut fires before anything else is answered
+            if self.fault.powered_off {
+                self.fault.off_accesses += 1; // a chip without power answers nothing
+                return 0xff;
+            }
+        }
+        let i = self.n;
+        self.n += 1;
+        if i == 0 {
+            self.first_byte(out);
+            return 0xff;
+        }
+        let k = i - 1;
+        match self.cmd {
+            Cmd::Ignore => 0xff,
+            Cmd::Rdsr(shift) => {
+                let (v, _) = self.status();
+                (v >> shift) as u8
+            }
+            Cmd::Ruid => {
+                if k < 3 {
+                    self.hdr[k + 1] = out; // dummy bytes 1-3 (the UC25HQ80's Table-7 lists 00H for them)
+                    0xff
+                } else if k == 3 {
+                    if self.kind == ChipKind::Uc25hq80 && (self.hdr[1] | self.hdr[2] | self.hdr[3]) != 0 {
+                        self.unspec("ruid.dummy-values"); // not stated for other values: refused
+                        self.cmd = Cmd::Ignore;
+                    }
+                    0xff // the fourth dummy byte
+                } else if k - 4 < 16 {
+                    match self.uid {
+                        Some(u) => u[k - 4],
+                        None => {
+                            if !self.uid_counted {
+                                self.uid_counted = true;
+                                self.events.uid_unknown_reads += 1; // no value is printed in the datasheets: 0xFF, unknown, counted
+                            }
+                            0xff
+                        }
+                    }
+                } else {
+                    if !self.id_extra {
+                        self.id_extra = true;
+                        self.unspec("ruid.beyond-128-bits");
+                    }
+                    0xff
+                }
+            }
+            Cmd::Rdid => {
+                if k < 3 {
+                    self.profile().jedec[k]
+                } else {
+                    if !self.id_extra {
+                        self.id_extra = true;
+                        self.unspec("id.rdid-extra-bytes");
+                    }
+                    0xff
+                }
+            }
+            Cmd::Read03 | Cmd::Read0b => {
+                let head = if self.cmd == Cmd::Read03 { 3 } else { 4 };
+                if k < 3 {
+                    self.hdr[k + 1] = out;
+                    0xff
+                } else if k < head {
+                    0xff // fast-read dummy byte
+                } else {
+                    let start = ((self.hdr[1] as usize) << 16) | ((self.hdr[2] as usize) << 8) | self.hdr[3] as usize;
+                    let a = (start + (k - head)) % BYTES;
+                    if !self.fault.indet.is_empty() && !self.indet_counted && self.is_indet(a) {
+                        self.indet_counted = true;
+                        self.fault.indet_reads += 1; // the byte returned is whatever the array holds: it is unknown, and the read is counted
+                    }
+                    mem[a]
+                }
+            }
+            Cmd::Write(op) => {
+                if i < 4 {
+                    self.hdr[i] = out;
+                } else if op == 0x02 {
+                    let o = (self.hdr[3] as usize + (i - 4)) & 0xff;
+                    self.latch[o] = out;
+                    self.used[o] = true;
+                }
+                0xff
+            }
+        }
+    }
+
+    // ------------------------------------------------------------ CS rises: commands execute
+    /// CS# rose, `partial_bits` clocks (0..=7) after the last whole byte (always 0 on the SoC's
+    /// byte-wide SPI0). Returns the flash range an erase/program changed, if any.
+    pub fn release(&mut self, mem: &mut [u8], partial_bits: u8) -> Option<(usize, usize)> {
+        let n = self.n;
+        let cmd = self.cmd;
+        self.n = 0;
+        self.cmd = Cmd::Ignore;
+        if n == 0 {
+            return None;
+        }
+        self.settle();
+        if self.fault.powered_off {
+            return None; // a cut fired while the command was being clocked in: nothing executes
+        }
+        match cmd {
+            Cmd::Ignore | Cmd::Rdsr(_) | Cmd::Rdid => None,
+            Cmd::Ruid => {
+                if n < 5 {
+                    self.unspec("ruid.malformed"); // CS# rose before the four dummy bytes were complete
+                }
+                None
+            }
+            Cmd::Read03 | Cmd::Read0b => {
+                let need = if cmd == Cmd::Read03 { 4 } else { 5 };
+                if n < need {
+                    self.unspec("read.malformed");
+                } else if (((self.hdr[1] as usize) << 16) | ((self.hdr[2] as usize) << 8) | self.hdr[3] as usize) >= BYTES {
+                    self.unspec("addr.range");
+                }
+                None
+            }
+            Cmd::Write(op) => self.execute(mem, op, n, partial_bits),
+        }
+    }
+
+    fn addr(&self) -> usize { ((self.hdr[1] as usize) << 16) | ((self.hdr[2] as usize) << 8) | self.hdr[3] as usize }
+
+    fn start(&mut self, kind: CycleKind, us: u32, next_sr: u16, next_unknown: u16, unknown_bits: u16) {
+        self.fault.accepted += 1;
+        self.fault.ordinal += 1;
+        self.busy = Some(Busy { end: self.now + self.cycles(us), kind, next_sr, next_unknown, unknown_bits, erase_range: None, in_scope: false });
+    }
+    fn us(&self) -> &'static crate::spichip_tables::TimingUs {
+        let p = self.profile();
+        match self.timing {
+            Timing::Typical => &p.typical,
+            Timing::Maximum => &p.maximum,
+        }
+    }
+
+    /// The write-enable latch, or None (event recorded) when its value is open.
+    fn wel_set(&mut self) -> Option<bool> {
+        if self.unknown & WEL != 0 {
+            self.unspec("wel.after-rejected");
+            return None;
+        }
+        Some(self.sr & WEL != 0)
+    }
+    fn rejected_boundary(&mut self, name: &str, partial: u8) {
+        if !(self.kind == ChipKind::Uc25hq80 && name == "pp" && partial != 0) {
+            self.unknown |= WEL; // not stated by the datasheets: open
+        }
+    }
+    fn ignored_protected(&mut self, name: &str) {
+        if self.kind == ChipKind::Puya && name == "be32" {
+            self.sr &= !WEL; // Puya p37: 'the WEL bit will be reset'
+        } else {
+            self.unknown |= WEL;
+        }
+    }
+
+    /// The protected range for the current BP/CMP, Err when those bits are open.
+    fn protected_range(&mut self) -> Result<Option<(u32, u32)>, ()> {
+        if self.unknown & (BP | CMP) != 0 {
+            self.unspec("prot.table");
+            return Err(());
+        }
+        let bp = [BP4, BP3, BP2, BP1, BP0].map(|b| (self.sr & b != 0) as i8);
+        let p = self.profile();
+        let rows: &[Row] = if self.sr & CMP != 0 { p.cmp1 } else { p.cmp0 };
+        let row = rows.iter().find(|r| r.pat.iter().zip(bp.iter()).all(|(c, b)| *c == -1 || c == b));
+        Ok(row.expect("protection table covers every BP combination").range)
+    }
+    fn overlaps_protected(&mut self, lo: usize, hi: usize) -> Result<bool, ()> {
+        Ok(self.protected_range()?.is_some_and(|(plo, phi)| lo as u32 <= phi && hi as u32 >= plo))
+    }
+
+    fn execute(&mut self, mem: &mut [u8], op: u8, n: usize, partial: u8) -> Option<(usize, usize)> {
+        match op {
+            0x06 | 0x04 => {
+                if n != 1 {
+                    self.unspec("cmd.extra-bytes");
+                    return None;
+                }
+                if partial != 0 {
+                    return None; // rejected: 'not executed' read as no state change
+                }
+                if op == 0x06 { self.sr |= WEL } else { self.sr &= !WEL }
+                self.unknown &= !WEL;
+                None
+            }
+            0x02 => self.page_program(mem, n, partial),
+            0x01 => {
+                self.wrsr(n, partial);
+                None
+            }
+            0x60 | 0xc7 => self.chip_erase(mem, n, partial),
+            _ => self.erase(mem, op, n, partial), // 81h 20h 52h D8h
+        }
+    }
+
+    fn page_program(&mut self, mem: &mut [u8], n: usize, partial: u8) -> Option<(usize, usize)> {
+        match self.wel_set() {
+            None | Some(false) => return None, // open WEL (event) or ignored without WEL
+            Some(true) => {}
+        }
+        if n < 5 {
+            self.unspec("pp.min-one-byte");
+            return None;
+        }
+        if partial != 0 {
+            self.rejected_boundary("pp", partial);
+            return None;
+        }
+        let addr = self.addr();
+        if addr >= BYTES {
+            self.unspec("addr.range");
+            return None;
+        }
+        let page = addr - addr % PAGE;
+        match self.overlaps_protected(page, page + PAGE - 1) {
+            Err(()) => return None,
+            Ok(true) => {
+                self.ignored_protected("pp");
+                return None;
+            }
+            Ok(false) => {}
+        }
+        let pre = if self.fault.journaling {
+            let runs = self.program_runs(page);
+            Some(self.fault_pre(mem, runs))
+        } else {
+            None
+        };
+        let (mut lo, mut hi) = (PAGE, 0);
+        for o in 0..PAGE {
+            if self.used[o] {
+                mem[page + o] &= self.latch[o];
+                lo = lo.min(o);
+                hi = hi.max(o + 1);
+            }
+        }
+        let us = self.us().pp;
+        self.start(CycleKind::Program, us, 0, 0, 0);
+        self.busy.as_mut().unwrap().in_scope = true;
+        self.fault_post(mem, FaultOp::Program, us, pre);
+        Some((page + lo, page + hi))
+    }
+
+    fn erase(&mut self, mem: &mut [u8], op: u8, n: usize, partial: u8) -> Option<(usize, usize)> {
+        let (name, size) = match op {
+            0x81 => ("pe", PAGE),
+            0x20 => ("se", 4096),
+            0x52 => ("be32", 32768),
+            _ => ("be64", 65536),
+        };
+        match self.wel_set() {
+            None | Some(false) => return None,
+            Some(true) => {}
+        }
+        if partial != 0 || n != 4 {
+            self.rejected_boundary(name, partial);
+            return None;
+        }
+        let addr = self.addr();
+        if addr >= BYTES {
+            self.unspec("addr.range");
+            return None;
+        }
+        let lo = addr - addr % size;
+        let hi = lo + size - 1;
+        match self.overlaps_protected(lo, hi) {
+            Err(()) => return None,
+            Ok(true) => {
+                self.ignored_protected(name);
+                return None;
+            }
+            Ok(false) => {}
+        }
+        let cycle_op = match op {
+            0x20 => Some(FaultOp::Erase4k),
+            0x52 => Some(FaultOp::Erase32k),
+            0xd8 => Some(FaultOp::Erase64k),
+            _ => None, // 81h page erase is out of scope
+        };
+        let pre = if cycle_op.is_some() && self.fault.journaling { Some(self.fault_pre(mem, vec![(lo, hi)])) } else { None };
+        mem[lo..=hi].fill(0xff);
+        let t = self.us();
+        let us = match op {
+            0x81 => t.pe,
+            0x20 => t.se,
+            0x52 => t.be32,
+            _ => t.be64,
+        };
+        self.start(CycleKind::Erase, us, 0, 0, 0);
+        self.busy.as_mut().unwrap().erase_range = Some((lo, hi));
+        if let Some(c) = cycle_op {
+            self.busy.as_mut().unwrap().in_scope = true;
+            self.fault_post(mem, c, us, pre);
+        }
+        Some((lo, hi + 1))
+    }
+
+    fn chip_erase(&mut self, mem: &mut [u8], n: usize, partial: u8) -> Option<(usize, usize)> {
+        match self.wel_set() {
+            None | Some(false) => return None,
+            Some(true) => {}
+        }
+        if partial != 0 || n != 1 {
+            self.rejected_boundary("ce", partial);
+            return None;
+        }
+        let Ok(range) = self.protected_range() else { return None };
+        let nothing = range.is_none();
+        let run = if self.kind == ChipKind::Puya {
+            nothing // Puya p24/p38: one rule, all 64 combinations decided
+        } else {
+            let bp_zero = self.sr & BP == 0;
+            if bp_zero != nothing {
+                self.unspec("prot.chip-erase-conflict"); // UC25HQ80's own statements disagree
+                return None;
+            }
+            bp_zero
+        };
+        if !run {
+            self.ignored_protected("ce");
+            return None;
+        }
+        let pre = if self.fault.journaling { Some(self.fault_pre(mem, vec![(0, BYTES - 1)])) } else { None };
+        mem.fill(0xff);
+        let us = self.us().ce;
+        self.start(CycleKind::Erase, us, 0, 0, 0);
+        self.busy.as_mut().unwrap().erase_range = Some((0, BYTES - 1));
+        self.busy.as_mut().unwrap().in_scope = true;
+        self.fault_post(mem, FaultOp::ChipErase, us, pre);
+        Some((0, BYTES))
+    }
+
+    fn wrsr(&mut self, n: usize, partial: u8) {
+        match self.wel_set() {
+            None | Some(false) => return,
+            Some(true) => {}
+        }
+        let data = n - 1;
+        if partial != 0 || (data != 1 && data != 2) {
+            self.rejected_boundary("wrsr", partial);
+            return;
+        }
+        if self.unknown & (SRP0 | SRP1) != 0 {
+            self.unspec("wrsr.hw-protection");
+            return;
+        }
+        let srp = (if self.sr & SRP1 != 0 { 2 } else { 0 }) | (if self.sr & SRP0 != 0 { 1 } else { 0 });
+        if srp == 3 {
+            self.unspec("srp.otp");
+            return;
+        }
+        if srp == 2 || (srp == 1 && !self.wp) {
+            self.unknown |= WEL; // hardware/lock-down protected: not executed, WEL not stated
+            return;
+        }
+        let old = self.sr;
+        let mut next = (old & !LOW_WRITABLE) | (self.hdr[1] as u16 & LOW_WRITABLE);
+        let mut unknown_after = self.unknown;
+        if data == 2 {
+            let hi = ((self.hdr[2] as u16) << 8) & HIGH_WRITABLE;
+            next = (next & !HIGH_WRITABLE) | (hi & !LB) | (old & LB) | (hi & LB); // LB bits only go 0 -> 1
+        } else if self.kind == ChipKind::Puya {
+            next &= !ONE_BYTE_CLEARS; // Puya p26
+        } else {
+            unknown_after |= HIGH_WRITABLE; // UC: not stated
+        }
+        let in_flux = ((old ^ next) & (LOW_WRITABLE | HIGH_WRITABLE)) | (unknown_after & !self.unknown);
+        let us = self.us().wrsr;
+        self.start(CycleKind::Wrsr, us, next, unknown_after, in_flux);
+    }
+}
