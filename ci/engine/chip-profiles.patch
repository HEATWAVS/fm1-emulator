+/// Interrupted-operation chip state (Component 5, Stage 5C-1). Literal expectations were computed independently of the code under test
+/// (pattern bytes and hashes with a separate script; cycle arithmetic by hand at 100 MHz = 100 cycles per microsecond).
+#[cfg(test)]
+mod fault_tests {
+    use super::*;
+    use crate::spichip_tables::{PUYA, UC25HQ80};
+
+    const HZ: u64 = 100_000_000;
+    const CPU: u64 = HZ / 1_000_000; // cycles per microsecond
+    const PROFILES: [ChipKind; 2] = [ChipKind::Puya, ChipKind::Uc25hq80];
+    const TIMINGS: [Timing; 2] = [Timing::Typical, Timing::Maximum];
+    const CUTS: [FaultOp; 5] = [FaultOp::Program, FaultOp::Erase4k, FaultOp::Erase32k, FaultOp::Erase64k, FaultOp::ChipErase];
+
+    fn pat(i: usize) -> u8 { (((i * 131 + (i >> 8) * 17) ^ 0x5a) & 0xff) as u8 }
+    fn pattern() -> Vec<u8> { (0..BYTES).map(pat).collect() }
+    fn fnv(a: &[u8]) -> u32 {
+        let mut h: u32 = 0x811c9dc5;
+        for &b in a {
+            h ^= b as u32;
+            h = h.wrapping_mul(0x01000193);
+        }
+        h
+    }
+
+    struct Rig {
+        c: Chip,
+        mem: Vec<u8>,
+    }
+    impl Rig {
+        fn new(kind: ChipKind, timing: Timing, patterned: bool) -> Rig {
+            let mut c = Chip::new(kind, timing);
+            c.set_clock(0, HZ);
+            Rig { c, mem: if patterned { pattern() } else { vec![0xff; BYTES] } }
+        }
+        /// time passes and NOTHING touches the chip
+        fn clock(&mut self, us: u64) { self.c.set_clock(us * CPU, HZ); }
+        fn clock_cycles(&mut self, cycles: u64) { self.c.set_clock(cycles, HZ); }
+        fn xfer(&mut self, tx: &[u8], read: usize) -> Vec<u8> {
+            self.c.select();
+            for &b in tx {
+                self.c.transfer(&self.mem, b);
+            }
+            let out = (0..read).map(|_| self.c.transfer(&self.mem, 0)).collect();
+            self.c.release(&mut self.mem, 0);
+            self.c.sync_cut(&mut self.mem);
+            out
+        }
+        fn wren(&mut self) { self.xfer(&[0x06], 0); }
+        fn program(&mut self, addr: u32, data: &[u8]) {
+            self.wren();
+            let mut tx = vec![0x02, (addr >> 16) as u8, (addr >> 8) as u8, addr as u8];
+            tx.extend_from_slice(data);
+            self.xfer(&tx, 0);
+        }
+        fn erase(&mut self, op: u8, addr: u32) {
+            self.wren();
+            self.xfer(&[op, (addr >> 16) as u8, (addr >> 8) as u8, addr as u8], 0);
+        }
+        fn chip_erase(&mut self) {
+            self.wren();
+            self.xfer(&[0x60], 0);
+        }
+        fn read(&mut self, addr: u32, n: usize) -> Vec<u8> { self.xfer(&[0x03, (addr >> 16) as u8, (addr >> 8) as u8, addr as u8], n) }
+        fn rdsr(&mut self) -> u8 { self.xfer(&[0x05], 1)[0] }
+        /// accept one in-scope cycle of kind `op` at its canonical address; returns the ranges it puts at risk
+        fn accept(&mut self, op: FaultOp) -> Vec<(usize, usize)> {
+            match op {
+                FaultOp::Program => {
+                    self.program(0x1005, &[0x0f, 0xf0, 0x55, 0xaa]);
+                    vec![(0x1005, 0x1008)]
+                }
+                FaultOp::Erase4k => {
+                    self.erase(0x20, 0x2000);
+                    vec![(0x2000, 0x2fff)]
+                }
+                FaultOp::Erase32k => {
+                    self.erase(0x52, 0x8000);
+                    vec![(0x8000, 0xffff)]
+                }
+                FaultOp::Erase64k => {
+                    self.erase(0xd8, 0x10000);
+                    vec![(0x10000, 0x1ffff)]
+                }
+                FaultOp::ChipErase => {
+                    self.chip_erase();
+                    vec![(0, BYTES - 1)]
+                }
+                _ => unreachable!(),
+            }
+        }
+        fn state(&mut self) -> FaultState { self.c.fault_state() }
+    }
+
+    fn dur_us(kind: ChipKind, timing: Timing, op: FaultOp) -> u32 {
+        let p = if kind == ChipKind::Puya { &PUYA } else { &UC25HQ80 };
+        let t = if timing == Timing::Typical { &p.typical } else { &p.maximum };
+        match op {
+            FaultOp::Program => t.pp,
+            FaultOp::Erase4k => t.se,
+            FaultOp::Erase32k => t.be32,
+            FaultOp::Erase64k => t.be64,
+            FaultOp::ChipErase => t.ce,
+            _ => unreachable!(),
+        }
+    }
+    /// every trigger form, with the offset in whole microseconds it must produce for a cycle of `d` microseconds
+    fn triggers(d: u32) -> Vec<(FaultAt, u32)> {
+        vec![
+            (FaultAt::AtAccept, 0),
+            (FaultAt::Fraction(0.0), 0),
+            (FaultAt::Fraction(0.25), (0.25 * d as f64).floor() as u32),
+            (FaultAt::Fraction(0.5), d / 2),
+            (FaultAt::Fraction(0.99), (0.99 * d as f64).floor() as u32),
+            (FaultAt::Fraction(1.0 / 3.0), (d as f64 / 3.0).floor() as u32),
+            (FaultAt::Fraction(0.999), (0.999 * d as f64).floor() as u32),
+            (FaultAt::AfterUs(1), 1),
+            (FaultAt::AfterUs(d - 1), d - 1),
+        ]
+    }
+    const T0: u64 = 1000; // microseconds at which the cycle is accepted
+
+    // ------------------------------------------------------------------ precedence and timing
+
+    /// The case requirement 1 names: the clock moves far past the end of the cycle and nothing touches the chip until afterwards.
+    /// The cut must have happened, completion must not have. Control: the same run without a trigger completes.
+    #[test]
+    fn a_due_cut_beats_completion_even_with_no_access_until_long_after() {
+        for kind in PROFILES {
+            for timing in TIMINGS {
+                for op in CUTS {
+                    let d = dur_us(kind, timing, op);
+                    for (at, off) in triggers(d) {
+                        let tag = format!("{kind:?} {timing:?} {op:?} {at:?}");
+                        let mut r = Rig::new(kind, timing, false);
+                        r.c.arm_fault(FaultSpec { op, nth: 1, at }).unwrap();
+                        r.clock(T0);
+                        let ranges = r.accept(op);
+                        r.clock(T0 + d as u64 + 5000); // far beyond the end; no chip access in between
+                        let st = r.state();
+                        assert!(st.powered_off, "{tag}: cut must have fired");
+                        assert_eq!((st.accepted, st.completed, st.interrupted, st.fired), (1, 0, 1, 1), "{tag}");
+                        let rec = st.last.as_ref().expect("record");
+                        assert_eq!(rec.source, CutSource::Scheduled, "{tag}");
+                        assert_eq!(rec.op, op, "{tag}");
+                        assert_eq!((rec.ordinal, rec.nth), (1, Some(1)), "{tag}");
+                        assert_eq!(rec.started_at, T0 * CPU, "{tag}");
+                        assert_eq!(rec.cut_at, (T0 + off as u64) * CPU, "{tag}: cut time");
+                        assert_eq!(rec.end_would_be_at, (T0 + d as u64) * CPU, "{tag}");
+                        // a cut due at the accept itself is noticed by the very next look (the transaction's own release); every other cut is noticed late, at the first look
+                        // after the clock jump, and recorded at ITS OWN time (cut_at), not the time it was noticed
+                        let noticed = if off == 0 { T0 } else { T0 + d as u64 + 5000 };
+                        assert_eq!(rec.detected_at, noticed * CPU, "{tag}: when it was noticed");
+                        assert!(rec.cut_at < rec.end_would_be_at, "{tag}");
+                        assert_eq!(rec.ranges, ranges, "{tag}");
+                        assert_eq!(st.indeterminate, ranges, "{tag}: the range is indeterminate");
+                        assert_eq!(r.c.busy_until(), None, "{tag}: no cycle is running");
+                        // CONTROL: no trigger, the same moves: the cycle completes normally
+                        let mut k = Rig::new(kind, timing, false);
+                        k.clock(T0);
+                        k.accept(op);
+                        k.clock(T0 + d as u64 + 5000);
+                        let ks = k.state();
+                        assert_eq!((ks.accepted, ks.completed, ks.interrupted, ks.powered_off), (1, 1, 0, false), "{tag}: control completes");
+                        assert!(ks.indeterminate.is_empty() && ks.last.is_none(), "{tag}: control leaves nothing indeterminate");
+                    }
+                }
+            }
+        }
+    }
