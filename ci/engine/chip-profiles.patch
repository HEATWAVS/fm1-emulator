+    /// At a very low clock whole-cycle rounding could put the cut on the cycle the cycle ends: the cut is clamped to the cycle before it, so completion can never win.
+    /// (At the SoC's 100 MHz this cannot happen; the clamp exists for correctness at any `hz`.)
+    #[test]
+    fn the_cut_stays_before_the_end_even_at_a_very_low_clock() {
+        let hz = 1000; // 1 kHz: a microsecond is a millisecond's worth of rounding
+        let mut c = Chip::new(ChipKind::Puya, Timing::Typical);
+        let mut mem = vec![0xffu8; BYTES];
+        c.set_clock(0, hz);
+        c.arm_fault(FaultSpec { op: FaultOp::Program, nth: 1, at: FaultAt::AfterUs(PUYA.typical.pp - 1) }).unwrap();
+        for tx in [&[0x06][..], &[0x02, 0, 0x10, 0, 0x55][..]] {
+            c.select();
+            for &b in tx {
+                c.transfer(&mem, b);
+            }
+            c.release(&mut mem, 0);
+        }
+        // the program takes 2000 us = 2 cycles at 1 kHz; afterUs(1999) rounds up to 2 cycles = the end: the clamp makes it cycle 1
+        assert_eq!(c.busy_until(), Some(2));
+        c.set_clock(1, hz);
+        let st = c.fault_state();
+        assert!(st.powered_off, "cut at cycle 1, before the end at cycle 2");
+        assert_eq!((st.last.as_ref().unwrap().cut_at, st.last.as_ref().unwrap().end_would_be_at, st.completed), (1, 2, 0));
+    }
