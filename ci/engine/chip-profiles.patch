+        assert_eq!(rec.unknown_if_completed, vec![1, 1, 0, 0], "the result of programming an unknown byte is unknown");
+        assert_eq!(rec.if_completed, vec![0, 0, pat(0x1009) & 0x0f, pat(0x100a) & 0xf0]);
