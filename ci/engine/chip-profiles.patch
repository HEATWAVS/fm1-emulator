+}
+/// Chip events: which = 0 commands ignored as unspecified by the datasheet, 1 opcodes outside the model.
+#[no_mangle]
+pub extern "C" fn fm1_flash_events(which: u32) -> u32 {
+    machine().and_then(|m| m.soc.flash.chip.as_ref()).map_or(0, |c| match which {
+        0 => c.events.unspecified,
+        1 => c.events.not_modeled,
+        2 => c.events.last_not_modeled as u32, // the most recent opcode counted in 1
+        3 => c.events.uid_unknown_reads,       // 4Bh reads answered without a unique-ID fixture
+        _ => 0,
+    })
+}
+/// Configure the chip's 128-bit unique ID, the 16 bytes 4Bh transmits (w0 = bytes 0-3 with byte 0 in the top byte, ..., w3 = bytes 12-15). A caller-supplied
+/// fixture: the value is per device and in neither datasheet. Needs a chip profile; survives power cycles. Returns 0, or 1 without a profile.
+#[no_mangle]
+pub extern "C" fn fm1_flash_uid_set(w0: u32, w1: u32, w2: u32, w3: u32) -> u32 {
+    machine().and_then(|m| m.soc.flash.chip.as_mut()).map_or(1, |c| {
+        let mut u = [0u8; 16];
+        for (i, w) in [w0, w1, w2, w3].iter().enumerate() {
+            u[4 * i..4 * i + 4].copy_from_slice(&w.to_be_bytes());
+        }
+        c.set_uid(Some(u));
+        0
+    })
+}
+/// Remove the unique-ID fixture (4Bh then answers 0xFF and counts the read as unknown). Returns 0, or 1 without a profile.
+#[no_mangle]
+pub extern "C" fn fm1_flash_uid_clear() -> u32 {
+    machine().and_then(|m| m.soc.flash.chip.as_mut()).map_or(1, |c| {
+        c.set_uid(None);
+        0
+    })
+}
+/// The chip's non-volatile status bits (value | unknown mask << 16): what it keeps while the unit is off. 0 without a chip profile.
+#[no_mangle]
+pub extern "C" fn fm1_flash_nv_status() -> u32 {
+    machine().map_or(0, |m| {
+        let (c, hz) = (m.soc.periph.cycles, m.soc.periph.hz);
+        m.soc.flash.chip.as_mut().map_or(0, |chip| {
+            chip.set_clock(c, hz);
+            chip.nv_status()
+        })
+    })
+}
+/// Power-on of a chip that kept `packed` (from fm1_flash_nv_status) while off. Returns 0, or 1 without a chip profile.
+#[no_mangle]
+pub extern "C" fn fm1_flash_nv_restore(packed: u32) -> u32 {
+    machine().and_then(|m| m.soc.flash.chip.as_mut()).map_or(1, |chip| {
+        chip.restore_nv(packed);
+        0
+    })
+}
