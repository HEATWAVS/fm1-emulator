+        r.clock(T0 + 5 + p + 1);
+        assert_eq!(r.state().indeterminate, &[(0x1005, 0x1008)], "a completed program leaves the range indeterminate");
+        let se = dur_us(ChipKind::Puya, Timing::Typical, FaultOp::Erase4k) as u64;
