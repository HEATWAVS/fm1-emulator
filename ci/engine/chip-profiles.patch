+    /// An idle instruction jumps to just before the next event; with the cut as an event the jump ends at it, and without the idle skip the result is the same.
+    #[test]
+    fn an_idle_skip_stops_at_the_cut_cycle() {
+        const AFTER: u64 = 100_000;
+        let code = [[0x01u8, 0x00].as_slice(), &[0x60, 0xff, 0x00, 0x20, 0xfc, 0xff]].concat(); // idle; goto idle
+        let mut cycles_seen = Vec::new();
