+    // ------------------------------------------------------------------ determinism and disabled behaviour
+
+    fn scripted(r: &mut Rig) -> (u32, u32, Vec<u8>, u64) {
+        let mut t = 100u64;
+        let mut seq = Vec::new();
+        r.clock(t);
+        for step in 0..14u32 {
+            let a = 0x1000 * (step + 1);
+            match step % 5 {
+                0 => r.program(a, &[0xa5, 0x5a, step as u8]),
+                1 => r.erase(0x20, a),
+                2 => r.erase(0x52, a & !0x7fff),
+                3 => r.erase(0xd8, a & !0xffff),
+                _ => r.erase(0x81, a),
+            }
+            seq.push(r.rdsr());
+            t += 3_000;
+            r.clock(t);
+            seq.push(r.rdsr());
+            t += 2_000_000;
+            r.clock(t);
+            r.xfer(&[0x35], 1);
+            seq.extend(r.read(a, 3));
+        }
+        let st = r.state();
+        (fnv(&r.mem), st.completed, seq, r.c.busy_until().unwrap_or(0))
+    }
+
+    /// Normal-operation regression: with fault injection never armed, with it armed and never matching, and with journaling on but nothing armed, a long scripted run
+    /// of programs and erases (including 81h) yields byte-identical results: array, status reads, reads, counters. (The oracle transcripts, which are unchanged, are
+    /// the wider regression against the reference model.)
+    #[test]
+    fn disabled_fault_injection_changes_nothing() {
+        for kind in PROFILES {
+            let mut plain = Rig::new(kind, Timing::Typical, true);
+            let want = scripted(&mut plain);
+            assert!(!plain.state().journaling && plain.state().last.is_none());
+            assert_eq!(plain.state().completed, 14, "{kind:?}: every cycle completed");
+
+            let mut journaling = Rig::new(kind, Timing::Typical, true);
+            journaling.c.set_fault_injection(true);
+            assert_eq!(scripted(&mut journaling), want, "{kind:?}: journaling on, nothing armed");
+
+            let mut never = Rig::new(kind, Timing::Typical, true);
+            never.c.arm_fault(FaultSpec { op: FaultOp::ChipErase, nth: 1, at: FaultAt::AtAccept }).unwrap(); // no chip erase in the script
+            assert_eq!(scripted(&mut never), want, "{kind:?}: armed, never matching");
+            assert_eq!(never.state().armed.unwrap().1, 0);
+
+            let mut disarmed = Rig::new(kind, Timing::Typical, true);
+            disarmed.c.arm_fault(FaultSpec { op: FaultOp::Program, nth: 1, at: FaultAt::AtAccept }).unwrap();
+            disarmed.c.disarm_fault();
+            assert_eq!(scripted(&mut disarmed), want, "{kind:?}: armed then disarmed");
+        }
+    }
