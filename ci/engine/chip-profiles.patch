+    // ================================================================================================================ Component 5, Stage 5C-2: the flash power cut as a SoC event
+    // A program is accepted at cycle `T0` with a cut `after` cycles later. The cut is an input of `Periph::next_event()`, so everything that already stops at a timed event
+    // (the interpreter, the JIT, idle skips, loop skips, the bulk advance) stops at it. D33 (the array changes at accept) means the window shows the completed word between the
+    // accept and the cut; the cut puts the pre-image (erased, 0xFF) back. A program that wrote 0x78563412 over 0xFFFFFFFF is the marker.
+    use crate::spichip::{ChipKind, FaultAt, FaultError, FaultOp, FaultSpec, Timing};
+    use crate::XIP_FLASH_OFFSET;
+
+    const FCS: u32 = 0x500c0;
+    const FSPI: u32 = 0x11c00;
+    /// inside the xip Vec the machine resizes to (Region::Xip, what instruction fetch and the JIT read)
+    const XIP_IDX: usize = 0x1000;
+    /// past the xip Vec: Region::XipFlash reads the chip's array directly
+    const FLASH_IDX: usize = 0x10000;
+    const T0: u64 = 5_000;
+    const DATA: [u8; 4] = [0x12, 0x34, 0x56, 0x78];
+    const COMPLETED: u32 = 0x7856_3412;
+    const PRE_IMAGE: u32 = 0xffff_ffff;
+
+    fn spi(soc: &mut Soc, bytes: &[u8]) {
+        soc.write32(FCS, 0);
+        for &b in bytes {
+            soc.write32(FSPI, 0);
+            soc.write32(FSPI + 8, b as u32);
+        }
+        soc.write32(FCS, 1);
+    }
+
+    fn program(soc: &mut Soc, idx: usize) {
+        let a = XIP_FLASH_OFFSET + idx;
+        spi(soc, &[0x06]);
+        spi(soc, &[0x02, (a >> 16) as u8, (a >> 8) as u8, a as u8, DATA[0], DATA[1], DATA[2], DATA[3]]);
+    }
+
+    /// What every path a reader has shows at `idx`: (Bus::read32, Bus::fetch32, the raw xip word if the Vec holds it, the chip's array byte).
+    fn views(soc: &mut Soc, idx: usize) -> (u32, u32, Option<u32>, u8) {
+        let raw = soc.xip.get(idx..idx + 4).map(|b| u32::from_le_bytes(b.try_into().unwrap()));
+        (soc.read32(XIP_BASE + idx as u32), soc.fetch32(XIP_BASE + idx as u32), raw, soc.flash.mem[XIP_FLASH_OFFSET + idx])
+    }
+
+    /// A machine with a Puya chip and an erased XIP page, the program accepted at `T0`, a cut `after` cycles later (`None`: nothing armed).
+    fn cut_machine(code: &[u8], regs: &[(usize, u32)], skip: bool, jit: bool, after: Option<u64>, idx: usize) -> (Cpu, Soc) {
+        let (mut cpu, mut soc) = machine(code, regs, skip);
+        cpu.jit_on = jit;
+        soc.xip.resize(0x2000, 0xff);
+        for b in &mut soc.xip[code.len()..] {
+            *b = 0xff; // the window beyond the code is erased flash
+        }
+        soc.flash.set_chip(Some((ChipKind::Puya, Timing::Typical)));
+        if let Some(n) = after {
+            soc.arm_flash_fault(FaultSpec { op: FaultOp::Program, nth: 1, at: FaultAt::AfterCycles(n) }).unwrap();
+        }
+        soc.periph.cycles = T0;
+        soc.periph.next_due = 0;
+        program(&mut soc, idx);
+        (cpu, soc)
+    }
+
+    /// run until the machine stops, in chunks of the given sizes (cycled); returns the error text and the state at the stop
+    fn run_to_the_end(cpu: &mut Cpu, soc: &mut Soc, chunks: &[u32]) -> (String, u32, [u32; 16], u64, u64) {
+        let mut t = false;
+        let mut i = 0;
+        let mut total = 0u64;
+        loop {
+            let n = chunks[i % chunks.len()];
+            i += 1;
+            match run_blocks(cpu, soc, n, &mut t) {
+                Ok(k) => total += k as u64,
+                Err(e) => return (e, cpu.pc, cpu.regs, cpu.insn_count, soc.periph.cycles),
+            }
+            assert!(total < 20_000_000, "the machine never stopped");
+        }
+    }
+
+    const SPIN: [u8; 6] = [0x60, 0xff, 0x00, 0x20, 0xfd, 0xff];
+
+    /// A polling loop the loop skip takes (it stores what is already there, reads a pin that stays up): [0x1000] = r3; r2 = [PA_IN]; while bit 5 is set.
+    fn poll_code() -> (Vec<u8>, Vec<(usize, u32)>) {
+        (
+            [STORE.as_slice(), &LOAD, &while_set(8)].concat(),
+            vec![(1, PA_IN + 544), (5, RAM_BASE + 0x1000 + 128), (3, 0xdead_beef)],
+        )
+    }
+
+    // ---------------------------------------------------------------- execution paths
+
+    /// Normal execution, the JIT, the loop skip and both together, in one big call and in uneven chunks: the machine stops at the scheduled cycle, with the same core state,
+    /// the same instruction count and the same clock every time; and the record carries the requested deadline and the actual firing cycle.
+    #[test]
+    fn a_scheduled_cut_stops_every_execution_path_at_its_exact_cycle() {
+        const AFTER: u64 = 100_000;
+        let d = T0 + AFTER;
+        let (code, regs) = poll_code();
+        let mut first = None;
+        let chunkings: [&[u32]; 4] = [&[5_000_000], &[1024, 2048, 1500, 3001, 1111], &[100_000, 50_000], &[1]];
+        for (ci, chunks) in chunkings.iter().enumerate() {
+            for (skip, jit) in [(false, false), (false, true), (true, false), (true, true)] {
+                if chunks == &[1u32] && (skip || jit) {
+                    continue; // one instruction a call: the skip's probe needs 1024 left, the JIT blocks of more
+                }
+                let tag = format!("chunking {ci} skip {skip} jit {jit}");
+                let (mut cpu, mut soc) = cut_machine(&code, &regs, skip, jit, Some(AFTER), XIP_IDX);
+                assert_eq!(soc.flash.cut_deadline(), Some(d), "{tag}: the chip's deadline");
+                assert_eq!(soc.periph.flash_cut_at, d, "{tag}: the SoC took it as an event");
+                let (err, pc, regs_at_stop, insns, cycles) = run_to_the_end(&mut cpu, &mut soc, chunks);
+                assert_eq!(err, POWER_CUT, "{tag}: a power cut is its own stop, not a CPU fault text");
+                assert!(soc.power_cut, "{tag}");
+                assert_eq!(cycles, d, "{tag}: stopped at exactly the deadline");
+                let rec = soc.flash.chip.as_ref().unwrap().last_cut().unwrap();
+                assert_eq!((rec.started_at, rec.cut_at, rec.detected_at), (T0, d, d), "{tag}: requested deadline and actual firing cycle");
+                assert_eq!(soc.periph.flash_cut_at, u64::MAX, "{tag}: the event is spent");
+                if skip && chunks[0] >= 1024 {
+                    assert!(soc.loop_skip.skipped > 10_000, "{tag}: the loop skip really ran across the deadline ({} skipped)", soc.loop_skip.skipped);
+                }
+                let got = (pc, regs_at_stop, insns, cycles);
+                match &first {
+                    None => first = Some(got),
+                    Some(f) => assert_eq!(&got, f, "{tag}: the stop state differs from the first run's"),
+                }
+            }
+        }
+        // and the instruction count is what the clock says: one cycle an instruction, the loop skip included
+        let (_, _, insns, cycles) = first.unwrap();
+        assert!(insns + 1 >= cycles - T0 && insns <= cycles - T0, "{insns} instructions for {} cycles", cycles - T0);
+    }
