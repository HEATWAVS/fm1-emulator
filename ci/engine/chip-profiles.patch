+    #[test]
+    fn arming_is_validated_in_the_models_order() {
+        let mut r = Rig::new(ChipKind::Puya, Timing::Typical, false);
+        let spec = |op, nth, at| FaultSpec { op, nth, at };
+        assert_eq!(r.c.arm_fault(spec(FaultOp::Program, 0, FaultAt::AtAccept)), Err(FaultError::BadNth));
+        assert_eq!(r.c.arm_fault(spec(FaultOp::Program, 1, FaultAt::Fraction(-0.1))), Err(FaultError::BadAt));
+        assert_eq!(r.c.arm_fault(spec(FaultOp::Program, 1, FaultAt::Fraction(f64::NAN))), Err(FaultError::BadAt));
+        assert_eq!(r.c.arm_fault(spec(FaultOp::Program, 1, FaultAt::Fraction(1.0))), Err(FaultError::BadAt));
+        let pp = PUYA.typical.pp;
+        assert_eq!(r.c.arm_fault(spec(FaultOp::Program, 1, FaultAt::AfterUs(pp))), Err(FaultError::BadAt));
+        let t = &PUYA.typical;
+        let shortest = t.pp.min(t.se).min(t.be32).min(t.be64).min(t.ce);
+        assert_eq!(r.c.arm_fault(spec(FaultOp::Any, 1, FaultAt::AfterUs(shortest))), Err(FaultError::BadAt), "any: bounded by the SHORTEST cycle it can match");
+        let shortest_erase = t.se.min(t.be32).min(t.be64);
+        assert_eq!(r.c.arm_fault(spec(FaultOp::Erase, 1, FaultAt::AfterUs(shortest_erase))), Err(FaultError::BadAt), "erase: bounded by the shortest erase");
+        assert!(r.state().armed.is_none() && !r.state().journaling, "a refused arm changes nothing");
+        assert_eq!(r.c.arm_fault(spec(FaultOp::Program, 1, FaultAt::AfterUs(pp - 1))), Ok(()));
+        assert_eq!(r.c.arm_fault(spec(FaultOp::Program, 1, FaultAt::AtAccept)), Err(FaultError::AlreadyArmed));
+        assert_eq!(r.c.arm_fault(spec(FaultOp::Program, 0, FaultAt::AtAccept)), Err(FaultError::BadNth), "nth is checked first");
+        r.c.disarm_fault();
+        assert!(r.state().armed.is_none());
+        assert_eq!(FaultError::UseRestore.id(), "fault.use-restore");
+        assert_eq!(FaultOp::Erase.name(), "erase");
+    }
