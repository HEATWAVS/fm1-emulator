diff --git a/crates/fm1-soc/src/spichip.rs b/crates/fm1-soc/src/spichip.rs
new file mode 100644
index 0000000..d713bc9
--- /dev/null
+++ b/crates/fm1-soc/src/spichip.rs
@@ -0,0 +1,872 @@
+//! Datasheet-based SPI NOR chip state machine (HEATWAVS Stage C1), used by `SpiFlash` when a
+//! chip profile is selected. The default (no profile) is the original instantaneous model.
+//!
+//! The behaviour is a port of the Stage A reference model (`ci/machine/chipmodel.mjs`, which cites
+//! the Puya P25Q80H V1.7 and UC25HQ80 v1.2 datasheets by page and section for every behaviour);
+//! `tests/chip_oracle.rs` replays transcripts generated from that model against this code.
+//!
+//! Differences from the reference model, all deliberate:
+//! * Byte stream, not transactions. SPI0 moves whole bytes and chip select is a GPIO, so a
+//!   transaction ends when CS rises. Cases the byte stream cannot express (extra bytes after
+//!   RDSR/RDID are just more read slots; CS rising mid-byte) exist only in the reference model
+//!   and, for CS mid-byte, through `Chip::release(.., partial_bits)` (tests only).
+//! * Unspecified behaviour is never guessed: the command is ignored with no state change and the
+//!   datasheet behaviour id is recorded in `Events` (the reference model throws instead).
+//!   Status bits whose value the datasheet leaves open are tracked in `status_unknown`.
+//! * The array changes when a program/erase command is accepted (CS rises), as in the original
+//!   model, while WIP/WEL follow the cycle time. The datasheets leave the array contents during
+//!   a cycle unspecified (`array.during-cycle`) and reads during a cycle are not answered.
+//! * Time is the SoC cycle counter (`Periph::cycles`) at `hz`; cycle durations are the datasheet
+//!   typical or maximum figures rounded up to whole cycles.
+//! * FM1_FLASH_CUT power cuts are not honoured under a chip profile (native fm1-live only).
+
+use crate::spichip_tables::{Profile, Row, PUYA, UC25HQ80};
+use crate::spiflash::FLASH_SIZE;
+
+#[derive(Clone, Copy, PartialEq, Eq, Debug)]
+pub enum ChipKind {
+    Puya,
+    Uc25hq80,
+}
+
+#[derive(Clone, Copy, PartialEq, Eq, Debug)]
+pub enum Timing {
+    Typical,
+    Maximum,
+}
+
+// 16-bit status register (S15..S8 read by 35h, S7..S0 by 05h)
+pub const WIP: u16 = 1 << 0;
+pub const WEL: u16 = 1 << 1;
+const BP0: u16 = 1 << 2;
+const BP1: u16 = 1 << 3;
+const BP2: u16 = 1 << 4;
+const BP3: u16 = 1 << 5;
+const BP4: u16 = 1 << 6;
+const SRP0: u16 = 1 << 7;
+const SRP1: u16 = 1 << 8;
+const QE: u16 = 1 << 9;
+const LB1: u16 = 1 << 11;
+const LB2: u16 = 1 << 12;
+const LB3: u16 = 1 << 13;
+const CMP: u16 = 1 << 14;
+const BP: u16 = BP0 | BP1 | BP2 | BP3 | BP4;
+const LB: u16 = LB1 | LB2 | LB3;
+const LOW_WRITABLE: u16 = SRP0 | BP;
+const HIGH_WRITABLE: u16 = SRP1 | QE | LB | CMP;
+const ONE_BYTE_CLEARS: u16 = CMP | QE | SRP1;
+
+const PAGE: usize = 256;
+const BYTES: usize = FLASH_SIZE;
+
+/// What the chip was asked that its datasheet does not settle, or that is outside the model.
+#[derive(Default, Clone, Debug)]
+pub struct Events {
+    /// commands ignored because the datasheet is silent or contradicts itself
+    pub unspecified: u32,
+    /// opcodes outside the modelled set (answered with 0xFF, no state change)
+    pub not_modeled: u32,
+    /// the most recent opcode counted in `not_modeled` (0 if none)
+    pub last_not_modeled: u8,
+    /// 4Bh Read Unique ID reads answered without a configured ID fixture: the datasheets print no value, so the bytes are 0xFF and
+    /// unknown (reported, not invented)
+    pub uid_unknown_reads: u32,
+    /// ids of the most recent events (behaviour ids from chipspec.mjs), oldest dropped
+    pub log: Vec<&'static str>,
+}
+
+const LOG_MAX: usize = 64;
+
+#[derive(Clone, Copy, PartialEq, Eq, Debug)]
+enum Cmd {
+    /// nothing to do (an ignored command, an unmodelled opcode, no opcode yet)
+    Ignore,
+    Rdsr(u8),
+    Rdid,
+    /// 4Bh Read Unique ID: four dummy bytes, then the 128-bit ID
+    Ruid,
+    Read03,
+    Read0b,
+    /// executes when CS rises
+    Write(u8),
+}
+
+#[derive(Clone, Copy, PartialEq, Eq, Debug)]
+enum CycleKind {
+    Program,
+    Erase,
+    Wrsr,
+}
+
+#[derive(Clone, Copy, Debug)]
+struct Busy {
+    end: u64,
+    kind: CycleKind,
+    /// status after a write-status cycle completes (Wrsr only)
+    next_sr: u16,
+    next_unknown: u16,
+    /// status bits whose value is open while the cycle runs
+    unknown_bits: u16,
+}
+
+pub struct Chip {
+    kind: ChipKind,
+    timing: Timing,
+    wp: bool,
+    sr: u16,
+    unknown: u16,
+    busy: Option<Busy>,
+    now: u64,
+    hz: u64,
+    // the current transaction
+    cmd: Cmd,
+    n: usize,
+    hdr: [u8; 4],
+    latch: [u8; PAGE],
+    used: [bool; PAGE],
+    /// unspecified-event guard for the "read past the ID" case (once per transaction)
+    id_extra: bool,
+    /// guard: count a 4Bh read without a fixture once per transaction
+    uid_counted: bool,
+    /// The 128-bit unique ID 4Bh transmits, byte 0 (bits 127-120) first. A caller-supplied fixture: the value is per device and in neither
+    /// datasheet, so there is none unless one is set (and none is ever invented).
+    uid: Option<[u8; 16]>,
+    pub events: Events,
+}
+
+impl Chip {
+    pub fn new(kind: ChipKind, timing: Timing) -> Self {
+        Self {
+            kind,
+            timing,
+            wp: true,
+            sr: 0,
+            unknown: 0,
+            busy: None,
+            now: 0,
+            hz: 1_000_000,
+            cmd: Cmd::Ignore,
+            n: 0,
+            hdr: [0; 4],
+            latch: [0xff; PAGE],
+            used: [false; PAGE],
+            id_extra: false,
+            uid_counted: false,
+            uid: None,
+            events: Events::default(),
+        }
+    }
+
+    /// Set (or clear) the unique-ID fixture 4Bh returns. Survives power cycles (the ID is factory-set and read-only).
+    pub fn set_uid(&mut self, uid: Option<[u8; 16]>) { self.uid = uid; }
+    pub fn uid(&self) -> Option<[u8; 16]> { self.uid }
+
+    pub fn kind(&self) -> ChipKind { self.kind }
+    pub fn timing(&self) -> Timing { self.timing }
+    pub fn set_timing(&mut self, t: Timing) { self.timing = t; }
+    /// The WP# pin (default high). Only matters when SRP1:SRP0 = 0:1.
+    pub fn set_wp(&mut self, high: bool) { self.wp = high; }
+
+    fn profile(&self) -> &'static Profile {
+        match self.kind {
+            ChipKind::Puya => &PUYA,
+            ChipKind::Uc25hq80 => &UC25HQ80,
+        }
+    }
+
+    /// The SoC's clock: the cycle count and cycles per second. Called before every operation.
+    pub fn set_clock(&mut self, now: u64, hz: u64) {
+        self.now = now;
+        self.hz = hz.max(1);
+    }
+
+    fn cycles(&self, us: u32) -> u64 {
+        ((us as u128 * self.hz as u128 + 999_999) / 1_000_000) as u64
+    }
+
+    fn event(&mut self, id: &'static str, unspecified: bool) {
+        if unspecified { self.events.unspecified += 1 } else { self.events.not_modeled += 1 }
+        if self.events.log.len() >= LOG_MAX {
+            self.events.log.remove(0);
+        }
+        self.events.log.push(id);
+    }
+    fn unspec(&mut self, id: &'static str) { self.event(id, true); }
+
+    /// Take (and clear) the recorded event ids.
+    pub fn take_log(&mut self) -> Vec<&'static str> { std::mem::take(&mut self.events.log) }
+
+    // ------------------------------------------------------------ time and status
+    fn settle(&mut self) {
+        if let Some(b) = self.busy {
+            if self.now >= b.end {
+                self.busy = None;
+                if b.kind == CycleKind::Wrsr {
+                    self.sr = b.next_sr;
+                    self.unknown = b.next_unknown;
+                }
+                self.sr &= !(WEL | WIP); // completion resets WEL (both datasheets)
+                self.unknown &= !WEL;
+            }
+        }
+    }
+
+    /// (value, unknown mask) of the 16-bit status register at the current time.
+    pub fn status(&mut self) -> (u16, u16) {
+        self.settle();
+        let mut value = self.sr & !WIP;
+        let mut unknown = self.unknown;
+        if let Some(b) = self.busy {
+            value |= WIP;
+            unknown |= b.unknown_bits;
+            if self.kind == ChipKind::Uc25hq80 {
+                unknown |= WEL; // UC: WEL resets 'at some unspecified time before completion'
+            }
+        }
+        (value, unknown)
+    }
+
+    /// Is a program/erase/write-status cycle running at the current time?
+    pub fn wip(&mut self) -> bool {
+        self.settle();
+        self.busy.is_some()
+    }
+
+    /// Cycle count at which the running cycle ends, if any (introspection).
+    pub fn busy_until(&mut self) -> Option<u64> {
+        self.settle();
+        self.busy.map(|b| b.end)
+    }
+
+    /// The non-volatile status bits (SRP0/1, BP4-BP0, QE, LB3-1, CMP) as they will be once any running cycle ends, packed
+    /// `value | unknown << 16` (the unknown mask carries bits the datasheet leaves open). What survives a power cycle.
+    pub fn nv_status(&mut self) -> u32 {
+        self.settle();
+        let (mut sr, mut unk) = (self.sr, self.unknown);
+        if let Some(b) = self.busy {
+            if b.kind == CycleKind::Wrsr {
+                sr = b.next_sr; // a write-status cycle in progress is treated as completing (power loss mid-cycle is not modelled)
+                unk = b.next_unknown;
+            }
+        }
+        const NV: u16 = LOW_WRITABLE | HIGH_WRITABLE;
+        ((sr & NV) as u32) | (((unk & NV) as u32) << 16)
+    }
+
+    /// Power-on of a chip that kept `packed` (from `nv_status`) while off: the non-volatile bits are restored and the
+    /// power-up rules apply (WEL clear; SRP1:SRP0 = 1:0 returns to 0:0).
+    pub fn restore_nv(&mut self, packed: u32) {
+        const NV: u16 = LOW_WRITABLE | HIGH_WRITABLE;
+        self.busy = None;
+        self.sr = (self.sr & !NV) | (packed as u16 & NV);
+        self.unknown = (self.unknown & !NV) | ((packed >> 16) as u16 & NV);
+        self.power_cycle();
+    }
+
+    /// Power off and on: WEL clears, SRP1:SRP0 = 1:0 returns to 0:0. Not allowed mid-cycle (that is
+    /// fault injection, not modelled): recorded and ignored.
+    pub fn power_cycle(&mut self) {
+        self.settle();
+        if self.busy.is_some() {
+            self.event("nm.power-loss", false);
+            return;
+        }
+        self.sr &= !(WEL | WIP);
+        self.unknown &= !WEL;
+        if self.unknown & (SRP0 | SRP1) == 0 && self.sr & SRP1 != 0 && self.sr & SRP0 == 0 {
+            self.sr &= !SRP1;
+        }
+        self.cmd = Cmd::Ignore;
+        self.n = 0;
+    }
+
+    // ------------------------------------------------------------ the byte stream
+    /// CS# fell: a new transaction.
+    pub fn select(&mut self) {
+        self.cmd = Cmd::Ignore;
+        self.n = 0;
+        self.id_extra = false;
+        self.uid_counted = false;
+    }
+
+    fn first_byte(&mut self, op: u8) {
+        self.settle();
+        self.hdr[0] = op;
+        const MODELED: [u8; 16] = [0x06, 0x04, 0x05, 0x35, 0x01, 0x02, 0x81, 0x20, 0x52, 0xd8, 0x60, 0xc7, 0x9f, 0x03, 0x0b, 0x4b];
+        if !MODELED.contains(&op) {
+            let id = match op {
+                0x15 | 0x31 if self.kind == ChipKind::Puya => "nm.puya-config-register",
+                0x50 => "nm.vwren",
+                0x25 => "nm.asi",
+                0x75 | 0xb0 | 0x7a | 0x30 => "nm.suspend-resume",
+                0xb9 | 0xab => "nm.deep-power-down",
+                0x66 | 0x99 => "nm.reset",
+                0x44 | 0x42 | 0x48 => "nm.security",
+                0x5a => "nm.unique-sfdp",
+                0x3b | 0xbb | 0x6b | 0xeb | 0xa2 | 0x32 => "nm.multi-io",
+                0x90 | 0x92 | 0x94 => "nm.electronic-id",
+                0x77 | 0xff => "nm.burst-wrap",
+                _ => "cmd.unknown",
+            };
+            self.event(id, false);
+            self.events.last_not_modeled = op;
+            self.cmd = Cmd::Ignore;
+            return;
+        }
+        if let Some(b) = self.busy {
+            self.cmd = match op {
+                0x05 => Cmd::Rdsr(0),
+                0x35 => Cmd::Rdsr(8),
+                0x9f => {
+                    if b.kind == CycleKind::Wrsr {
+                        self.unspec("id.rdid-busy-wrsr");
+                        Cmd::Ignore
+                    } else {
+                        Cmd::Ignore // not decoded, does not disturb the cycle (answers nothing)
+                    }
+                }
+                0x4b => {
+                    self.unspec("ruid.busy"); // not stated for RUID (UC states it for RDSFDP only)
+                    Cmd::Ignore
+                }
+                0x03 | 0x0b => Cmd::Ignore, // rejected without effect on the cycle
+                _ => {
+                    self.unspec("cmd.busy");
+                    Cmd::Ignore
+                }
+            };
+            return;
+        }
+        self.cmd = match op {
+            0x05 => Cmd::Rdsr(0),
+            0x35 => Cmd::Rdsr(8),
+            0x9f => Cmd::Rdid,
+            0x4b => Cmd::Ruid,
+            0x03 => Cmd::Read03,
+            0x0b => Cmd::Read0b,
+            _ => {
+                if op == 0x02 {
+                    self.used = [false; PAGE];
+                }
+                Cmd::Write(op)
+            }
+        };
+    }
+
+    /// One byte exchanged on MOSI; returns the byte on MISO. `mem` is the array (reads only).
+    pub fn transfer(&mut self, mem: &[u8], out: u8) -> u8 {
+        let i = self.n;
+        self.n += 1;
+        if i == 0 {
+            self.first_byte(out);
+            return 0xff;
+        }
+        let k = i - 1;
+        match self.cmd {
+            Cmd::Ignore => 0xff,
+            Cmd::Rdsr(shift) => {
+                let (v, _) = self.status();
+                (v >> shift) as u8
+            }
+            Cmd::Ruid => {
+                if k < 3 {
+                    self.hdr[k + 1] = out; // dummy bytes 1-3 (the UC25HQ80's Table-7 lists 00H for them)
+                    0xff
+                } else if k == 3 {
+                    if self.kind == ChipKind::Uc25hq80 && (self.hdr[1] | self.hdr[2] | self.hdr[3]) != 0 {
+                        self.unspec("ruid.dummy-values"); // not stated for other values: refused
+                        self.cmd = Cmd::Ignore;
+                    }
+                    0xff // the fourth dummy byte
+                } else if k - 4 < 16 {
+                    match self.uid {
+                        Some(u) => u[k - 4],
+                        None => {
+                            if !self.uid_counted {
+                                self.uid_counted = true;
+                                self.events.uid_unknown_reads += 1; // no value is printed in the datasheets: 0xFF, unknown, counted
+                            }
+                            0xff
+                        }
+                    }
+                } else {
+                    if !self.id_extra {
+                        self.id_extra = true;
+                        self.unspec("ruid.beyond-128-bits");
+                    }
+                    0xff
+                }
+            }
+            Cmd::Rdid => {
+                if k < 3 {
+                    self.profile().jedec[k]
+                } else {
+                    if !self.id_extra {
+                        self.id_extra = true;
+                        self.unspec("id.rdid-extra-bytes");
+                    }
+                    0xff
+                }
+            }
+            Cmd::Read03 | Cmd::Read0b => {
+                let head = if self.cmd == Cmd::Read03 { 3 } else { 4 };
+                if k < 3 {
+                    self.hdr[k + 1] = out;
+                    0xff
+                } else if k < head {
+                    0xff // fast-read dummy byte
+                } else {
+                    let start = ((self.hdr[1] as usize) << 16) | ((self.hdr[2] as usize) << 8) | self.hdr[3] as usize;
+                    mem[(start + (k - head)) % BYTES]
+                }
+            }
+            Cmd::Write(op) => {
+                if i < 4 {
+                    self.hdr[i] = out;
+                } else if op == 0x02 {
+                    let o = (self.hdr[3] as usize + (i - 4)) & 0xff;
+                    self.latch[o] = out;
+                    self.used[o] = true;
+                }
+                0xff
+            }
+        }
+    }
+
+    // ------------------------------------------------------------ CS rises: commands execute
+    /// CS# rose, `partial_bits` clocks (0..=7) after the last whole byte (always 0 on the SoC's
+    /// byte-wide SPI0). Returns the flash range an erase/program changed, if any.
+    pub fn release(&mut self, mem: &mut [u8], partial_bits: u8) -> Option<(usize, usize)> {
+        let n = self.n;
+        let cmd = self.cmd;
+        self.n = 0;
+        self.cmd = Cmd::Ignore;
+        if n == 0 {
+            return None;
+        }
+        self.settle();
+        match cmd {
+            Cmd::Ignore | Cmd::Rdsr(_) | Cmd::Rdid => None,
+            Cmd::Ruid => {
+                if n < 5 {
+                    self.unspec("ruid.malformed"); // CS# rose before the four dummy bytes were complete
+                }
+                None
+            }
+            Cmd::Read03 | Cmd::Read0b => {
+                let need = if cmd == Cmd::Read03 { 4 } else { 5 };
+                if n < need {
+                    self.unspec("read.malformed");
+                } else if (((self.hdr[1] as usize) << 16) | ((self.hdr[2] as usize) << 8) | self.hdr[3] as usize) >= BYTES {
+                    self.unspec("addr.range");
+                }
+                None
+            }
+            Cmd::Write(op) => self.execute(mem, op, n, partial_bits),
+        }
+    }
+
+    fn addr(&self) -> usize { ((self.hdr[1] as usize) << 16) | ((self.hdr[2] as usize) << 8) | self.hdr[3] as usize }
+
+    fn start(&mut self, kind: CycleKind, us: u32, next_sr: u16, next_unknown: u16, unknown_bits: u16) {
+        self.busy = Some(Busy { end: self.now + self.cycles(us), kind, next_sr, next_unknown, unknown_bits });
+    }
+    fn us(&self) -> &'static crate::spichip_tables::TimingUs {
+        let p = self.profile();
+        match self.timing {
+            Timing::Typical => &p.typical,
+            Timing::Maximum => &p.maximum,
+        }
+    }
+
+    /// The write-enable latch, or None (event recorded) when its value is open.
+    fn wel_set(&mut self) -> Option<bool> {
+        if self.unknown & WEL != 0 {
+            self.unspec("wel.after-rejected");
+            return None;
+        }
+        Some(self.sr & WEL != 0)
+    }
+    fn rejected_boundary(&mut self, name: &str, partial: u8) {
+        if !(self.kind == ChipKind::Uc25hq80 && name == "pp" && partial != 0) {
+            self.unknown |= WEL; // not stated by the datasheets: open
+        }
+    }
+    fn ignored_protected(&mut self, name: &str) {
+        if self.kind == ChipKind::Puya && name == "be32" {
+            self.sr &= !WEL; // Puya p37: 'the WEL bit will be reset'
+        } else {
+            self.unknown |= WEL;
+        }
+    }
+
+    /// The protected range for the current BP/CMP, Err when those bits are open.
+    fn protected_range(&mut self) -> Result<Option<(u32, u32)>, ()> {
+        if self.unknown & (BP | CMP) != 0 {
+            self.unspec("prot.table");
+            return Err(());
+        }
+        let bp = [BP4, BP3, BP2, BP1, BP0].map(|b| (self.sr & b != 0) as i8);
+        let p = self.profile();
+        let rows: &[Row] = if self.sr & CMP != 0 { p.cmp1 } else { p.cmp0 };
+        let row = rows.iter().find(|r| r.pat.iter().zip(bp.iter()).all(|(c, b)| *c == -1 || c == b));
+        Ok(row.expect("protection table covers every BP combination").range)
+    }
+    fn overlaps_protected(&mut self, lo: usize, hi: usize) -> Result<bool, ()> {
+        Ok(self.protected_range()?.is_some_and(|(plo, phi)| lo as u32 <= phi && hi as u32 >= plo))
+    }
+
+    fn execute(&mut self, mem: &mut [u8], op: u8, n: usize, partial: u8) -> Option<(usize, usize)> {
+        match op {
+            0x06 | 0x04 => {
+                if n != 1 {
+                    self.unspec("cmd.extra-bytes");
+                    return None;
+                }
+                if partial != 0 {
+                    return None; // rejected: 'not executed' read as no state change
+                }
+                if op == 0x06 { self.sr |= WEL } else { self.sr &= !WEL }
+                self.unknown &= !WEL;
+                None
+            }
+            0x02 => self.page_program(mem, n, partial),
+            0x01 => {
+                self.wrsr(n, partial);
+                None
+            }
+            0x60 | 0xc7 => self.chip_erase(mem, n, partial),
+            _ => self.erase(mem, op, n, partial), // 81h 20h 52h D8h
+        }
+    }
+
+    fn page_program(&mut self, mem: &mut [u8], n: usize, partial: u8) -> Option<(usize, usize)> {
+        match self.wel_set() {
+            None | Some(false) => return None, // open WEL (event) or ignored without WEL
+            Some(true) => {}
+        }
+        if n < 5 {
+            self.unspec("pp.min-one-byte");
+            return None;
+        }
+        if partial != 0 {
+            self.rejected_boundary("pp", partial);
+            return None;
+        }
+        let addr = self.addr();
+        if addr >= BYTES {
+            self.unspec("addr.range");
+            return None;
+        }
+        let page = addr - addr % PAGE;
+        match self.overlaps_protected(page, page + PAGE - 1) {
+            Err(()) => return None,
+            Ok(true) => {
+                self.ignored_protected("pp");
+                return None;
+            }
+            Ok(false) => {}
+        }
+        let (mut lo, mut hi) = (PAGE, 0);
+        for o in 0..PAGE {
+            if self.used[o] {
+                mem[page + o] &= self.latch[o];
+                lo = lo.min(o);
+                hi = hi.max(o + 1);
+            }
+        }
+        let us = self.us().pp;
+        self.start(CycleKind::Program, us, 0, 0, 0);
+        Some((page + lo, page + hi))
+    }
+
+    fn erase(&mut self, mem: &mut [u8], op: u8, n: usize, partial: u8) -> Option<(usize, usize)> {
+        let (name, size) = match op {
+            0x81 => ("pe", PAGE),
+            0x20 => ("se", 4096),
+            0x52 => ("be32", 32768),
+            _ => ("be64", 65536),
+        };
+        match self.wel_set() {
+            None | Some(false) => return None,
+            Some(true) => {}
+        }
+        if partial != 0 || n != 4 {
+            self.rejected_boundary(name, partial);
+            return None;
+        }
+        let addr = self.addr();
+        if addr >= BYTES {
+            self.unspec("addr.range");
+            return None;
+        }
+        let lo = addr - addr % size;
+        let hi = lo + size - 1;
+        match self.overlaps_protected(lo, hi) {
+            Err(()) => return None,
+            Ok(true) => {
+                self.ignored_protected(name);
+                return None;
+            }
+            Ok(false) => {}
+        }
+        mem[lo..=hi].fill(0xff);
+        let t = self.us();
+        let us = match op {
+            0x81 => t.pe,
+            0x20 => t.se,
+            0x52 => t.be32,
+            _ => t.be64,
+        };
+        self.start(CycleKind::Erase, us, 0, 0, 0);
+        Some((lo, hi + 1))
+    }
+
+    fn chip_erase(&mut self, mem: &mut [u8], n: usize, partial: u8) -> Option<(usize, usize)> {
+        match self.wel_set() {
+            None | Some(false) => return None,
+            Some(true) => {}
+        }
+        if partial != 0 || n != 1 {
+            self.rejected_boundary("ce", partial);
+            return None;
+        }
+        let Ok(range) = self.protected_range() else { return None };
+        let nothing = range.is_none();
+        let run = if self.kind == ChipKind::Puya {
+            nothing // Puya p24/p38: one rule, all 64 combinations decided
+        } else {
+            let bp_zero = self.sr & BP == 0;
+            if bp_zero != nothing {
+                self.unspec("prot.chip-erase-conflict"); // UC25HQ80's own statements disagree
+                return None;
+            }
+            bp_zero
+        };
+        if !run {
+            self.ignored_protected("ce");
+            return None;
+        }
+        mem.fill(0xff);
+        let us = self.us().ce;
+        self.start(CycleKind::Erase, us, 0, 0, 0);
+        Some((0, BYTES))
+    }
+
+    fn wrsr(&mut self, n: usize, partial: u8) {
+        match self.wel_set() {
+            None | Some(false) => return,
+            Some(true) => {}
+        }
+        let data = n - 1;
+        if partial != 0 || (data != 1 && data != 2) {
+            self.rejected_boundary("wrsr", partial);
+            return;
+        }
+        if self.unknown & (SRP0 | SRP1) != 0 {
+            self.unspec("wrsr.hw-protection");
+            return;
+        }
+        let srp = (if self.sr & SRP1 != 0 { 2 } else { 0 }) | (if self.sr & SRP0 != 0 { 1 } else { 0 });
+        if srp == 3 {
+            self.unspec("srp.otp");
+            return;
+        }
+        if srp == 2 || (srp == 1 && !self.wp) {
+            self.unknown |= WEL; // hardware/lock-down protected: not executed, WEL not stated
+            return;
+        }
+        let old = self.sr;
+        let mut next = (old & !LOW_WRITABLE) | (self.hdr[1] as u16 & LOW_WRITABLE);
+        let mut unknown_after = self.unknown;
+        if data == 2 {
+            let hi = ((self.hdr[2] as u16) << 8) & HIGH_WRITABLE;
+            next = (next & !HIGH_WRITABLE) | (hi & !LB) | (old & LB) | (hi & LB); // LB bits only go 0 -> 1
+        } else if self.kind == ChipKind::Puya {
+            next &= !ONE_BYTE_CLEARS; // Puya p26
+        } else {
+            unknown_after |= HIGH_WRITABLE; // UC: not stated
+        }
+        let in_flux = ((old ^ next) & (LOW_WRITABLE | HIGH_WRITABLE)) | (unknown_after & !self.unknown);
+        let us = self.us().wrsr;
+        self.start(CycleKind::Wrsr, us, next, unknown_after, in_flux);
+    }
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+    use crate::spichip_tables::{PUYA, UC25HQ80};
+
+    fn at(kind: ChipKind) -> Chip {
+        let mut c = Chip::new(kind, Timing::Typical);
+        c.set_clock(0, 100_000_000);
+        c
+    }
+    fn xfer(c: &mut Chip, mem: &mut Vec<u8>, tx: &[u8], read: usize) -> Vec<u8> {
+        c.select();
+        for &b in tx {
+            c.transfer(mem, b);
+        }
+        let out = (0..read).map(|_| c.transfer(mem, 0)).collect();
+        c.release(mem, 0);
+        out
+    }
+
+    /// Every one of the 64 BP4-BP0/CMP combinations selects exactly one row of each chip's protection table.
+    #[test]
+    fn protection_tables_decide_every_combination() {
+        for p in [&PUYA, &UC25HQ80] {
+            for rows in [p.cmp0, p.cmp1] {
+                for bp in 0..32u8 {
+                    let bits = [4, 3, 2, 1, 0].map(|k| ((bp >> k) & 1) as i8);
+                    let n = rows.iter().filter(|r| r.pat.iter().zip(bits.iter()).all(|(c, b)| *c == -1 || c == b)).count();
+                    assert_eq!(n, 1, "bp {bp:05b}");
+                }
+            }
+        }
+    }
+
+    /// Chip erase: the Puya table decides all 64 combinations; the UC25HQ80's statements conflict at exactly 14.
+    #[test]
+    fn chip_erase_rule_counts() {
+        for (kind, expect) in [(ChipKind::Puya, 0), (ChipKind::Uc25hq80, 14)] {
+            let mut conflicts = 0;
+            for cmp in 0..2u16 {
+                for bp in 0..32u16 {
+                    let mut c = at(kind);
+                    c.sr = (bp << 2) | (cmp << 14);
+                    let nothing = c.protected_range().unwrap().is_none();
+                    if kind == ChipKind::Uc25hq80 && ((c.sr & BP) == 0) != nothing {
+                        conflicts += 1;
+                    }
+                }
+            }
+            assert_eq!(conflicts, expect, "{kind:?}");
+        }
+    }
+
+    /// The datasheet figures (microseconds), literally, not derived from the generator's own source.
+    #[test]
+    fn datasheet_timing_figures() {
+        let p = (&PUYA.typical, &PUYA.maximum);
+        assert_eq!((p.0.pp, p.0.pe, p.0.se, p.0.be32, p.0.be64, p.0.ce, p.0.wrsr), (2000, 8000, 8000, 8000, 8000, 8000, 8000));
+        assert_eq!((p.1.pp, p.1.pe, p.1.se, p.1.be32, p.1.be64, p.1.ce, p.1.wrsr), (3000, 20000, 20000, 20000, 20000, 20000, 12000));
+        let u = (&UC25HQ80.typical, &UC25HQ80.maximum);
+        assert_eq!((u.0.pp, u.0.pe, u.0.se, u.0.be32, u.0.be64, u.0.ce, u.0.wrsr), (1500, 7000, 7000, 7000, 7000, 7000, 8000));
+        assert_eq!((u.1.pp, u.1.pe, u.1.se, u.1.be32, u.1.be64, u.1.ce, u.1.wrsr), (3000, 10000, 10000, 10000, 10000, 10000, 12000));
+        assert_eq!(PUYA.jedec, [0x85, 0x60, 0x14]);
+        assert_eq!(UC25HQ80.jedec, [0xb3, 0x60, 0x14]);
+    }
+
+    /// Without WREN nothing is programmed or erased, and no cycle starts (the original model programmed anyway).
+    #[test]
+    fn writes_need_wel() {
+        for kind in [ChipKind::Puya, ChipKind::Uc25hq80] {
+            let (mut c, mut mem) = (at(kind), vec![0x5a; FLASH_SIZE]);
+            xfer(&mut c, &mut mem, &[0x02, 0, 0, 0, 0x00], 0);
+            xfer(&mut c, &mut mem, &[0x20, 0, 0, 0], 0);
+            assert!(mem.iter().all(|&b| b == 0x5a) && !c.wip());
+            xfer(&mut c, &mut mem, &[0x06], 0);
+            assert_eq!(xfer(&mut c, &mut mem, &[0x05], 1), [0x02], "WEL set, not busy");
+            xfer(&mut c, &mut mem, &[0x20, 0, 0, 0], 0);
+            assert!(c.wip() && mem[0..4096].iter().all(|&b| b == 0xff));
+        }
+    }
+
+    /// A page program that runs past the end of its page wraps to the start of the same page.
+    #[test]
+    fn program_wraps_within_the_page() {
+        let (mut c, mut mem) = (at(ChipKind::Puya), vec![0xff; FLASH_SIZE]);
+        xfer(&mut c, &mut mem, &[0x06], 0);
+        xfer(&mut c, &mut mem, &[0x02, 0x00, 0x01, 0xfe, 1, 2, 3, 4], 0);
+        assert_eq!((mem[0x1fe], mem[0x1ff], mem[0x100], mem[0x101], mem[0x200]), (1, 2, 3, 4, 0xff));
+    }
+
+    /// Opcodes outside the model are recorded, answered 0xFF, and change nothing.
+    /// Non-volatile bits survive a power cycle through nv_status/restore_nv; WEL does not; lock-down SRP1:SRP0 = 1:0 returns to 0:0.
+    #[test]
+    fn nv_status_round_trips_across_power_off() {
+        let (mut a, mut mem) = (at(ChipKind::Puya), vec![0xff; FLASH_SIZE]);
+        xfer(&mut a, &mut mem, &[0x06], 0);
+        xfer(&mut a, &mut mem, &[0x01, 0x1c | 0x80, 0x40 | 0x02], 0); // BP2..0 (0x1c = BP2,BP1,BP0... as bits 4..2), SRP0, CMP, QE
+        a.set_clock(100_000_000, 100_000_000); // 1 s later: the cycle is long over
+        let packed = a.nv_status();
+        let mut b = at(ChipKind::Puya);
+        b.restore_nv(packed);
+        assert_eq!(b.status().0, 0x1c | 0x80 | ((0x40 | 0x02) << 8));
+        let mut c = at(ChipKind::Puya);
+        c.restore_nv(((0x100u16) as u32) | 0); // SRP1 alone = lock-down
+        assert_eq!(c.status().0, 0, "lock-down returns to 0:0 at power-up");
+        let mut d = at(ChipKind::Puya);
+        d.sr |= WEL;
+        d.restore_nv(0);
+        assert_eq!(d.status().0, 0, "WEL does not survive");
+    }
+
+    #[test]
+    fn unmodelled_opcodes_are_recorded() {
+        let (mut c, mut mem) = (at(ChipKind::Uc25hq80), vec![0xff; FLASH_SIZE]);
+        assert_eq!(xfer(&mut c, &mut mem, &[0x5a, 0, 0, 0, 0], 4), [0xff; 4]); // SFDP is not modelled
+        assert_eq!(c.events.not_modeled, 1);
+        assert_eq!(c.events.last_not_modeled, 0x5a);
+        assert_eq!(c.take_log(), ["nm.unique-sfdp"]);
+        assert_eq!(c.status(), (0, 0));
+    }
+
+    const UID: [u8; 16] = [0x13, 0x57, 0x9b, 0xdf, 0x02, 0x46, 0x8a, 0xce, 0xf1, 0xe2, 0xd3, 0xc4, 0xb5, 0xa6, 0x97, 0x88]; // a test fixture, not a device ID
+
+    /// 4Bh: four dummy bytes, then the fixture's 16 bytes, first byte first, any length up to 16.
+    #[test]
+    fn ruid_returns_the_fixture_in_transmission_order() {
+        for kind in [ChipKind::Puya, ChipKind::Uc25hq80] {
+            let (mut c, mut mem) = (at(kind), vec![0xff; FLASH_SIZE]);
+            c.set_uid(Some(UID));
+            assert_eq!(xfer(&mut c, &mut mem, &[0x4b, 0, 0, 0, 0], 16), UID);
+            for n in [0usize, 1, 2, 8, 15] {
+                assert_eq!(xfer(&mut c, &mut mem, &[0x4b, 0, 0, 0, 0], n), UID[..n]);
+            }
+            assert_eq!(c.events.unspecified + c.events.not_modeled + c.events.uid_unknown_reads, 0);
+            assert_eq!(c.status(), (0, 0), "a read: no WIP, WEL or status change");
+        }
+    }
+
+    /// Without a fixture the bytes are 0xFF and counted as unknown; nothing is invented. Dummy values: Puya don't-care, UC25HQ80 refuses non-zero in bytes 2-4.
+    #[test]
+    fn ruid_without_a_fixture_and_the_dummy_byte_difference() {
+        let (mut c, mut mem) = (at(ChipKind::Puya), vec![0xff; FLASH_SIZE]);
+        assert_eq!(xfer(&mut c, &mut mem, &[0x4b, 0, 0, 0, 0], 16), [0xff; 16]);
+        assert_eq!(c.events.uid_unknown_reads, 1, "one transaction, counted once");
+        assert_eq!(c.events.unspecified, 0);
+        c.set_uid(Some(UID));
+        assert_eq!(xfer(&mut c, &mut mem, &[0x4b, 0xff, 0xaa, 0x55, 0x12], 16), UID, "Puya: dummy bytes carry no meaning");
+        let mut u = at(ChipKind::Uc25hq80);
+        u.set_uid(Some(UID));
+        for tx in [[0x4b, 1, 0, 0, 0], [0x4b, 0, 0x80, 0, 0], [0x4b, 0, 0, 0xff, 0]] {
+            assert_eq!(xfer(&mut u, &mut mem, &tx, 16), [0xff; 16], "refused: no ID bytes");
+            assert_eq!(u.take_log(), ["ruid.dummy-values"]);
+        }
+        assert_eq!(xfer(&mut u, &mut mem, &[0x4b, 0, 0, 0, 0xa5], 16), UID, "the fourth dummy byte is not constrained");
+    }
+
+    /// Refusals are explicit (counted as unspecified), the fixture survives power cycles, and 4Bh during a cycle is refused.
+    #[test]
+    fn ruid_refusals_and_persistence() {
+        for kind in [ChipKind::Puya, ChipKind::Uc25hq80] {
+            let (mut c, mut mem) = (at(kind), vec![0xff; FLASH_SIZE]);
+            c.set_uid(Some(UID));
+            assert_eq!(xfer(&mut c, &mut mem, &[0x4b, 0, 0], 0), []);
+            assert_eq!(c.take_log(), ["ruid.malformed"], "CS# before the four dummy bytes");
+            assert_eq!(&xfer(&mut c, &mut mem, &[0x4b, 0, 0, 0, 0], 17)[..16], UID);
+            assert_eq!(c.take_log(), ["ruid.beyond-128-bits"], "more than 128 bits");
+            c.power_cycle();
+            assert_eq!(xfer(&mut c, &mut mem, &[0x4b, 0, 0, 0, 0], 16), UID, "the factory-set ID survives power-off");
+            xfer(&mut c, &mut mem, &[0x06], 0);
+            xfer(&mut c, &mut mem, &[0x20, 0, 0, 0], 0);
+            assert!(c.wip());
+            assert_eq!(xfer(&mut c, &mut mem, &[0x4b, 0, 0, 0, 0], 4), [0xff; 4]);
+            assert_eq!(c.take_log(), ["ruid.busy"], "not stated for RUID: refused, the cycle is undisturbed");
+            assert!(c.wip());
+        }
+    }
+}
