+    const UID: [u8; 16] = [0x13, 0x57, 0x9b, 0xdf, 0x02, 0x46, 0x8a, 0xce, 0xf1, 0xe2, 0xd3, 0xc4, 0xb5, 0xa6, 0x97, 0x88]; // a test fixture, not a device ID
+
+    /// 4Bh: four dummy bytes, then the fixture's 16 bytes, first byte first, any length up to 16.
+    #[test]
+    fn ruid_returns_the_fixture_in_transmission_order() {
+        for kind in [ChipKind::Puya, ChipKind::Uc25hq80] {
+            let (mut c, mut mem) = (at(kind), vec![0xff; FLASH_SIZE]);
+            c.set_uid(Some(UID));
