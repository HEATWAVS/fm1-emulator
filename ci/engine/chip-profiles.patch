+    /// cut one cycle before it is due is not fired; at its cycle it is; completion time is never reached first.
+    #[test]
+    fn the_cut_lands_exactly_at_its_cycle() {
+        for kind in PROFILES {
+            for op in CUTS {
+                let d = dur_us(kind, Timing::Typical, op);
+                for (at, off) in [(FaultAt::AfterUs(d - 1), d - 1), (FaultAt::AfterUs(1), 1), (FaultAt::Fraction(0.5), d / 2)] {
+                    let tag = format!("{kind:?} {op:?} {at:?}");
+                    let cut_at = (T0 + off as u64) * CPU;
+                    let mut r = Rig::new(kind, Timing::Typical, false);
+                    r.c.arm_fault(FaultSpec { op, nth: 1, at }).unwrap();
+                    r.clock(T0);
+                    r.accept(op);
+                    r.clock_cycles(cut_at - 1);
+                    let st = r.state();
+                    assert!(!st.powered_off, "{tag}: one cycle before");
+                    assert!(r.c.busy_until().is_some(), "{tag}: still running one cycle before");
+                    r.clock_cycles(cut_at);
+                    assert!(r.state().powered_off, "{tag}: fired at its cycle");
+                }
+                // a trigger at or beyond the end would be a normal completion: refused
+                let mut r = Rig::new(kind, Timing::Typical, false);
+                assert_eq!(r.c.arm_fault(FaultSpec { op, nth: 1, at: FaultAt::AfterUs(d) }), Err(FaultError::BadAt), "{op:?} afterUs = duration");
+                assert_eq!(r.c.arm_fault(FaultSpec { op, nth: 1, at: FaultAt::Fraction(1.0) }), Err(FaultError::BadAt));
+            }
+        }
+    }
