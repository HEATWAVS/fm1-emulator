+    #[test]
+    fn a_powered_off_chip_answers_nothing_and_keeps_its_nonvolatile_status() {
+        for kind in PROFILES {
+            let mut r = Rig::new(kind, Timing::Typical, false);
+            r.clock(T0);
+            r.wren();
+            r.xfer(&[0x01, 0b0000_0100, 0x00], 0); // BP0 = 1 (non-volatile): protects only the top 64 KiB; two data bytes so the high bits (CMP) are defined on both chips
+            r.clock(T0 + 100_000); // the write-status cycle is long over
+            r.c.set_fault_injection(true);
+            r.program(0x0, &[0x12]); // outside the protected area: accepted
+            assert_eq!(r.state().accepted, 2, "{kind:?}: write-status and the program were accepted");
+            assert!(r.c.power_cut().is_ok(), "{kind:?}");
+            let base = r.state().powered_off_accesses;
+            assert_eq!(r.rdsr(), 0xff, "{kind:?}: no answer while off");
+            assert_eq!(r.state().powered_off_accesses, base + 2, "{kind:?}: the opcode and the read slot were each counted");
+            assert_eq!(r.read(0, 4), vec![0xff; 4], "{kind:?}");
+            assert_eq!(r.state().powered_off_accesses, base + 2 + 8, "{kind:?}: 4 address/opcode bytes and 4 read slots");
+            assert_eq!(r.c.power_restore(), Ok(()));
+            assert_eq!(r.c.power_restore(), Err(FaultError::NotOff));
+            assert_eq!(r.c.nv_status() & 0xffff & (BP as u32), 0b0000_0100, "{kind:?}: the BP bit survived the cut");
+            assert_eq!(r.rdsr() & (WEL | WIP) as u8, 0, "{kind:?}: WEL and WIP are clear after power returns");
+        }
+    }
