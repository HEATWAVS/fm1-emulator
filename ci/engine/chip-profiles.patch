+    /// The placeholder never touches a byte whose pre-image is unknown: those keep whatever the array holds, and only the list speaks for them.
+    #[test]
+    fn the_placeholder_leaves_unknown_pre_image_bytes_alone() {
+        let mut r = Rig::new(ChipKind::Puya, Timing::Typical, true);
+        r.c.arm_fault(FaultSpec { op: FaultOp::Program, nth: 1, at: FaultAt::AtAccept }).unwrap();
+        r.clock(T0);
+        r.accept(FaultOp::Program); // 0x1005..=0x1008 indeterminate
+        r.clock(T0 + 1);
+        r.c.power_restore().unwrap();
+        r.clock(T0 + 100);
+        r.program(0x1007, &[0x3c, 0xc3, 0x0f, 0xf0]); // D33: the array now holds pre & latch at the four positions
+        let (held7, held8) = (r.mem[0x1007], r.mem[0x1008]);
+        let (known9, known10) = (pat(0x1009), pat(0x100a));
+        assert_eq!((r.mem[0x1009], r.mem[0x100a]), (known9 & 0x0f, known10 & 0xf0), "the completed image is in the array until the cut is synced");
+        r.c.power_cut().unwrap();
+        r.c.sync_cut(&mut r.mem);
+        assert_eq!((r.mem[0x1007], r.mem[0x1008]), (held7, held8), "unknown pre-image bytes are left alone");
+        assert_eq!((r.mem[0x1009], r.mem[0x100a]), (known9, known10), "known pre-image bytes are put back");
+    }
+
+    /// How a trigger becomes a cycle deadline, at a clock rate where a microsecond is NOT a whole number of cycles (33.333333 MHz): `AfterCycles(n)` is n cycles exactly;
+    /// `AfterUs(n)` is the microseconds rounded UP to whole cycles (as every duration is); `Fraction(f)` is `floor(f * duration_us)` microseconds, then as `AfterUs`.
+    /// The expectations restate the rule independently (integer ceiling) rather than call the code's helper.
+    #[test]
+    fn deadlines_convert_to_cycles_with_the_documented_rounding() {
+        let hz = 33_333_333u64;
+        let cyc = |us: u64| ((us as u128 * hz as u128 + 999_999) / 1_000_000) as u64;
+        let pp = PUYA.typical.pp as u64; // 2000 us
+        let start = 1000u64;
+        let cases: Vec<(FaultAt, u64, &str)> = vec![
+            (FaultAt::AtAccept, 0, "at accept"),
+            (FaultAt::AfterCycles(777), 777, "an exact integer cycle count"),
+            (FaultAt::AfterUs(1), cyc(1), "1 us is 33.33 cycles: rounds up to 34"),
+            (FaultAt::AfterUs(1234), cyc(1234), "a whole number of microseconds, rounded up"),
+            (FaultAt::Fraction(0.5), cyc(pp / 2), "half of 2000 us is 1000 us"),
+            (FaultAt::Fraction(1.0 / 3.0), cyc(666), "floor(666.67) us, then rounded up to cycles"),
+            (FaultAt::Fraction(0.999), cyc(1998), "floor(1998.0000000000002) us"),
+        ];
+        for (at, off, why) in cases {
+            let mut r = Rig::new(ChipKind::Puya, Timing::Typical, false);
+            r.c.set_clock(start, hz);
+            r.c.arm_fault(FaultSpec { op: FaultOp::Program, nth: 1, at }).unwrap();
+            r.accept(FaultOp::Program);
+            // (a deadline already due when the accept returns has fired in the rig's own sync: read it from the record then)
+            let got = r.c.cut_deadline().or(r.c.last_cut().map(|x| x.cut_at));
+            assert_eq!(got, Some(start + off), "{at:?}: {why}");
+        }
+        // the largest exact offset that is still a cut, and the first that is a normal completion (refused)
+        let mut r = Rig::new(ChipKind::Puya, Timing::Typical, false);
+        r.c.set_clock(start, hz);
+        let end = cyc(pp);
+        assert_eq!(r.c.arm_fault(FaultSpec { op: FaultOp::Program, nth: 1, at: FaultAt::AfterCycles(end) }), Err(FaultError::BadAt), "a deadline at the end is a normal completion");
+        assert_eq!(r.c.arm_fault(FaultSpec { op: FaultOp::Program, nth: 1, at: FaultAt::AfterCycles(end - 1) }), Ok(()));
+        r.accept(FaultOp::Program);
+        assert_eq!(r.c.cut_deadline(), Some(start + end - 1));
+    }
+
+    /// Determinism: the same flash, profile, timing, trigger and clock moves give identical records, lists and memory.
+    #[test]
+    fn identical_runs_give_identical_records_and_memory() {
+        for kind in PROFILES {
+            let run = || {
+                let mut r = Rig::new(kind, Timing::Maximum, true);
+                r.c.arm_fault(FaultSpec { op: FaultOp::Erase, nth: 3, at: FaultAt::Fraction(1.0 / 3.0) }).unwrap();
+                let mut t = 100u64;
+                for i in 0..6u32 {
+                    r.clock(t);
+                    if r.state().powered_off {
+                        break;
+                    }
+                    r.erase(0x20, 0x1000 * (i + 1));
+                    t += 700_000;
+                }
+                r.clock(t + 10);
+                let st = r.state();
+                (st.clone(), fnv(&r.mem))
+            };
+            let (a, b) = (run(), run());
+            assert!(a.0.powered_off, "{kind:?}: the 3rd erase was cut");
+            assert_eq!(a, b, "{kind:?}: bit-for-bit repeatable");
+        }
+    }
+}
