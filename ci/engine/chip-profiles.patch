+        assert_eq!(rec.if_completed, vec![0x40, 0x88, 0x00, 0xd0], "what a normal completion would hold: old AND data");
+        assert_eq!((rec.unknown_before, rec.unknown_if_completed), (vec![0; 4], vec![0; 4]));
+        // nothing else is at risk: every byte outside the range equals the pattern (D33 changed only the latched positions)
+        let st = r.state();
+        assert_eq!(st.indeterminate, vec![(0x1000, 0x1001), (0x10fe, 0x10ff)]);
+        for a in 0..BYTES {
+            if !st.indeterminate.iter().any(|&(l, h)| a >= l && a <= h) {
+                assert_eq!(r.mem[a], pat(a), "byte {a:#x} outside the range was disturbed");
+            }
+        }
