+/// Chip cycle timing: 0 = datasheet typical (default), 1 = datasheet maximum. Needs a chip profile.
+#[no_mangle]
+pub extern "C" fn fm1_flash_timing(mode: u32) -> u32 {
+    let t = match mode {
+        0 => fm1_soc::Timing::Typical,
+        1 => fm1_soc::Timing::Maximum,
+        _ => return 1,
+    };
+    machine().and_then(|m| m.soc.flash.chip.as_mut()).map_or(1, |c| {
+        c.set_timing(t);
+        0
+    })
+}
+/// The chip status register's WIP bit at the current emulated time (0 without a chip profile).
