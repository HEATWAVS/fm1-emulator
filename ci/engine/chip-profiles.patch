+            k.flash.set_clock(k.periph.cycles, k.periph.hz); // (the chip learns the time at its next access)
+            let st = k.flash.chip.as_mut().unwrap().fault_state();
+            assert_eq!((st.completed, st.interrupted, k.power_cut), (1, 0, false), "how {how}: control completes");
+        }
+    }
+
+    // ---------------------------------------------------------------- core 1
+
+    /// cpu1 has no clock: it sees the SoC at the cycle where cpu0's slice ended, and time stands still while it runs. A cut due by the end of the slice (cpu0's last tick may
+    /// still be pending) must have fired before cpu1 reads anything: the run ends at the cut and cpu1 has run nothing. A cut due later cannot be seen by cpu1 in that slice, so
+    /// cpu1 legitimately reads the completed word first. Checked for every offset around the slice end, with the loop skip off and on.
+    #[test]
+    fn core_1_never_runs_after_the_deadline_even_when_the_slice_ends_on_it() {
+        let mut at_the_boundary = 0;
+        for skip in [false, true] {
+            for after in (SLICE as u64 - 6)..=(SLICE as u64 + 6) {
+                let (code, regs) = poll_code();
+                let mut code = code;
+                let c1_at = code.len() as u32;
+                code.extend_from_slice(&LOAD); // cpu1: r2 = [r1 - 544] (the XIP word the program changed), then spin
+                code.extend_from_slice(&SPIN);
+                let (mut cpu, mut soc) = cut_machine(&code, &regs, skip, false, Some(after), FLASH_IDX);
+                let mut c1 = Cpu::new(XIP_BASE + c1_at);
+                c1.core_id = 1;
+                c1.regs[1] = XIP_BASE + FLASH_IDX as u32 + 544;
+                let mut c1 = Some(c1);
+                let mut t = false;
+                let r = run_dual(&mut c1, &mut soc, 4 * SLICE, 1 << 20, false, |s, k| run_blocks(&mut cpu, s, k, &mut t));
+                let tag = format!("skip {skip} after {after}");
+                assert_eq!(r, Err(POWER_CUT.to_string()), "{tag}");
+                assert!(soc.power_cut, "{tag}");
+                assert_eq!(soc.periph.cycles, T0 + after, "{tag}: the run ends at the deadline");
+                let rec = soc.flash.chip.as_ref().unwrap().last_cut().unwrap();
+                assert_eq!((rec.cut_at, rec.detected_at), (T0 + after, T0 + after), "{tag}");
+                let seen = c1.as_ref().unwrap().regs[2];
+                if after <= SLICE as u64 {
+                    assert_eq!(seen, 0, "{tag}: cpu1 ran a load of the XIP word although the cut was due: it saw the state after the deadline");
+                    at_the_boundary += 1;
+                } else {
+                    assert_eq!(seen, COMPLETED, "{tag}: the deadline is after cpu1's slice: it sees the completed word, as it should");
+                }
+            }
+        }
+        assert!(at_the_boundary > 0);
+    }
+
+    /// and a core 1 that is the one to accept the cycle: its write fires an at-accept cut at once, and it is stopped at its next look.
+    #[test]
+    fn run_cpu1_does_not_run_once_the_chip_lost_power() {
+        let (code, regs) = poll_code();
+        let (_cpu, mut soc) = cut_machine(&code, &regs, false, false, Some(0), XIP_IDX);
+        let mut c1 = Cpu::new(XIP_BASE);
+        c1.core_id = 1;
+        let before = c1.insn_count;
+        assert_eq!(run_cpu1(&mut c1, &mut soc, 5000), Err(POWER_CUT.to_string()));
+        assert_eq!(c1.insn_count, before, "cpu1 ran an instruction after the cut");
+    }
+
+    /// run_dual's own sync: even if cpu0's slice returned with a due cut still unprocessed (here a stand-in for cpu0 that moves the clock and returns without any event
+    /// pass), the cut fires before cpu1 reads anything. (run_blocks processes the cut itself in every case probed, so this is the defence that stands behind it.)
+    #[test]
+    fn run_dual_fires_a_due_cut_before_core_1_even_if_cpu0_left_it_pending() {
+        for after in [10u64, 500, 1000] {
+            let (mut code, _) = poll_code();
+            let c1_at = code.len() as u32;
+            code.extend_from_slice(&LOAD);
+            code.extend_from_slice(&SPIN);
+            let (_cpu, mut soc) = cut_machine(&code, &[], false, false, Some(after), FLASH_IDX);
+            let mut c1 = Cpu::new(XIP_BASE + c1_at);
+            c1.core_id = 1;
+            c1.regs[1] = XIP_BASE + FLASH_IDX as u32 + 544;
+            let mut c1 = Some(c1);
+            // cpu0 stand-in: time passes by `k` cycles, no event pass (what a pending tick leaves behind)
+            let r = run_dual(&mut c1, &mut soc, 4 * SLICE, 1 << 20, false, |s, k| {
+                s.periph.cycles += k as u64;
+                Ok(k)
+            });
+            assert_eq!(r, Err(POWER_CUT.to_string()), "after {after}");
+            assert_eq!(c1.as_ref().unwrap().regs[2], 0, "after {after}: cpu1 ran before the due cut was fired");
+            let rec = soc.flash.chip.as_ref().unwrap().last_cut().unwrap();
+            assert_eq!(rec.cut_at, T0 + after);
+            assert!(rec.detected_at >= rec.cut_at, "noticed at the slice boundary, recorded at its own deadline");
+        }
+    }
+
+    /// A cut scheduled while the machine is already running, with the event queue empty (next_due far away), is not missed: scheduling forces a recompute.
+    #[test]
+    fn a_cut_scheduled_into_a_running_machine_is_not_missed() {
+        const AFTER: u64 = 20_000;
+        let (code, regs) = poll_code();
+        for jit in [false, true] {
+            for skip in [false, true] {
+                let (mut cpu, mut soc) = machine(&code, &regs, skip);
+                cpu.jit_on = jit;
+                soc.xip.resize(0x2000, 0xff);
+                for b in &mut soc.xip[code.len()..] {
+                    *b = 0xff;
+                }
+                soc.flash.set_chip(Some((ChipKind::Puya, Timing::Typical)));
+                let mut t = false;
+                assert_eq!(run_blocks(&mut cpu, &mut soc, 50_000, &mut t), Ok(50_000)); // runs; every timed event is far away (next_due recomputed)
+                assert!(soc.periph.next_due > soc.periph.cycles + 1_000_000 || soc.periph.next_due == u64::MAX, "the queue is empty: next_due {}", soc.periph.next_due);
+                let now = soc.periph.cycles;
+                soc.arm_flash_fault(FaultSpec { op: FaultOp::Program, nth: 1, at: FaultAt::AfterCycles(AFTER) }).unwrap();
+                program(&mut soc, XIP_IDX);
+                let (e, _, _, _, cycles) = run_to_the_end(&mut cpu, &mut soc, &[1 << 20]);
+                assert_eq!((e.as_str(), cycles), (POWER_CUT, now + AFTER), "jit {jit} skip {skip}");
+            }
+        }
+    }
+
+    /// Scheduling does not rely on a neighbouring write to recompute the event queue: with a chip accept made straight on the flash (no GPIO write after it), picking up the
+    /// deadline sets `next_due` to 0 and the SoC's event.
+    #[test]
+    fn picking_up_a_deadline_forces_the_event_queue_to_be_recomputed() {
+        const AFTER: u64 = 20_000;
+        let (code, regs) = poll_code();
+        let (mut cpu, mut soc) = machine(&code, &regs, false);
+        soc.flash.set_chip(Some((ChipKind::Puya, Timing::Typical)));
+        let mut t = false;
+        assert_eq!(run_blocks(&mut cpu, &mut soc, 50_000, &mut t), Ok(50_000));
+        let now = soc.periph.cycles;
+        assert!(soc.periph.next_due > now + 1_000_000, "the queue is empty: next_due {}", soc.periph.next_due);
+        soc.arm_flash_fault(FaultSpec { op: FaultOp::Program, nth: 1, at: FaultAt::AfterCycles(AFTER) }).unwrap();
+        soc.flash.set_clock(now, soc.periph.hz);
+        for cmd in [&[0x06u8][..], &[0x02, 0x00, 0x50, 0x00, 0x12]] {
+            soc.flash.set_cs(true);
+            for &b in cmd {
+                soc.flash.write(FSPI, 0);
+                soc.flash.write(FSPI + 8, b as u32);
+            }
+            soc.flash.set_cs(false);
+        }
+        assert_eq!(soc.flash.cut_deadline(), Some(now + AFTER), "the chip accepted and scheduled");
+        assert!(soc.periph.next_due > now + 1_000_000, "nothing has told the SoC yet");
+        soc.flash_cut_schedule();
+        assert_eq!((soc.periph.next_due, soc.periph.flash_cut_at), (0, now + AFTER));
+    }
+
+    // ---------------------------------------------------------------- terminal state, and nothing changes when it is not used
+
+    #[test]
+    fn a_power_cut_is_terminal_and_a_harness_cut_ends_the_machine_the_same_way() {
+        let (code, regs) = poll_code();
+        // scheduled: the machine stays stopped, and restoring the CHIP does not restart it (the SoC lost power: only a harness reboot can)
+        let (mut cpu, mut soc) = cut_machine(&code, &regs, false, false, Some(1000), XIP_IDX);
+        let (e, ..) = run_to_the_end(&mut cpu, &mut soc, &[1 << 20]);
+        assert_eq!(e, POWER_CUT);
+        let insns = cpu.insn_count;
+        let mut t = false;
+        for _ in 0..3 {
+            assert_eq!(run_blocks(&mut cpu, &mut soc, 100, &mut t), Err(POWER_CUT.to_string()), "it stays stopped");
+        }
+        assert_eq!(cpu.insn_count, insns);
+        soc.flash.chip.as_mut().unwrap().power_restore().unwrap();
+        assert!(soc.power_cut);
+        assert_eq!(run_blocks(&mut cpu, &mut soc, 100, &mut t), Err(POWER_CUT.to_string()));
+
+        // harness-initiated (the reference model's powerCut()): the same terminal state and the same views
+        let (mut cpu, mut soc) = machine(&code, &regs, false);
+        soc.xip.resize(0x2000, 0xff);
+        for b in &mut soc.xip[code.len()..] {
+            *b = 0xff;
+        }
+        soc.flash.set_chip(Some((ChipKind::Puya, Timing::Typical)));
+        soc.flash.chip.as_mut().unwrap().set_fault_injection(true);
+        soc.periph.cycles = T0;
+        soc.periph.next_due = 0;
+        program(&mut soc, XIP_IDX);
+        assert_eq!(soc.flash.cut_deadline(), None, "nothing scheduled: a harness cut is immediate");
+        soc.periph.cycles = T0 + 10;
+        let rec = soc.power_cut_flash().unwrap();
+        assert_eq!((rec.source, rec.cut_at, rec.detected_at), (crate::spichip::CutSource::Harness, T0 + 10, T0 + 10));
+        assert!(soc.power_cut);
+        let v = views(&mut soc, XIP_IDX);
+        assert_eq!((v.0, v.3), (PRE_IMAGE, 0xff), "the pre-image");
+        assert_eq!(run_blocks(&mut cpu, &mut soc, 100, &mut t), Err(POWER_CUT.to_string()));
+        assert_eq!(soc.power_cut_flash().err(), Some(FaultError::AlreadyOff));
+
+        // a cycle accepted with journaling off cannot be cut: refused, never faked, and the machine keeps running
+        let (_cpu, mut soc) = cut_machine(&code, &regs, false, false, None, XIP_IDX);
+        soc.periph.cycles = T0 + 10;
+        assert_eq!(soc.power_cut_flash().err(), Some(FaultError::NotEnabled));
+        assert!(!soc.power_cut);
+    }
+
+    /// Nothing changes when fault injection is not used: a chip with nothing armed, a trigger that never matches and no chip at all run the same code to the same state,
+    /// with no event scheduled.
+    #[test]
+    fn with_fault_injection_disabled_the_soc_runs_exactly_as_before() {
+        let (code, regs) = poll_code();
+        let mut results = Vec::new();
+        for (chip, armed_never) in [(false, false), (true, false), (true, true)] {
+            for (skip, jit) in [(false, false), (true, true)] {
+                let (mut cpu, mut soc) = machine(&code, &regs, skip);
+                cpu.jit_on = jit;
+                if chip {
+                    soc.flash.set_chip(Some((ChipKind::Puya, Timing::Typical)));
+                    if armed_never {
+                        soc.arm_flash_fault(FaultSpec { op: FaultOp::ChipErase, nth: 1, at: FaultAt::AtAccept }).unwrap();
+                    }
+                }
+                soc.periph.cycles = T0;
+                soc.periph.next_due = 0;
+                if chip {
+                    program(&mut soc, XIP_IDX); // a program that is not cut
+                } else {
+                    soc.flash.set_chip(None);
+                }
+                assert_eq!(soc.periph.flash_cut_at, u64::MAX, "nothing scheduled");
+                let mut t = false;
+                let mut done = 0;
+                while done < 600_000 {
+                    done += 20_011;
+                    assert!(run_blocks(&mut cpu, &mut soc, 20_011, &mut t).is_ok());
+                }
+                assert!(!soc.power_cut);
+                assert_eq!(soc.periph.flash_cut_at, u64::MAX);
+                results.push((skip, jit, cpu.pc, cpu.regs, cpu.insn_count, soc.periph.cycles - if chip { 0 } else { 0 }));
+            }
+        }
+        // every (skip, jit) group agrees across the three setups; the run did not depend on the chip or the trigger
+        for g in 0..2 {
+            let r: Vec<_> = (0..3).map(|c| &results[c * 2 + g]).collect();
+            assert!(r.iter().all(|x| (x.2, x.3, x.4, x.5) == (r[0].2, r[0].3, r[0].4, r[0].5)), "group {g}: {r:x?}");
+        }
+    }
 }
