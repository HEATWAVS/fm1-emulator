@@ -0,0 +1,360 @@
+//! Replays oracle transcripts (generated from the Stage A reference model, ci/machine/chipmodel.mjs) against
+//! the Rust chip state machine, two ways:
+//!   * `chip_driver`: `Chip` directly (select / transfer / release), including CS rising mid-byte;
+//!   * `soc_driver`: through the SoC's registers (GPIO PD0 chip select, SPI0 BUF/CON) with the SoC's
+//!     cycle counter as the clock: the path the firmware's CPU takes.
+//! The transcript file is named by FM1_CHIP_ORACLE (see gen-transcripts.mjs for the line formats).
+
+use fm1_core::Bus;
+use fm1_soc::{Chip, ChipKind, Soc, Timing, FLASH_SIZE};
+
+const SPI0: u32 = 0x11c00;
+const CS: u32 = 0x500c0;
+
+fn unhex(s: &str) -> Vec<u8> {
+    if s == "-" {
+        return Vec::new();
+    }
+    (0..s.len() / 2).map(|i| u8::from_str_radix(&s[2 * i..2 * i + 2], 16).unwrap()).collect()
+}
+
+fn fnv(a: &[u8]) -> u32 {
+    let mut h: u32 = 0x811c9dc5;
+    for &b in a {
+        h ^= b as u32;
+        h = h.wrapping_mul(0x01000193);
+    }
+    h
+}
+
+fn pattern() -> Vec<u8> {
+    (0..FLASH_SIZE).map(|i| (((i * 131 + (i >> 8) * 17) ^ 0x5a) & 0xff) as u8).collect()
+}
+
+trait Drv {
+    fn set_cycles(&mut self, cycles: u64);
+    /// Run one transaction: returns the bytes read and, for status reads, the model's unknown mask byte.
+    fn tx(&mut self, tx: &[u8], read: usize, partial: u8) -> (Vec<u8>, Option<u8>);
+    fn power(&mut self);
+    fn mem(&self) -> &[u8];
+    fn wip(&mut self) -> bool;
+    fn take_log(&mut self) -> Vec<&'static str>;
+}
+
+struct ChipDrv {
+    chip: Chip,
+    mem: Vec<u8>,
+    hz: u64,
+}
+impl Drv for ChipDrv {
+    fn set_cycles(&mut self, c: u64) {
+        self.chip.set_clock(c, self.hz);
+    }
+    fn tx(&mut self, tx: &[u8], read: usize, partial: u8) -> (Vec<u8>, Option<u8>) {
+        self.chip.select();
+        for &b in tx {
+            self.chip.transfer(&self.mem, b);
+        }
+        let out: Vec<u8> = (0..read).map(|_| self.chip.transfer(&self.mem, 0x00)).collect();
+        let unk = match tx.first() {
+            Some(0x05) => Some(self.chip.status().1 as u8),
+            Some(0x35) => Some((self.chip.status().1 >> 8) as u8),
+            _ => None,
+        };
+        self.chip.release(&mut self.mem, partial);
+        (out, unk)
+    }
+    fn power(&mut self) {
+        self.chip.power_cycle();
+    }
+    fn mem(&self) -> &[u8] {
+        &self.mem
+    }
+    fn wip(&mut self) -> bool {
+        self.chip.wip()
+    }
+    fn take_log(&mut self) -> Vec<&'static str> {
+        self.chip.take_log()
+    }
+}
+
+struct SocDrv {
+    soc: Soc,
+}
+impl Drv for SocDrv {
+    fn set_cycles(&mut self, c: u64) {
+        self.soc.periph.cycles = c;
+    }
+    fn tx(&mut self, tx: &[u8], read: usize, partial: u8) -> (Vec<u8>, Option<u8>) {
+        let s = &mut self.soc;
+        s.write32(CS, 0);
+        for &b in tx {
+            s.write32(SPI0, 0); // transmit mode
+            s.write32(SPI0 + 8, b as u32);
+        }
+        let mut out = Vec::new();
+        for _ in 0..read {
+            s.write32(SPI0, 0x1000); // receive mode: BUF returns the byte clocked in
+            s.write32(SPI0 + 8, 0);
+            out.push((s.read32(SPI0 + 8) & 0xff) as u8);
+        }
+        if partial != 0 {
+            // CS# rising mid-byte cannot happen on the byte-wide SPI0: hand the chip the event directly,
+            // then drop the GPIO line (the chip has nothing left to execute)
+            let f = &mut s.flash;
+            f.chip.as_mut().unwrap().release(&mut f.mem, partial);
+        }
+        s.write32(CS, 1);
+        (out, None)
+    }
+    fn power(&mut self) {
+        let (c, hz) = (self.soc.periph.cycles, self.soc.periph.hz);
+        self.soc.flash.set_clock(c, hz);
+        self.soc.flash.chip.as_mut().unwrap().power_cycle();
+    }
+    fn mem(&self) -> &[u8] {
+        &self.soc.flash.mem
+    }
+    fn wip(&mut self) -> bool {
+        let (c, hz) = (self.soc.periph.cycles, self.soc.periph.hz);
+        self.soc.flash.wip(c, hz)
+    }
+    fn take_log(&mut self) -> Vec<&'static str> {
+        self.soc.flash.chip.as_mut().unwrap().take_log()
+    }
+}
+
+#[derive(Default)]
+struct Report {
+    scenarios: usize,
+    transactions: usize,
+    array_checks: usize,
+    hashes: usize,
+    wip_checks: usize,
+    power: usize,
+    mismatches: Vec<String>,
+}
+
+type Maker = dyn Fn(ChipKind, Timing, u64, bool, bool, Option<[u8; 16]>) -> Box<dyn Drv>;
+
+fn replay(make: &Maker) -> Report {
+    let path = std::env::var("FM1_CHIP_ORACLE").expect("FM1_CHIP_ORACLE must name the oracle transcript file (see gen-transcripts.mjs)");
+    let text = std::fs::read_to_string(&path).unwrap_or_else(|e| panic!("cannot read {path}: {e}"));
+    let mut rep = Report::default();
+    let mut drv: Option<Box<dyn Drv>> = None;
+    let (mut name, mut hz, mut us_total) = (String::new(), 100_000_000u64, 0u64);
+    let mut bad = |rep: &mut Report, name: &str, ln: usize, what: String| {
+        if rep.mismatches.len() < 25 {
+            rep.mismatches.push(format!("{name} line {ln}: {what}"));
+        } else if rep.mismatches.len() == 25 {
+            rep.mismatches.push("... (more)".into());
+        }
+    };
+    let mut nbad = 0usize;
+    for (i, line) in text.lines().enumerate() {
+        let ln = i + 1;
+        let f: Vec<&str> = line.split(' ').collect();
+        match f[0] {
+            "S" => {
+                name = f[1].to_string();
+                let kind = if f[2] == "puya" { ChipKind::Puya } else { ChipKind::Uc25hq80 };
+                let timing = if f[3] == "typical" { Timing::Typical } else { Timing::Maximum };
+                hz = f[4].parse().unwrap();
+                let (wp, pat) = (f[5] == "1", f[6] == "pat");
+                // an optional 4Bh unique-ID fixture: uid=<32 hex digits> (a test fixture; no real device ID)
+                let uid: Option<[u8; 16]> = f.get(7).and_then(|s| s.strip_prefix("uid=")).map(|h| unhex(h).try_into().expect("16 bytes"));
+                drv = Some(make(kind, timing, hz, wp, pat, uid));
+                us_total = 0;
+                rep.scenarios += 1;
+            }
+            "E" => drv = None,
+            "T" => {
+                let d = drv.as_mut().unwrap();
+                let adv: u64 = f[1].parse().unwrap();
+                us_total += adv;
+                d.set_cycles(us_total * (hz / 1_000_000));
+                let res = line.split(" => ").nth(1).unwrap();
+                if res == "ADV" {
+                    continue;
+                }
+                let (partial, read): (u8, usize) = (f[2].parse().unwrap(), f[3].parse().unwrap());
+                let tx = unhex(f[4]);
+                rep.transactions += 1;
+                let (out, unk) = d.tx(&tx, read, partial);
+                let log = d.take_log();
+                let r: Vec<&str> = res.split(' ').collect();
+                if r[0] == "OK" {
+                    if !log.is_empty() {
+                        nbad += 1;
+                        bad(&mut rep, &name, ln, format!("oracle OK, chip recorded events {log:?}"));
+                    }
+                    let (eout, eunk) = (unhex(r[1]), unhex(r[2]));
+                    if read > 0 && !eout.is_empty() {
+                        let status = matches!(tx[0], 0x05 | 0x35);
+                        for k in 0..read {
+                            let mask = !eunk[k]; // bits the oracle marks unknown (status bits the datasheets leave open; the 4Bh ID without a fixture)
+                            if (out[k] ^ eout[k]) & mask != 0 {
+                                nbad += 1;
+                                bad(&mut rep, &name, ln, format!("tx {} read byte {k}: chip {:02x}, oracle {:02x} (unknown mask {:02x})", f[4], out[k], eout[k], if status { eunk[k] } else { 0 }));
+                                break;
+                            }
+                        }
+                        if let (Some(u), true) = (unk, status) {
+                            if eunk.iter().any(|&e| e != u) {
+                                nbad += 1;
+                                bad(&mut rep, &name, ln, format!("tx {} unknown mask: chip {u:02x}, oracle {}", f[4], r[2]));
+                            }
+                        }
+                    }
+                } else if r[0] == "ERR" {
+                    if log != [r[2]] {
+                        nbad += 1;
+                        bad(&mut rep, &name, ln, format!("tx {} oracle refuses with {} {}, chip recorded {log:?}", f[4], r[1], r[2]));
+                    }
+                } else {
+                    panic!("bad result {res}");
+                }
+            }
+            "P" => {
+                let d = drv.as_mut().unwrap();
+                d.power();
+                let log = d.take_log();
+                rep.power += 1;
+                let ok = line.ends_with("=> OK");
+                let exp: Vec<&str> = if ok { vec![] } else { vec!["nm.power-loss"] };
+                if log != exp {
+                    nbad += 1;
+                    bad(&mut rep, &name, ln, format!("power cycle: oracle {}, chip events {log:?}", &line[4..]));
+                }
+            }
+            "A" => {
+                let d = drv.as_mut().unwrap();
+                let (a, l): (usize, usize) = (f[1].parse().unwrap(), f[2].parse().unwrap());
+                rep.array_checks += 1;
+                if d.mem()[a..a + l] != unhex(f[3])[..] {
+                    nbad += 1;
+                    bad(&mut rep, &name, ln, format!("array {a:#x}+{l}: chip {:02x?}.. oracle {}", &d.mem()[a..(a + l).min(a + 8)], &f[3][..f[3].len().min(16)]));
+                }
+            }
+            "D" => {
+                let d = drv.as_mut().unwrap();
+                rep.hashes += 1;
+                let h = fnv(d.mem());
+                if format!("{h:08x}") != f[1] {
+                    nbad += 1;
+                    bad(&mut rep, &name, ln, format!("final array hash: chip {h:08x}, oracle {}", f[1]));
+                }
+            }
+            "W" => {
+                let d = drv.as_mut().unwrap();
+                rep.wip_checks += 1;
+                if d.wip() != (f[1] == "1") {
+                    nbad += 1;
+                    bad(&mut rep, &name, ln, format!("WIP: chip {}, oracle {}", !(f[1] == "1"), f[1]));
+                }
+            }
+            other => panic!("unknown transcript line kind {other}"),
+        }
+    }
+    let _ = nbad;
+    rep
+}
+
+fn run(make: &Maker, label: &str) {
+    let r = replay(make);
+    eprintln!(
+        "{label}: {} scenarios, {} transactions, {} array checks, {} final hashes, {} WIP checks, {} power cycles; mismatches: {}",
+        r.scenarios, r.transactions, r.array_checks, r.hashes, r.wip_checks, r.power, r.mismatches.len()
+    );
+    assert!(r.mismatches.is_empty(), "{label}: oracle mismatches:\n{}", r.mismatches.join("\n"));
+    assert!(r.scenarios > 300 && r.transactions > 50_000, "{label}: transcript too small to mean anything");
+}
+
+#[test]
+#[ignore = "needs the oracle transcript: set FM1_CHIP_ORACLE and run with --ignored"]
+fn chip_driver_matches_the_oracle() {
+    run(
+        &|kind, timing, hz, wp, pat, uid| {
+            let mut chip = Chip::new(kind, timing);
+            chip.set_wp(wp);
+            chip.set_uid(uid);
+            Box::new(ChipDrv { chip, mem: if pat { pattern() } else { vec![0xff; FLASH_SIZE] }, hz })
+        },
+        "chip driver",
+    );
+}
+
+#[test]
+#[ignore = "needs the oracle transcript: set FM1_CHIP_ORACLE and run with --ignored"]
+fn soc_registers_match_the_oracle() {
+    run(
+        &|kind, timing, hz, wp, pat, uid| {
+            let mut soc = Soc::new(1 << 16, vec![0; 0x1000]);
+            soc.periph.hz = hz;
+            soc.flash.set_chip(Some((kind, timing)));
+            soc.flash.chip.as_mut().unwrap().set_wp(wp);
+            soc.flash.chip.as_mut().unwrap().set_uid(uid);
+            if pat {
+                soc.flash.mem.copy_from_slice(&pattern());
+            }
+            Box::new(SocDrv { soc })
+        },
+        "SoC driver",
+    );
+}
+
+/// The default must stay the original model: no chip, instantaneous, program without WEL still programs.
+#[test]
+fn default_is_the_original_model() {
+    let mut soc = Soc::new(1 << 16, vec![0; 0x1000]);
+    assert!(soc.flash.chip.is_none());
+    let mut cmd = |soc: &mut Soc, bytes: &[u8]| {
+        soc.write32(CS, 0);
+        for &b in bytes {
+            soc.write32(SPI0 + 8, b as u32);
+        }
+        soc.write32(CS, 1);
+    };
+    // 4Bh in the original model: FF in the four dummy slots, then the FM1- pattern repeating (it is not a device ID)
+    soc.write32(CS, 0);
+    soc.write32(SPI0, 0);
+    soc.write32(SPI0 + 8, 0x4b);
+    let mut pattern = Vec::new();
+    for _ in 0..12 {
+        soc.write32(SPI0, 0x1000);
+        soc.write32(SPI0 + 8, 0);
+        pattern.push((soc.read32(SPI0 + 8) & 0xff) as u8);
+    }
+    soc.write32(CS, 1);
+    assert_eq!(pattern, [0xff, 0xff, 0xff, 0xff, 0x46, 0x4d, 0x31, 0x2d, 0x46, 0x4d, 0x31, 0x2d], "the legacy 4Bh answer is unchanged: FF in the four dummy slots, then the FM1- pattern");
+    cmd(&mut soc, &[0x02, 0x00, 0x10, 0x00, 0xa5]); // program with no WREN: the original model programs it anyway
+    assert_eq!(soc.flash.mem[0x1000], 0xa5);
+    cmd(&mut soc, &[0x06]);
+    soc.write32(CS, 0);
+    soc.write32(SPI0 + 8, 0x05);
+    soc.write32(SPI0, 0x1000);
+    soc.write32(SPI0 + 8, 0);
+    assert_eq!(soc.read32(SPI0 + 8) & 0xff, 0x02, "status shows WEL and never WIP");
+    soc.write32(CS, 1);
+    assert!(!soc.flash.wip(0, 1_000_000), "the original model never reports a write cycle");
+}
+
+/// A chip profile selected after boot answers the right JEDEC id and gives WIP for a real duration.
+#[test]
+fn a_profile_changes_the_id_and_takes_time() {
+    for (kind, id) in [(ChipKind::Puya, [0x85, 0x60, 0x14]), (ChipKind::Uc25hq80, [0xb3, 0x60, 0x14])] {
+        let mut soc = Soc::new(1 << 16, vec![0; 0x1000]);
+        soc.periph.hz = 100_000_000;
+        soc.flash.set_chip(Some((kind, Timing::Typical)));
+        let mut drv = SocDrv { soc };
+        assert_eq!(drv.tx(&[0x9f], 3, 0).0, id);
+        drv.tx(&[0x06], 0, 0);
+        drv.tx(&[0x20, 0, 0, 0], 0, 0);
+        assert!(drv.wip(), "WIP right after the erase is accepted");
+        let typ_us: u64 = if kind == ChipKind::Puya { 8000 } else { 7000 };
+        drv.set_cycles(typ_us * 100 - 1);
+        assert!(drv.wip(), "still busy one cycle before the datasheet typical time");
+        drv.set_cycles(typ_us * 100);
+        assert!(!drv.wip(), "done exactly at the typical time");
+    }
+}
