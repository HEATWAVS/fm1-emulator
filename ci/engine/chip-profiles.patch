+        r.c.power_restore().unwrap();
+        r.clock(T0 + 100);
+        r.program(0x4000, &[0x00]);
+        r.clock(T0 + 100_000);
+        let st = r.state();
+        assert_eq!((st.accepted, st.completed, st.interrupted), (2, 1, 1), "the next program completes normally");
+    }
+
+    // ------------------------------------------------------------------ determinism and disabled behaviour
+
+    fn scripted(r: &mut Rig) -> (u32, u32, Vec<u8>, u64) {
+        let mut t = 100u64;
+        let mut seq = Vec::new();
+        r.clock(t);
+        for step in 0..14u32 {
+            let a = 0x1000 * (step + 1);
+            match step % 5 {
+                0 => r.program(a, &[0xa5, 0x5a, step as u8]),
+                1 => r.erase(0x20, a),
+                2 => r.erase(0x52, a & !0x7fff),
+                3 => r.erase(0xd8, a & !0xffff),
+                _ => r.erase(0x81, a),
+            }
+            seq.push(r.rdsr());
+            t += 3_000;
+            r.clock(t);
+            seq.push(r.rdsr());
+            t += 2_000_000;
+            r.clock(t);
+            r.xfer(&[0x35], 1);
+            seq.extend(r.read(a, 3));
+        }
+        let st = r.state();
+        (fnv(&r.mem), st.completed, seq, r.c.busy_until().unwrap_or(0))
+    }
+
+    /// Normal-operation regression: with fault injection never armed, with it armed and never matching, and with journaling on but nothing armed, a long scripted run
+    /// of programs and erases (including 81h) yields byte-identical results: array, status reads, reads, counters. (The oracle transcripts, which are unchanged, are
+    /// the wider regression against the reference model.)
+    #[test]
+    fn disabled_fault_injection_changes_nothing() {
+        for kind in PROFILES {
+            let mut plain = Rig::new(kind, Timing::Typical, true);
+            let want = scripted(&mut plain);
+            assert!(!plain.state().journaling && plain.state().last.is_none());
+            assert_eq!(plain.state().completed, 14, "{kind:?}: every cycle completed");
+
+            let mut journaling = Rig::new(kind, Timing::Typical, true);
+            journaling.c.set_fault_injection(true);
+            assert_eq!(scripted(&mut journaling), want, "{kind:?}: journaling on, nothing armed");
+
+            let mut never = Rig::new(kind, Timing::Typical, true);
+            never.c.arm_fault(FaultSpec { op: FaultOp::ChipErase, nth: 1, at: FaultAt::AtAccept }).unwrap(); // no chip erase in the script
+            assert_eq!(scripted(&mut never), want, "{kind:?}: armed, never matching");
+            assert_eq!(never.state().armed.unwrap().1, 0);
+
+            let mut disarmed = Rig::new(kind, Timing::Typical, true);
+            disarmed.c.arm_fault(FaultSpec { op: FaultOp::Program, nth: 1, at: FaultAt::AtAccept }).unwrap();
+            disarmed.c.disarm_fault();
+            assert_eq!(scripted(&mut disarmed), want, "{kind:?}: armed then disarmed");
+        }
+    }
+
+    /// At a very low clock whole-cycle rounding could put the cut on the cycle the cycle ends: the cut is clamped to the cycle before it, so completion can never win.
+    /// (At the SoC's 100 MHz this cannot happen; the clamp exists for correctness at any `hz`.)
+    #[test]
+    fn the_cut_stays_before_the_end_even_at_a_very_low_clock() {
+        let hz = 1000; // 1 kHz: a microsecond is a millisecond's worth of rounding
+        let mut c = Chip::new(ChipKind::Puya, Timing::Typical);
+        let mut mem = vec![0xffu8; BYTES];
+        c.set_clock(0, hz);
+        c.arm_fault(FaultSpec { op: FaultOp::Program, nth: 1, at: FaultAt::AfterUs(PUYA.typical.pp - 1) }).unwrap();
+        for tx in [&[0x06][..], &[0x02, 0, 0x10, 0, 0x55][..]] {
+            c.select();
+            for &b in tx {
+                c.transfer(&mem, b);
+            }
+            c.release(&mut mem, 0);
+        }
+        // the program takes 2000 us = 2 cycles at 1 kHz; afterUs(1999) rounds up to 2 cycles = the end: the clamp makes it cycle 1
+        assert_eq!(c.busy_until(), Some(2));
+        c.set_clock(1, hz);
+        let st = c.fault_state();
+        assert!(st.powered_off, "cut at cycle 1, before the end at cycle 2");
+        assert_eq!((st.last.as_ref().unwrap().cut_at, st.last.as_ref().unwrap().end_would_be_at, st.completed), (1, 2, 0));
+    }
+
+    /// The `erase` selector is the three sector/block erases: a chip erase is a different kind and is neither counted nor cut by it.
+    #[test]
+    fn the_erase_selector_does_not_match_a_chip_erase() {
+        let mut r = Rig::new(ChipKind::Puya, Timing::Typical, false);
+        r.c.arm_fault(FaultSpec { op: FaultOp::Erase, nth: 1, at: FaultAt::AtAccept }).unwrap();
+        r.clock(T0);
+        r.accept(FaultOp::ChipErase);
+        r.clock(T0 + 100_000);
+        let st = r.state();
+        assert_eq!((st.armed.unwrap().1, st.powered_off, st.completed), (0, false, 1), "the chip erase completed and was not counted");
+        r.accept(FaultOp::Erase4k);
+        assert!(r.state().powered_off, "the first sector erase is the one cut");
+    }
+
+    /// A harness cut is not a scheduled one: it carries no `nth`, even while a trigger for a later cycle is armed.
+    #[test]
+    fn a_harness_cut_carries_no_nth_even_while_a_trigger_is_armed() {
+        let mut r = Rig::new(ChipKind::Uc25hq80, Timing::Typical, true);
+        r.c.arm_fault(FaultSpec { op: FaultOp::Erase64k, nth: 1, at: FaultAt::AtAccept }).unwrap();
+        r.clock(T0);
+        r.accept(FaultOp::Program); // not matched by the trigger; journaled because arming turned journaling on
+        r.clock(T0 + 10);
+        let rec = r.c.power_cut().unwrap();
+        assert_eq!((rec.source, rec.nth), (CutSource::Harness, None));
+        assert!(r.state().armed.is_none(), "the cut disarmed the trigger");
+    }
+
+    /// The placeholder never touches a byte whose pre-image is unknown: those keep whatever the array holds, and only the list speaks for them.
+    #[test]
+    fn the_placeholder_leaves_unknown_pre_image_bytes_alone() {
+        let mut r = Rig::new(ChipKind::Puya, Timing::Typical, true);
+        r.c.arm_fault(FaultSpec { op: FaultOp::Program, nth: 1, at: FaultAt::AtAccept }).unwrap();
+        r.clock(T0);
+        r.accept(FaultOp::Program); // 0x1005..=0x1008 indeterminate
+        r.clock(T0 + 1);
+        r.c.power_restore().unwrap();
+        r.clock(T0 + 100);
+        r.program(0x1007, &[0x3c, 0xc3, 0x0f, 0xf0]); // D33: the array now holds pre & latch at the four positions
+        let (held7, held8) = (r.mem[0x1007], r.mem[0x1008]);
+        let (known9, known10) = (pat(0x1009), pat(0x100a));
+        assert_eq!((r.mem[0x1009], r.mem[0x100a]), (known9 & 0x0f, known10 & 0xf0), "the completed image is in the array until the cut is synced");
+        r.c.power_cut().unwrap();
+        r.c.sync_cut(&mut r.mem);
+        assert_eq!((r.mem[0x1007], r.mem[0x1008]), (held7, held8), "unknown pre-image bytes are left alone");
+        assert_eq!((r.mem[0x1009], r.mem[0x100a]), (known9, known10), "known pre-image bytes are put back");
+    }
+
+    /// Determinism: the same flash, profile, timing, trigger and clock moves give identical records, lists and memory.
+    #[test]
+    fn identical_runs_give_identical_records_and_memory() {
+        for kind in PROFILES {
+            let run = || {
+                let mut r = Rig::new(kind, Timing::Maximum, true);
+                r.c.arm_fault(FaultSpec { op: FaultOp::Erase, nth: 3, at: FaultAt::Fraction(1.0 / 3.0) }).unwrap();
+                let mut t = 100u64;
+                for i in 0..6u32 {
+                    r.clock(t);
+                    if r.state().powered_off {
+                        break;
+                    }
+                    r.erase(0x20, 0x1000 * (i + 1));
+                    t += 700_000;
+                }
+                r.clock(t + 10);
+                let st = r.state();
+                (st.clone(), fnv(&r.mem))
+            };
+            let (a, b) = (run(), run());
+            assert!(a.0.powered_off, "{kind:?}: the 3rd erase was cut");
+            assert_eq!(a, b, "{kind:?}: bit-for-bit repeatable");
+        }
+    }
+}
