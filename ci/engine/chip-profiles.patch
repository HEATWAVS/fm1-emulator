+#[cfg(test)]
+mod power_cut_tests {
+    use super::*;
+    use fm1_soc::spichip::{FaultAt, FaultOp, FaultSpec};
+
+    fn spi(m: &mut Machine, bytes: &[u8]) {
+        m.soc.write32(0x500c0, 0);
+        for &b in bytes {
+            m.soc.write32(0x11c00, 0);
+            m.soc.write32(0x11c08, b as u32);
+        }
+        m.soc.write32(0x500c0, 1);
+    }
+
+    /// Component 5, Stage 5C-2: a flash power cut stops the machine in a state of its own. It is not `halted` (a CPU fault), nothing runs afterwards, and the render loop's
+    /// condition sees it; a real CPU fault is still a halt.
+    #[test]
+    fn a_power_cut_is_its_own_state_not_a_cpu_halt() {
+        let mut image = vec![0u8; 0x4000];
+        image[..6].copy_from_slice(&[0x60, 0xff, 0x00, 0x20, 0xfd, 0xff]); // spin on the spot
+        let mut m = Machine::new(image, fm1_soc::XIP_BASE, 100, None);
+        m.soc.flash.set_chip(Some((fm1_soc::ChipKind::Puya, fm1_soc::Timing::Typical)));
+        m.soc.arm_flash_fault(FaultSpec { op: FaultOp::Program, nth: 1, at: FaultAt::AfterCycles(50_000) }).unwrap();
+        spi(&mut m, &[0x06]);
+        spi(&mut m, &[0x02, 0x00, 0x50, 0x00, 0x12, 0x34]);
+        m.run(200_000);
+        assert!(m.power_cut && !m.halted, "power_cut {} halted {}", m.power_cut, m.halted);
+        assert_eq!(m.soc.periph.cycles, 50_000, "stopped at the deadline");
+        let insns = m.cpu.insn_count;
+        m.run(10_000);
+        assert_eq!(m.cpu.insn_count, insns, "nothing runs after a power cut");
+        assert!(m.power_cut && !m.halted);
+
+        // a CPU fault is still a halt, and not a power cut
+        let mut f = Machine::new(vec![0xff; 0x4000], fm1_soc::XIP_BASE, 100, None);
+        f.run(1000);
+        assert!(f.halted && !f.power_cut, "halted {} power_cut {}", f.halted, f.power_cut);
+    }
+}
