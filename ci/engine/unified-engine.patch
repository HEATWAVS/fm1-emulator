+/// The virtual USB host (fm1_soc::usb): the same calls the shipped engine exports.
+#[no_mangle]
+pub extern "C" fn fm1_usb_plug() {
+    if let Some(m) = machine() { m.soc.usb_plug(); }
+}
+#[no_mangle]
+pub extern "C" fn fm1_usb_conf_len() -> u32 { machine().map_or(0, |m| m.soc.usb.conf_bytes().len() as u32) }
+#[no_mangle]
+pub extern "C" fn fm1_usb_conf() -> *const u8 { machine().map_or(std::ptr::null(), |m| m.soc.usb.conf_bytes().as_ptr()) }
+#[no_mangle]
+pub extern "C" fn fm1_has_usr() -> u32 { machine().is_some_and(|m| m.usr.is_some()) as u32 }
+
+/// USB audio in: interleaved stereo f32 at 44.1 kHz, 8192 floats per chunk, as the shipped engine takes it.
+static mut AUDIO_IN: [f32; 8192] = [0.0; 8192];
+#[no_mangle]
+pub extern "C" fn fm1_audio_in_buf() -> *mut f32 { unsafe { std::ptr::addr_of_mut!(AUDIO_IN) as *mut f32 } }
+#[no_mangle]
+pub extern "C" fn fm1_audio_in(frames: u32) {
+    if let Some(m) = machine() { let n = (frames as usize * 2).min(8192); let s = unsafe { std::slice::from_raw_parts(std::ptr::addr_of!(AUDIO_IN) as *const f32, n) }; m.soc.usb.audio_in(s); }
+}
+#[no_mangle]
+pub extern "C" fn fm1_audio_pending() -> u32 { machine().map_or(0, |m| m.soc.usb.audio_pending()) }
+#[no_mangle]
+pub extern "C" fn fm1_has_audio_in() -> u32 { machine().is_some_and(|m| m.soc.usb.has_audio()) as u32 }
+
