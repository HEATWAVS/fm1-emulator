+/// What one `run_cpu1` call remembers for `Settled1`.
+#[derive(Default)]
+struct Settled1Call {
+    /// the epoch at the last block end that was looked at, where the next visit goes in the ring, quiet block ends in a row, block ends a failed proof still waits
+    ep: u64,
+    pos: usize,
+    quiet: u32,
+    backoff: u32,
+    /// a skip was made: nothing more is tried in this call
+    done: bool,
+    /// the lookup (state copy, scan, record) was paid for at least once in this call
+    looked: bool,
+}
