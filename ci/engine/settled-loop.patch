+/// Most visits remembered in a call, quiet block ends before the first is recorded, instructions one proof may step, block ends a failed proof waits.
+const SETTLED_RING: usize = 16;
+const SETTLED_ARM: u32 = 4;
+const SETTLED_PROOF_MAX: u64 = 1024;
+const SETTLED_BACKOFF: u32 = 32;
+/// A call that skipped nothing although core 1 did something observable or the lookups were paid for makes the next 2^n - 1 calls (n counts such calls in a row, at most `SETTLED_MISS_MAX`, so at most 255) run without any bookkeeping; a skip resets n.
+const SETTLED_MISS_MAX: u32 = 8;
+/// TIMER4's counter word (periph.rs): a read of it counts the clock.
+const TIMER4_CNT: u32 = 0x10804;
