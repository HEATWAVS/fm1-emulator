+    pub held: u64,
+    /// calls that skipped, rounds skipped, instructions skipped, proofs run, proofs that failed (diagnostics)
+    pub exits: u64,
+    pub rounds: u64,
+    pub skipped: u64,
+    pub proofs: u64,
+    pub failed: u64,
