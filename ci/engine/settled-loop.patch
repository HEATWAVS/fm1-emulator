+                assert_eq!(sb, (0, 0, 0), "jit {jit} n {n}: a loop that stores was skipped: {sb:?}");
+                assert_eq!(b.sink, 0x1234, "the store really happened");
+            }
+        }
+    }
+
+    /// what the polled word says changes between calls (as when cpu0 writes it): the skipped loop notices at once and leaves exactly when the unskipped one does
+    #[test]
+    fn a_loop_whose_word_changes_between_calls_leaves_exactly_as_before() {
+        for jit in [false, true] {
+            for first in [3000u64, 4999, 5003] {
+                let calls = [(None, false, first), (None, false, first), (Some(0), false, 100), (Some(0x20), false, 4000), (Some(0), false, 4000)];
+                let (a, _, _) = run(Opt { jit, ..Opt::new(false) }, &poll_only(), &calls);
+                let (b, sb, _) = run(Opt { jit, ..Opt::new(true) }, &poll_only(), &calls);
+                assert_eq!(a, b, "jit {jit} first {first}");
+                assert!(sb.0 >= 1, "jit {jit} first {first}: the waiting stretches were not skipped at all: {sb:?}");
+            }
+        }
+    }
+
+    /// a loop that stops waiting inside the call (the word is zero from the start): not a settled loop, same state
+    #[test]
+    fn a_loop_that_ends_is_left_alone() {
+        let calls = [(Some(0), false, 5000)];
+        let (a, _, _) = run(Opt::new(false), &poll_only(), &calls);
+        let (b, sb, _) = run(Opt::new(true), &poll_only(), &calls);
+        assert_eq!(a, b);
+        assert_eq!(b.regs[2], 0, "the loop really stopped waiting (r2 is the word it read: 0)");
+        assert!(sb.2 < 5000, "only the spin it ends in can be skipped, never the waiting that ended: {sb:?}");
+    }
+
+    /// stores first, then a pure loop: the loop is found once the stores stop, and the state is the same
+    #[test]
+    fn a_pure_loop_after_a_burst_of_stores_is_still_found() {
+        let mut code = STORE.to_vec();
+        code.extend_from_slice(&STORE);
+        code.extend_from_slice(&STORE);
+        code.extend_from_slice(&LOAD);
+        code.extend_from_slice(&while_set(4));
+        code.extend_from_slice(&SPIN);
+        for jit in [false, true] {
+            let calls = [(None, false, 5000), (None, false, 5000)];
+            let (a, _, _) = run(Opt { jit, ..Opt::new(false) }, &code, &calls);
+            let (b, sb, _) = run(Opt { jit, ..Opt::new(true) }, &code, &calls);
+            assert_eq!(a, b, "jit {jit}");
+            assert_eq!(b.sink, 0x1234, "the stores happened");
+            assert!(sb.0 >= 1, "jit {jit}: the loop after the stores was not found: {sb:?}");
+        }
+    }
+
+    /// the poll counter: core 1 reading TIMER4 while cpu0 is in an ISR leaves the detector alone, exactly as the engine counts it without the skip
+    #[test]
+    fn timer_poll_counter_matches_with_cpu0_in_an_isr_or_not() {
+        for in_isr in [true, false] {
+            for jit in [false, true] {
+                let calls = [(None, false, 5003), (None, false, 5003), (None, false, 777)];
+                let a = Opt { in_isr, jit, addr: Some(0x10804), ..Opt::new(false) };
+                let b = Opt { in_isr, jit, addr: Some(0x10804), ..Opt::new(true) };
+                let (ea, _, _) = run(a, &poll_only(), &calls);
+                let (eb, sb, _) = run(b, &poll_only(), &calls);
+                assert_eq!(ea, eb, "in_isr {in_isr} jit {jit}: poll state or core differs");
+                if in_isr { assert!(sb.0 >= 1, "in_isr: the constant-timer loop is a fixed point and should have been skipped: {sb:?}"); }
+            }
+        }
+    }
+
+    /// an interrupt core 1 can take, arriving after the loop was skipped: taken at once, exactly as without the skip
+    #[test]
+    fn an_interrupt_after_a_skipped_loop_is_taken_exactly_as_before() {
+        for jit in [false, true] {
+            let mut code = poll_only();
+            let handler = XIP_BASE + code.len() as u32;
+            code.extend_from_slice(&SPIN); // the handler: spins elsewhere
+            let calls = [(None, false, 5000), (None, false, 5000), (None, true, 5000), (None, false, 3000)];
+            let (ea, _, _) = run(Opt { jit, handler: Some((120, handler)), ..Opt::new(false) }, &code, &calls);
+            let (eb, sb, _) = run(Opt { jit, handler: Some((120, handler)), ..Opt::new(true) }, &code, &calls);
+            assert_eq!(ea, eb, "jit {jit}");
+            assert!(sb.0 >= 1, "jit {jit}: the loop before the interrupt should have been skipped");
+            assert!(ea.pc >= handler && ea.pc < handler + 6, "jit {jit}: the interrupt was really taken (pc {:#x}, handler {:#x})", ea.pc, handler);
+        }
+    }
+
+    /// a pending interrupt core 1 cannot take (no enable) does not matter: still skipped, still identical
+    #[test]
+    fn an_interrupt_core_1_may_not_take_does_not_stop_a_skip() {
+        let calls = [(None, true, 5000), (None, false, 5000)];
+        let (ea, _, _) = run(Opt::new(false), &poll_only(), &calls);
+        let (eb, sb, _) = run(Opt::new(true), &poll_only(), &calls);
+        assert_eq!(ea, eb);
+        assert!(sb.0 >= 1);
+    }
+
+    /// a flaky core 1 misreads RAM loads from a random stream: skipping rounds would skip draws. Never skipped, identical
+    #[test]
+    fn a_flaky_core_1_is_never_skipped() {
+        for jit in [false, true] {
+            let calls = [(None, false, 5000), (None, false, 5000)];
+            let (ea, _, _) = run(Opt { jit, flaky: true, ..Opt::new(false) }, &poll_only(), &calls);
+            let (eb, sb, _) = run(Opt { jit, flaky: true, ..Opt::new(true) }, &poll_only(), &calls);
+            assert_eq!(ea, eb, "jit {jit}");
+            assert_eq!(sb, (0, 0, 0), "jit {jit}: a flaky core was skipped");
+        }
+    }
+
+    /// a chip that lost power: core 1 does not run, as before
+    #[test]
+    fn a_power_cut_stops_cpu1_as_before() {
+        let calls = [(None, false, 5000)];
+        let (ea, _, _) = run(Opt { power_cut: true, ..Opt::new(false) }, &poll_only(), &calls);
+        let (eb, sb, _) = run(Opt { power_cut: true, ..Opt::new(true) }, &poll_only(), &calls);
+        assert_eq!(ea, eb);
+        assert_eq!(ea.err.as_deref(), Some(POWER_CUT));
+        assert_eq!(sb, (0, 0, 0));
+    }
+
+    /// USB: with a cable CON1's done bit follows the clock, so a loop reading it is not pure and never skipped; without one it is a plain register and is
+    #[test]
+    fn a_usb_con1_loop_is_skipped_only_without_a_cable() {
+        let mut code = LOAD.to_vec();
+        code.extend_from_slice(&jump_back(4));
+        for jit in [false, true] {
+            let calls = [(None, false, 5000), (None, false, 5000), (None, false, 5000)];
+            for cable in [true, false] {
+                let addr = Some(crate::usb::USB_LO + 4);
+                let (ea, _, _) = run(Opt { jit, cable, addr, ..Opt::new(false) }, &code, &calls);
+                let (eb, sb, _) = run(Opt { jit, cable, addr, ..Opt::new(true) }, &code, &calls);
+                assert_eq!(ea, eb, "jit {jit} cable {cable}");
+                if cable { assert_eq!(sb, (0, 0, 0), "jit {jit}: a loop reading CON1 with a cable was skipped"); }
+                else { assert!(sb.0 >= 1, "jit {jit}: the loop was not skipped without a cable: {sb:?}"); }
+            }
+        }
+    }
+
+    /// PLL0 as the bootloader leaves it: a loop waiting on it (bit 5 of the control word set) is a plain-register fixed point, skipped, identical
+    #[test]
+    fn a_pll0_wait_loop_is_skipped_and_identical() {
+        for jit in [false, true] {
+            let calls = [(None, false, 5000), (None, false, 5000)];
+            let addr = Some(0x119a4);
+            let (ea, _, _) = run(Opt { jit, addr, ..Opt::new(false) }, &poll_only(), &calls);
+            let (eb, sb, _) = run(Opt { jit, addr, ..Opt::new(true) }, &poll_only(), &calls);
+            assert_eq!(ea, eb, "jit {jit}");
+            assert_eq!(ea.regs[2] & 0x20, 0x20, "the loop really waits (PLL0 CON1 reads with bit 5 set)");
+            assert!(sb.0 >= 1, "jit {jit}: not skipped: {sb:?}");
+        }
+    }
+
+    /// a core that stores in every round is not worth looking at: the hold-off sets in (calls run without any bookkeeping), the hold stays bounded, nothing is skipped, and the state is the same
+    #[test]
+    fn a_busy_core_makes_the_looking_pause_without_changing_anything() {
+        for jit in [false, true] {
+            let calls: Vec<_> = (0..300).map(|_| (None, false, 3000u64)).collect();
+            let (ea, _, _) = run(Opt { jit, ..Opt::new(false) }, &poll_and_store(), &calls);
+            let (eb, sb, _) = run(Opt { jit, ..Opt::new(true) }, &poll_and_store(), &calls);
+            assert_eq!(ea, eb, "jit {jit}");
+            assert_eq!(sb, (0, 0, 0), "jit {jit}: a storing loop was skipped");
+        }
+        // (the counters: look at the machine itself)
+        let mut xip = poll_and_store();
+        xip.resize(xip.len() + 512, 0);
+        let mut soc = Soc::new(1 << 20, xip);
+        soc.write32(WORD, 0x20);
+        soc.c1_settled.on = true;
+        let mut c1 = Cpu::new(XIP_BASE);
+        c1.core_id = 1;
+        c1.stop_checks = true;
+        c1.regs[1] = WORD + 544;
+        c1.regs[3] = 0x1234;
+        c1.regs[5] = SINK + 128;
+        let mut max_hold = 0;
+        for _ in 0..300 {
+            run_cpu1(&mut c1, &mut soc, 3000).unwrap();
+            max_hold = max_hold.max(soc.c1_settled.hold);
+        }
+        assert!(soc.c1_settled.held > 100, "the hold-off did not set in: {} calls held", soc.c1_settled.held);
+        assert!(max_hold <= 255, "the hold grew past its bound: {max_hold}");
+        assert!(soc.c1_settled.held < 300, "detection was switched off for good");
+    }
+
+    /// the hold-off ends by itself: with a long hold pending, pure loops that begin from a new state each call are skipped again once it runs out, with the same end state as without
+    #[test]
+    fn the_looking_resumes_when_the_hold_runs_out() {
+        for jit in [false, true] {
+            let words: Vec<(Option<u32>, bool, u64)> = (0..80).map(|i| (Some(if i % 2 == 0 { 0x20 } else { 0x30 }), false, 3000u64)).collect();
+            let mk = |on: bool| {
+                let mut xip = poll_only();
+                xip.resize(xip.len() + 512, 0);
+                let mut soc = Soc::new(1 << 20, xip);
+                soc.c1_settled.on = on;
+                soc.c1_settled.miss = SETTLED_MISS_MAX;
+                soc.c1_settled.hold = if on { 63 } else { 0 };
+                let mut c1 = Cpu::new(XIP_BASE);
+                c1.core_id = 1;
+                c1.jit_on = jit;
+                c1.stop_checks = true;
+                c1.regs[1] = WORD + 544;
+                c1.regs[3] = 0x1234;
+                c1.regs[5] = SINK + 128;
+                (soc, c1)
+            };
+            let (mut sa, mut ca) = mk(false);
+            let (mut sb, mut cb) = mk(true);
+            let mut first_exit_call = None;
+            for (i, &(w, _, n)) in words.iter().enumerate() {
+                if let Some(w) = w { sa.write32(WORD, w); sb.write32(WORD, w); }
+                run_cpu1(&mut ca, &mut sa, n).unwrap();
+                run_cpu1(&mut cb, &mut sb, n).unwrap();
+                if first_exit_call.is_none() && sb.c1_settled.exits > 0 { first_exit_call = Some(i); }
+            }
+            assert_eq!((ca.pc, ca.regs, ca.sp, ca.insn_count, sa.periph.cycles), (cb.pc, cb.regs, cb.sp, cb.insn_count, sb.periph.cycles), "jit {jit}");
+            assert_eq!(sb.c1_settled.held, 63, "jit {jit}");
+            let first = first_exit_call.expect("detection never resumed");
+            assert!(first >= 63, "jit {jit}: skipped while the hold was running: call {first}");
+            assert!(sb.c1_settled.exits >= 1);
+        }
+    }
+
+    /// the switch turned on in the middle of a run changes nothing about the machine
+    #[test]
+    fn turning_the_switch_on_mid_run_changes_nothing() {
+        for jit in [false, true] {
+            let calls = [(None, false, 5000), (None, false, 5000), (None, false, 5000), (None, false, 5000)];
+            let (ea, _, _) = run(Opt { jit, ..Opt::new(false) }, &poll_only(), &calls);
+            let (eb, sb, _) = run(Opt { jit, on_after: 2, ..Opt::new(true) }, &poll_only(), &calls);
+            // (a call that begins inside the loop with the same registers is the engine's own idle exit, so whether the switch skips anything there is not the point)
+            assert_eq!(ea, eb, "jit {jit}: {sb:?}");
+        }
+    }
+}
