+/// The poll detector's state as far as it matters: whether three reads in a row have been seen, and how long since the last.
+fn settled_poll_key(soc: &Soc) -> (u32, u64) {
+    let (streak, last) = soc.periph.poll_state();
+    (streak.min(2), soc.periph.cycles.wrapping_sub(last).min(64))
+}
+
+/// What `run_cpu1` does after each of core 1's block ends when the early exit is on (`Settled1`). The filter below only chooses where to
+/// look; `prove_round` alone decides whether anything is skipped.
+#[inline(always)]
+fn settled_block_end(c1: &mut Cpu, soc: &mut Soc, sc: &mut Settled1Call, left: &mut u64, probing: &mut u64) -> Result<(), String> {
+    // Anything observable since the last block end: no settled round ended here. Forget the earlier visits and do nothing else.
+    let ep = soc.c1_settled.epoch;
+    if ep != sc.ep {
+        sc.ep = ep;
+        soc.c1_settled.visits.clear();
+        sc.pos = 0;
+        sc.quiet = 0;
+        sc.backoff = sc.backoff.saturating_sub(1);
+        return Ok(());
+    }
+    // Armed only after a few quiet block ends in a row: a core that does something observable every few blocks never gets here.
+    sc.quiet = sc.quiet.saturating_add(1);
+    if sc.quiet < SETTLED_ARM {
+        sc.backoff = sc.backoff.saturating_sub(1);
+        return Ok(());
+    }
+    settled_look(c1, soc, sc, left, probing)
+}
+
+/// The part of `settled_block_end` that is more than a counter compare: look for a repeat visit, prove it, remember this one. Kept out of line so the
+/// block loop of `run_cpu1` carries only the compare.
+#[inline(never)]
+fn settled_look(c1: &mut Cpu, soc: &mut Soc, sc: &mut Settled1Call, left: &mut u64, probing: &mut u64) -> Result<(), String> {
+    sc.looked = true;
+    let Some(core) = c1.plain_state() else { return Ok(()) };
+    let (cyc, key) = (soc.periph.cycles, settled_poll_key(soc));
+    let seen = soc.c1_settled.visits.iter().any(|v| v.core == core && v.cyc == cyc && v.poll == key);
+    let (core, cyc, key) = if seen && sc.backoff == 0 {
+        soc.c1_settled.proofs += 1;
+        match prove_round(c1, soc, *left)? {
+            Proof::Fixed { steps, reads } => {
+                *left -= steps;
+                *probing = probing.saturating_sub(steps);
+                let n = *left / steps;
+                let skipped = n * steps;
+                *left -= skipped;
+                *probing = probing.saturating_sub(skipped);
+                c1.insn_count += skipped;
+                soc.periph.poll_add_streak((n * reads) as u32);
+                let s = &mut soc.c1_settled;
+                s.exits += 1;
+                s.rounds += n;
+                s.skipped += skipped;
+                sc.done = true;
+                return Ok(());
+            }
+            Proof::Failed { steps } => {
+                *left = left.saturating_sub(steps);
+                *probing = probing.saturating_sub(steps);
+                sc.backoff = SETTLED_BACKOFF;
+                soc.c1_settled.failed += 1;
+            }
+        }
+        // the proof stepped core 1: remember where it is now
+        let Some(core) = c1.plain_state() else { return Ok(()) };
+        sc.ep = soc.c1_settled.epoch;
+        (core, soc.periph.cycles, settled_poll_key(soc))
+    } else {
+        sc.backoff = sc.backoff.saturating_sub(1);
+        (core, cyc, key)
+    };
+    let v = Settled1Visit { core, cyc, poll: key };
+    if soc.c1_settled.visits.len() < SETTLED_RING {
+        soc.c1_settled.visits.push(v);
+    } else {
+        soc.c1_settled.visits[sc.pos] = v;
+        sc.pos = (sc.pos + 1) % SETTLED_RING;
     }
     Ok(())
 }
 
+/// What single-stepping one round of a candidate fixed point found.
+enum Proof {
+    Fixed { steps: u64, reads: u64 },
+    Failed { steps: u64 },
+}
+
+/// Interpret core 1 from where it is, one instruction at a time through the bus, for up to `max` (at most `SETTLED_PROOF_MAX`) instructions:
+/// Fixed if it comes back to this very core state at this pc having made no store, no read that is not free of side effects, no clock jump and
+/// no hardware lock, with no interrupt it could take (the same checks `run_cpu1` makes before every instruction). The instructions run are
+/// real ones and are counted.
+#[inline(never)]
+fn prove_round(c1: &mut Cpu, soc: &mut Soc, max: u64) -> Result<Proof, String> {
+    let Some(start) = c1.plain_state() else { return Ok(Proof::Failed { steps: 0 }) };
+    let pc0 = c1.pc;
+    let (ep0, reads0, cyc0) = (soc.c1_settled.epoch, soc.c1_settled.t4_reads, soc.periph.cycles);
+    let mut steps = 0u64;
+    while steps < max.min(SETTLED_PROOF_MAX) {
+        if soc.periph.any_pending() {
+            if let Some((_irq, prio)) = soc.pending_irq_for(1) {
+                if c1.irq_ready(prio) {
+                    return Ok(Proof::Failed { steps });
+                }
+            }
+        }
+        let mut bus = Core1Bus { soc: &mut *soc, budget: u64::MAX };
+        if let Err(e) = c1.step(&mut bus) {
+            return Err(format!("cpu1: {e:?} at pc {:#010x}", c1.pc));
+        }
+        steps += 1;
+        if soc.c1_settled.epoch != ep0 || soc.periph.cycles != cyc0 {
+            return Ok(Proof::Failed { steps });
+        }
+        if c1.pc == pc0 && c1.plain_state() == Some(start) {
+            return Ok(Proof::Fixed { steps, reads: soc.c1_settled.t4_reads - reads0 });
+        }
+    }
+    Ok(Proof::Failed { steps })
+}
